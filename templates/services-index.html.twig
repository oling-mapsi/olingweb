{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}

{% block body %}
{% set serviceUniverses = [
  {
    title: 'AMOA & Applications métiers',
    intro: 'ERP, CRM, GMAO, SI Finance, SIRH, data et IA : cadrage, choix d’outils, recette, migration et mise en production.',
    items: [
      {label: 'AMOA SI', href: path('amoa_si'), text: 'Cadrer le besoin, organiser la consultation, piloter la recette et sécuriser la mise en production.'},
      {label: 'ERP', href: '/business-apps/erp', text: 'Choisir le progiciel, cadrer les processus, préparer la reprise de données et piloter l’intégrateur.'},
      {label: 'CRM', href: '/crm', text: 'Structurer les processus commerciaux, les données client, l’adoption et le reporting.'},
      {label: 'GMAO', href: '/gmao', text: 'Cadrer la maintenance, les actifs, les données équipements, la mobilité terrain et la recette.'},
      {label: 'SI Finance', href: '/si-finance', text: 'Relier processus finance, ERP/EPM, reporting, contrôle interne et interfaces.'},
      {label: 'Facturation électronique', href: '/consulting/reforme-facturation-electronique-amoa', text: 'Cadrer les flux, formats, plateformes agréées (PA), impacts SI et conduite du changement.'},
      {label: 'Data / BI', href: '/business-apps/bi-et-analytique', text: 'Définir les indicateurs, modèles de données, dashboards et usages de pilotage.'},
      {label: 'IA & automatisation', href: '/business-apps/transformation-digitale-automatisation-et-ia-utile', text: 'Identifier les usages utiles, automatiser les processus et intégrer les agents métier.'}
    ]
  },
  {
    title: 'Gouvernance & Performance DSI',
    intro: 'Missions pour organiser le SI, arbitrer les priorités et tenir l’exécution.',
    items: [
      {label: 'Schéma directeur SI', href: '/consulting/plan-strategique', text: 'Établir la cible, la trajectoire, les priorités, le budget et la feuille de route.'},
      {label: 'Pilotage de projets / PMO', href: '/consulting/pilotage-des-plans', text: 'Tenir planning, budget, risques, fournisseurs, comités et décisions projet.'},
      {label: 'Organisation & processus', href: '/consulting/management-des-processus', text: 'Clarifier les responsabilités, processus, irritants et modes de fonctionnement.'},
      {label: 'Gouvernance des données', href: '/consulting/gouvernance-des-donnees', text: 'Structurer référentiels, qualité des données, règles de gestion et responsabilités.'},
      {label: 'Infrastructure & modernisation SI', href: '/infrastructure-si-amoa', text: 'Cadrer les scénarios techniques, risques, planning et gouvernance de transition.'},
      {label: 'DSI externalisée', href: '/dsi-externalisee', text: 'Appuyer la direction SI sur priorités, fournisseurs, budget et continuité opérationnelle.'}
    ]
  },
  {
    title: 'Conformité, Risques & Résilience',
    intro: 'RGPD, cyber, QSE, PCA/PRA, risques, contrôle interne et IA : obligations, contrôles, preuves et plans d’action.',
    items: [
      {label: 'RGPD / DPO', href: '/expertises-audit/rgpd', text: 'Tenir registre, DPIA, contrats, droits, gouvernance et dispositif DPO.'},
      {label: 'Cybersécurité / ISO 27001', href: '/cyber-securite', text: 'Structurer gouvernance sécurité, risques, PSSI, ISO 27001, NIS2 et DORA.'},
      {label: 'QSE', href: '/expertises-audit/qse', text: 'Préparer audits, documentation, plans d’action et amélioration continue.'},
      {label: 'Risques & contrôle interne', href: '/gestion-risques-audit-controle-interne', text: 'Cartographier les risques, tester les contrôles et suivre les plans de maîtrise.'},
      {label: 'Conformité IA / AI Act', href: '/expertises-audit/conformite-ia-gouvernance-et-ai-act', text: 'Cadrer usages IA, responsabilités, registres, risques, supervision humaine et preuves.'}
    ]
  }
] %}

<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.intro,
    primaryCta: page.primaryCta,
    secondaryCta: page.secondaryCta,
    highlights: page.highlights
  } %}

  <section class="oling-shell-section">
    <div class="container">
      <div class="d-flex flex-column gap-5">
        {% for universe in serviceUniverses %}
          <div aria-labelledby="services-universe-{{ loop.index }}">
            <div class="oling-section-head">
              <h2 id="services-universe-{{ loop.index }}">{{ universe.title }}</h2>
              <p>{{ universe.intro }}</p>
            </div>
            <div class="row g-4">
              {% for item in universe.items %}
                <div class="col-md-6 col-xl-4">
                  <div class="border-top pt-3 h-100">
                    <h3 class="h5 mb-2"><a class="link" href="{{ item.href }}">{{ item.label }}</a></h3>
                    <p class="mb-0">{{ item.text }}</p>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="oling-shell-section oling-shell-section--tint">
    <div class="container">
      <div class="oling-section-head">
        <h2>MAPSI</h2>
        <p>Plateforme GRC développée par OLING pour outiller registres, risques, audits, plans d’action, incidents et reporting.</p>
      </div>
      <div class="d-flex flex-wrap gap-3">
        <a class="link" href="https://mapsi.fr/" target="_blank" rel="noopener">Accéder à mapsi.fr</a>
        <a class="link" href="/mapsi-progiciel">Voir la page OLING MAPSI</a>
      </div>
    </div>
  </section>

  {% include 'public/_cta_band.html.twig' with {
    eyebrow: page.cta.eyebrow,
    title: page.cta.title,
    text: page.cta.text,
    primaryCta: page.cta.primaryCta
  } %}
</main>
{% endblock %}

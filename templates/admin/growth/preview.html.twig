{% extends 'base.html.twig' %}

{% block title %}Preview Growth | Admin{% endblock %}
{% block meta_description %}Preview interne Growth{% endblock %}
{% block stylesheets %}{{ parent() }}<style>.growth-article-preview img{max-width:100%;height:auto}.growth-article-preview{overflow-wrap:anywhere}</style>{% endblock %}

{% block body %}
<main id="content" role="main" class="admin">
  <div class="container content-space-2 content-space-lg-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
      <div>
        <h1 class="h3 mb-1">{{ asset.title|default(campaign.name) }}</h1>
        <p class="text-muted mb-0">{{ channel_options[asset.channel]|default(asset.channel) }} · v{{ asset.version|default(0) }} · preview interne</p>
      </div>
      <a class="btn btn-outline-primary btn-sm" href="{{ path('admin_growth_show', {id: campaign.id}) }}">Retour</a>
    </div>

    {% include 'admin/_nav.html.twig' %}

    <section class="card">
      <div class="card-body">
        <article class="growth-article-preview">{{ preview_html|raw }}</article>
      </div>
    </section>
  </div>
</main>
{% endblock %}

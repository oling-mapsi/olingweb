{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}
{% block canonical_url %}{{ app.request.schemeAndHttpHost ~ (canonicalPath|default(app.request.pathInfo)) }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  {% if catalogue|default(null) %}<link rel="stylesheet" href="{{ asset('styles/projects-catalogue.css') }}?v=20261017-bento4">{% endif %}
  <link rel="stylesheet" href="{{ asset('styles/hub-heroes.css') }}?v=20261017b">
  <link rel="stylesheet" href="{{ asset('styles/projects-featured.css') }}?v=20261017">
{% endblock %}

{% block body %}
<main id="content" role="main" class="oling-case-studies-page oling-public-editorial oling-public-editorial--projects">
  {% include 'public/_page_hero.html.twig' with {
    mediaFrame: page.heroFrame|default('none'),
    variant: 'hub-projects',
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.proofLibrary.heroIntro,
    primaryCta: page.primaryCta,
    secondaryCta: page.secondaryCta,
    highlights: page.highlights,
    image: page.heroImage|default(null),
    imageAlt: page.heroImageAlt|default(page.title),
    imageCaption: page.heroImageCaption|default(null),
    imageFocalPoint: page.heroImageFocalPoint|default(null),
    imageDisplayMode: page.heroImageDisplayMode|default('auto'),
    imageSize: page.heroImageSize|default('auto')
  } %}

  {% if featuredProjects|default([])|length > 0 %}
    <section class="oling-shell-section oling-project-media-showcase oling-project-media-showcase--editorial" aria-labelledby="project-media-showcase-title">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'projects.library_kicker'|trans }}</span>
          <h2 id="project-media-showcase-title">{{ catalogue|default(null) ? 'Réalisations à la une' : (app.request.locale == 'fr' ? page.cards.title : 'projects.media_title'|trans) }}</h2>
          <p>{{ app.request.locale == 'fr' ? page.cards.intro : 'projects.media_intro'|trans }}</p>
        </div>
        <div class="oling-project-media-grid">
          {% for project in featuredProjects|slice(0, 6) %}
            {% set projectImageRaw = project.image|default('')|trim %}
            {% set projectImageSrc = projectImageRaw ? (projectImageRaw starts with 'http://' or projectImageRaw starts with 'https://' or projectImageRaw starts with 'data:' or projectImageRaw starts with '/' ? projectImageRaw : asset(projectImageRaw)) : null %}
            {% set expertise = project.eyebrow|default('')|lower %}
            {% set visualTheme = 'erp' in expertise ? 'erp' : ('factur' in expertise ? 'finance' : ('rgpd' in expertise or 'privacy' in expertise ? 'rgpd' : ('gmao' in expertise ? 'gmao' : ('ged' in expertise or 'démat' in expertise ? 'documents' : 'si')))) %}
            <a class="oling-project-media-card" data-featured-theme="{{ visualTheme }}" href="{{ project.href }}">
              <div class="oling-featured-card-top"><span class="oling-featured-index" aria-hidden="true">{{ '%02d'|format(loop.index) }}<span> / {{ '%02d'|format(featuredProjects|length > 6 ? 6 : featuredProjects|length) }}</span></span><span class="oling-featured-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">{% if visualTheme == 'rgpd' %}<path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Zm-4 9 3 3 5-6"/>{% elseif visualTheme == 'finance' %}<path d="M3 3v18h18M7 16v-5M12 16V7M17 16v-8"/>{% elseif visualTheme == 'gmao' %}<path d="m14 6 4-4a6 6 0 0 1-7 8L4 17a2.1 2.1 0 0 0 3 3l7-7a6 6 0 0 0 8-7l-4 4-4-4Z"/>{% elseif visualTheme == 'documents' %}<path d="M4 3h11l5 5v13H4zM14 3v6h6M8 13h8M8 17h5"/>{% else %}<path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/>{% endif %}</svg></span></div>
              {% if projectImageSrc %}
                <div class="oling-project-media-card__visual">
                  <img src="{{ projectImageSrc }}" alt="{{ project.title }}" width="720" height="480" loading="{{ loop.index <= 2 ? 'eager' : 'lazy' }}" decoding="async">
                </div>
              {% endif %}
              <div class="oling-project-media-card__body">
                {% if project.eyebrow %}<span class="oling-kicker">{{ project.eyebrow }}</span>{% endif %}
                <h3>{{ project.title }}</h3>
                {% if project.excerpt %}<p>{{ project.excerpt }}</p>{% endif %}
                {% if project.meta or project.period %}<div class="oling-project-media-card__meta">
                  {% if project.meta %}<span>{{ project.meta }}</span>{% endif %}
                  {% if project.period %}<span>{{ project.period }}</span>{% endif %}
                </div>{% endif %}
                <span class="oling-featured-card-action">{{ app.request.locale == 'en' ? 'Discuss a similar project' : (app.request.locale == 'es' ? 'Hablemos de un proyecto similar' : 'Parlons de votre projet') }}<span class="oling-featured-card-arrow" aria-hidden="true">↗</span></span>
              </div>
            </a>
          {% endfor %}
        </div>
        {% if not catalogue|default(null) and miniProjects|default([])|length > 0 %}
          <div class="oling-projects-mini-grid mt-4">
            {% include 'projets/_mini_cards.html.twig' with {miniProjects: miniProjects|slice(0, 6)} %}
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if catalogue|default(null) %}
    <section id="catalogue" class="oling-shell-section oling-catalogue" aria-labelledby="catalogue-title">
      <div class="container">
        {% include 'projets/_catalogue.html.twig' %}
      </div>
    </section>
  {% else %}
  <section class="oling-proof-library oling-projects-redesign" aria-labelledby="proof-library-title">
    <div class="container">
      <div class="oling-proof-library__intro">
        <span class="oling-kicker">{{ 'projects.library_kicker'|trans }}</span>
        <h2 id="proof-library-title">{{ 'projects.library_title'|trans }}</h2>
        <p>{{ 'projects.library_intro'|trans }}</p>
        <div class="oling-proof-library__count"><strong>{{ page.proofLibrary.missions|length }}</strong><span>{{ catalogue|default(null) ? "exemples décrits, indépendants du compteur du catalogue" : "missions documentées" }}</span></div>
      </div>

      <div class="oling-proof-filters" role="group" aria-label="{{ 'projects.filter_aria'|trans }}">
        <button class="oling-proof-filter" type="button" data-proof-filter="all" aria-pressed="true">{{ 'projects.filter_all'|trans }}</button>
        {% for filter in page.proofLibrary.filters %}
          <button class="oling-proof-filter" type="button" data-proof-filter="{{ filter.id }}" aria-pressed="false">{{ filter.label }}</button>
        {% endfor %}
      </div>

      <div class="oling-proof-list">
        {% for mission in page.proofLibrary.missions %}
          <article id="{{ mission.id }}" class="oling-proof-mission" data-proof-category="{{ mission.category }}">
            <header class="oling-proof-mission__identity">
              <div class="oling-proof-mission__identity-top">
                <span class="oling-kicker">{{ mission.categoryLabel }}</span>
                <span class="oling-proof-mission__number" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
              </div>
              <h2>{{ mission.title }}</h2>
              <p class="oling-proof-mission__org">{{ mission.organization }} · {{ mission.sector }}</p>
              <span class="oling-proof-mission__decor" aria-hidden="true"></span>
            </header>
            <div class="oling-proof-mission__content">
              <div class="oling-proof-mission__narrative">
                <section class="oling-proof-mission__block">
                  <h3>{{ 'projects.context'|trans }}</h3>
                  <p>{{ mission.context }}</p>
                </section>
                <section class="oling-proof-mission__block">
                  <h3>{{ 'projects.intervention'|trans }}</h3>
                  <p>{{ mission.intervention }}</p>
                </section>
              </div>
              <div class="oling-proof-mission__evidence">
                <section class="oling-proof-mission__block">
                  <h3>{{ 'projects.scope'|trans }}</h3>
                  <ul class="oling-proof-terms">
                    {% for item in mission.scope %}<li>{{ item }}</li>{% endfor %}
                  </ul>
                </section>
                <section class="oling-proof-mission__block">
                  <h3>{{ 'projects.deliverables'|trans }}</h3>
                  <ul class="oling-proof-terms">
                    {% for item in mission.deliverables %}<li>{{ item }}</li>{% endfor %}
                  </ul>
                </section>
              </div>
              {% if mission.systems is not empty %}
                <div class="oling-proof-mission__systems">
                  <h3>{{ 'projects.systems'|trans }}</h3>
                  <p>{{ mission.systems|join(' · ') }}</p>
                </div>
              {% endif %}
              {% if mission.citations is not empty %}
                <details class="oling-proof-quotes" aria-label="{{ 'projects.quotes_aria'|trans }}">
                  <summary class="oling-proof-quotes__summary">
                    <span>{{ 'projects.quotes_aria'|trans }}</span>
                    <span class="oling-proof-quotes__count">{{ mission.citations|length }}</span>
                    <span class="oling-proof-quotes__chevron" aria-hidden="true"></span>
                  </summary>
                  <div class="oling-proof-quotes__body">
                    {% for citation in mission.citations %}<p>{{ citation }}</p>{% endfor %}
                  </div>
                </details>
              {% endif %}
              <div class="oling-proof-owner">
                <a href="{{ mission.owner.href }}">{{ 'projects.owner_prefix'|trans }} {{ mission.owner.label }}</a>
                {% if mission.secondaryOwner is defined %}
                  <a href="{{ mission.secondaryOwner.href }}">{{ mission.secondaryOwner.label }}</a>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
      <p class="oling-proof-empty" data-proof-empty hidden>{{ 'projects.empty'|trans }}</p>
    </div>
  </section>

  {% endif %}

  {% include 'public/_cta_band.html.twig' with {
    eyebrow: 'projects.cta_eyebrow'|trans,
    title: 'projects.cta_title'|trans,
    text: 'projects.cta_text'|trans,
    primaryCta: {route: 'contact', label: 'projects.cta_label'|trans},
    phoneCta: true
  } %}

  {% if not catalogue|default(null) %}
  <script>
    document.querySelectorAll('[data-proof-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.proofFilter;
        let visible = 0;
        document.querySelectorAll('[data-proof-filter]').forEach((item) => {
          item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
        });
        document.querySelectorAll('[data-proof-category]').forEach((mission) => {
          const show = filter === 'all' || mission.dataset.proofCategory === filter;
          mission.hidden = !show;
          if (show) visible += 1;
        });
        const empty = document.querySelector('[data-proof-empty]');
        if (empty) empty.hidden = visible !== 0;
      });
    });
  </script>
  {% endif %}
</main>
{% endblock %}

{% extends 'admin/crm/layout.html.twig' %}
{% block crm %}
<a class="back" href="{{ path('admin_crm',{view:deal.origin=='watch'?'markets':'clients'}) }}">← Retour aux fiches</a><h1>{{ deal.title }}</h1>
{% if deal.origin=='watch' %}<section class="crm-card decision"><div><small>SÉLECTION DU MARCHÉ</small><h2>{{ decisions[deal.decision] }}</h2><p>La sélection est indépendante de l’avancement commercial.</p></div><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><input type="hidden" name="version" value="{{ deal.version }}"><label>Décision<select name="decision">{% for key,label in decisions %}<option value="{{ key }}" {{ key==deal.decision?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label><button name="action" value="decision">Enregistrer la décision</button></form></section>{% endif %}
{% if deal.review_required %}<section class="alert alert-warning"><p>Ancien import automatique à réviser. Les données ont été conservées.</p><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><input type="hidden" name="version" value="{{ deal.version }}"><button name="action" value="qualify">Confirmer cette demande</button></form></section>{% endif %}<p>{{ deal.organization }} · <span class="crm-badge">{{ statuses[deal.status] }}</span> · Origine : {{ deal.origin }}</p>
{% if deal.merged_into|default(null) %}<p>Affaire rapprochée : <a href="{{ path('admin_crm_show',{id:deal.merged_into}) }}">ouvrir la fiche principale</a>.</p>{% endif %}
<div class="crm-actions">{% if not deal.merged_into|default(null) %}<a class="btn" href="{{ path('admin_crm_delete',{id:deal.id}) }}">Supprimer et bloquer les réimports</a>{% endif %}{% for key,label in {follow:'À suivre',sent:'Offre envoyée',won:'Gagné',lost:'Perdu',no_go:'Sans suite',archived:'Archiver'} %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><input type="hidden" name="version" value="{{ deal.version }}"><button name="action" value="{{ key }}">{{ label }}</button></form>{% endfor %}</div>
<details class="crm-card"><summary>Relancer</summary><form method="post" class="crm-grid"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><input type="hidden" name="version" value="{{ deal.version }}"><label>Date de relance (Paris)<input type="datetime-local" name="reminder" required></label><label>Action<input name="next_action" value="Relancer"></label><button name="action" value="remind" class="btn btn-primary">Fixer la relance</button></form></details>
<form method="post" class="crm-card"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><input type="hidden" name="version" value="{{ deal.version }}"><div class="crm-grid">
{% for key,label in {organization:'Organisation',title:'Intitulé',contact:'Contact',email:'Email',phone:'Téléphone',owner:'Responsable',next_action:'Prochaine action'} %}<label>{{ label }}<input name="fields[{{ key }}]" value="{{ attribute(deal,key) }}" {{ key=='title'?'required':'' }}></label>{% endfor %}
<label>Statut<select name="status">{% for key,label in statuses %}<option value="{{ key }}" {{ deal.status==key?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label><label>Type<select name="kind"><option value="private" {{ deal.kind=='private'?'selected':'' }}>Commercial privé</option><option value="public" {{ deal.kind=='public'?'selected':'' }}>Marché public</option></select></label>
<label>Montant (€)<input name="fields[amount]" value="{{ deal.amount }}" inputmode="decimal"></label><label>Nature du montant<select name="fields[amount_kind]"><option value="">Non précisée</option><option value="estimated" {{ deal.amount_kind=='estimated'?'selected':'' }}>Estimé</option><option value="proposed" {{ deal.amount_kind=='proposed'?'selected':'' }}>Proposé</option></select></label>
{% for key,label in {deadline:'Date limite',reminder:'Date de relance'} %}<label>{{ label }} (Paris)<input type="datetime-local" name="fields[{{ key }}]" value="{{ attribute(deal,key) ? attribute(deal,key)|date('Y-m-d\\TH:i','Europe/Paris') : '' }}"></label>{% endfor %}
<label class="wide">Besoin initial / objet détaillé<textarea name="fields[summary]">{{ deal.summary }}</textarea></label></div>
<details><summary>Informations complémentaires et documents</summary><div class="crm-grid">{% for key,label in {role:'Fonction',first_name:'Prénom',last_name:'Nom',site:'Site d’origine',form_name:'Formulaire',submission_ref:'Référence de soumission',received_at:'Réception',buyer:'Acheteur',reference:'Référence',lot:'Lot',procedure:'Procédure',notice_url:'Lien de l’avis (HTTPS)',sharepoint_url:'Documents SharePoint (HTTPS)',consultation_url:'Consultation officielle (HTTPS)'} %}<label>{{ label }}<input name="fields[{{ key }}]" value="{{ attribute(deal,key) }}"></label>{% endfor %}</div>{% for key,label in {attribution:'Attribution',documents:'Documents et liens officiels',relevance:'Analyse de pertinence'} %}<label>{{ label }}<textarea name="fields[{{ key }}]">{{ attribute(deal,key) }}</textarea></label>{% endfor %}<p class="crm-muted">Détection : {{ deal.detected_at|date('d/m/Y H:i','Europe/Paris') }} · Mise à jour : {{ deal.updated_at|date('d/m/Y H:i','Europe/Paris') }}</p></details>
<label>Ajouter une note de suivi<textarea name="note" placeholder="Échange, réponse déposée, résultat…"></textarea></label><button class="btn btn-primary" name="action" value="save">Enregistrer</button></form>
{% if deal.notice_url %}<a href="{{ deal.notice_url }}" target="_blank" rel="noopener noreferrer">Avis de marché ↗</a>{% endif %} {% if deal.sharepoint_url %}<a href="{{ deal.sharepoint_url }}" target="_blank" rel="noopener noreferrer">Documents SharePoint ↗</a>{% endif %}
{% if candidates %}<details class="crm-card"><summary>Rapprochements possibles · même contact, à vérifier</summary><p>Validez uniquement s’il s’agit du même projet. Les notes et sources seront conservées.</p>{% for d in candidates %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><input type="hidden" name="target" value="{{ d.id }}"><a href="{{ path('admin_crm_show',{id:d.id}) }}">{{ d.title }}</a> <button name="action" value="merge">Rattacher cette affaire à celle-ci</button></form>{% endfor %}</details>{% endif %}
<h2>Historique et sources</h2>{% for e in history %}<article class="crm-card"><small>{{ e.created_at|date('d/m/Y H:i','Europe/Paris') }} · {{ e.kind=='source' ? e.data.origin : e.data.actor|default('CRM') }}</small>
{% if e.kind=='source' %}<h3>{{ e.data.title }}</h3>{% if e.data.url %}<a href="{{ e.data.url }}" rel="noopener noreferrer" target="_blank">Consulter la source ↗</a>{% endif %}
{% for key,value in e.data.proposals %}{% if attribute(deal,key)|default('') != value %}<form method="post" class="crm-card"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><input type="hidden" name="version" value="{{ deal.version }}"><input type="hidden" name="event" value="{{ e.id }}"><input type="hidden" name="field" value="{{ key }}"><p>Proposition issue de cette source : <b>{{ key=='status' ? statuses[value] : key~' : '~value }}</b></p><button name="action" value="proposal">Valider cette proposition</button></form>{% endif %}{% endfor %}
<details><summary>Extrait et données extraites</summary><pre>{{ e.data.excerpt }}</pre><dl>{% for key,value in e.data.extracted %}<dt>{{ key }}</dt><dd>{{ value }}</dd>{% endfor %}</dl></details>
{% elseif e.kind=='manual' %}<p>{{ e.data.note }}</p>{% for key,change in e.data.changes|default([]) %}<p class="crm-muted">{{ key }} : {{ change.before }} → {{ change.after }}</p>{% endfor %}
{% elseif e.kind=='merge' %}<p>Rapprochement validé. Ancienne fiche : {{ e.data.original.title }}</p><details><summary>Informations conservées de l’ancienne fiche</summary><pre>{{ e.data.original|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>{% endif %}</article>{% else %}<p>Aucun échange enregistré.</p>{% endfor %}
{% endblock %}

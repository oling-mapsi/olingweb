{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}

{% block body %}
<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.intro,
    highlights: page.highlights,
  } %}

  <section class="oling-shell-section">
    <div class="container">
      <div class="oling-two-col">
        <article class="oling-surface oling-surface--light">
          <span class="oling-kicker">{{ page.requestSection.kicker }}</span>
          <h2>{{ page.requestSection.title }}</h2>
          {% if page.legacySideHtml is defined and page.legacySideHtml %}
            <div class="oling-richtext">{{ page.legacySideHtml|raw }}</div>
          {% elseif page.requestSection.items is defined and page.requestSection.items %}
            <ul class="oling-check-list">
              {% for item in page.requestSection.items %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          {% endif %}

          <div class="oling-surface oling-surface--light mt-4">
            <h3>{{ page.presenceSection.title }}</h3>
            <p>{{ page.presenceSection.text }}</p>
            <p class="mb-3">
              <strong>Échanger avec OLING</strong><br>
              <a href="tel:+33189701560" data-demand-phone="contact">01 89 70 15 60</a>
            </p>
            {% if agencies is not empty %}
              <ul class="oling-check-list">
                {% for agency in agencies %}
                  <li>{{ agency.name }}{% if agency.city %} - {{ agency.city }}{% endif %}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </article>

        <article class="oling-surface oling-surface--light">
          <span class="oling-kicker">{{ page.formSection.kicker }}</span>
          <h2>{{ page.formSection.title }}</h2>
          <div id="contact-loading" class="d-none align-items-center gap-2 mb-3">
            <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
            <span>{{ page.formSection.loadingText }}</span>
          </div>
          <div id="contact-error" class="alert alert-danger d-none mb-3">{{ page.formSection.errorText }}</div>
          <div id="contact-success" class="d-none">
            <h5 class="mb-2">{{ page.formSection.successTitle }}</h5>
            <p class="mb-0">{{ page.formSection.successText }}</p>
          </div>

          <form id="contact-form" class="oling-contact-form">
            <input type="hidden" name="_token" value="{{ csrf_token('contact_form') }}">
            <div class="oling-contact-form__website" aria-hidden="true">
              <label for="contactWebsite">Site internet</label>
              <input type="text" name="website" id="contactWebsite" tabindex="-1" autocomplete="off" aria-hidden="true">
            </div>
            <input type="hidden" name="demandSource">
            <input type="hidden" name="demandReferrer">
            <input type="hidden" name="demandLandingPage">
            <input type="hidden" name="demandFirstLandingPage">
            <input type="hidden" name="demandCtaSource">
            <input type="hidden" name="demandUtmSource">
            <input type="hidden" name="demandUtmMedium">
            <input type="hidden" name="demandUtmCampaign">
            <div class="row">
              <div class="col-sm-6 mb-4">
                <label class="form-label" for="contactFirstName">{{ page.formSection.fields.firstName.label }}</label>
                <input type="text" class="form-control" name="contactFirstName" id="contactFirstName" maxlength="100" placeholder="{{ page.formSection.fields.firstName.placeholder }}">
              </div>
              <div class="col-sm-6 mb-4">
                <label class="form-label" for="contactLastName">{{ page.formSection.fields.lastName.label }}</label>
                <input type="text" class="form-control" name="contactLastName" id="contactLastName" maxlength="100" placeholder="{{ page.formSection.fields.lastName.placeholder }}">
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label" for="contactCompany">{{ page.formSection.fields.company.label }}</label>
              <input type="text" class="form-control" name="contactCompany" id="contactCompany" maxlength="180" placeholder="{{ page.formSection.fields.company.placeholder }}">
            </div>

            <div class="mb-4">
              <label class="form-label" for="contactWorkEmail">{{ page.formSection.fields.workEmail.label }}</label>
              <input type="email" class="form-control" name="contactWorkEmail" id="contactWorkEmail" maxlength="180" placeholder="{{ page.formSection.fields.workEmail.placeholder }}">
            </div>

            <div class="mb-4">
              <label class="form-label" for="contactDetails">{{ page.formSection.fields.details.label }}</label>
              <textarea class="form-control" name="contactDetails" id="contactDetails" rows="5" maxlength="200" placeholder="{{ page.formSection.fields.details.placeholder }}"></textarea>
            </div>

            <div class="mb-4">
              <div class="form-check oling-contact-form__consent">
                <input class="form-check-input" type="checkbox" id="consent" name="consent">
                <label class="form-check-label" for="consent">
                  {{ page.formSection.consentText }}
                </label>
              </div>
            </div>

            <p class="small text-muted mb-4 oling-contact-form__legal">
              {{ page.formSection.legalText }}
              Pour les demandes RGPD :
              <a href="{{ page.formSection.legalLinkUrl }}" target="_blank" rel="noopener">{{ page.formSection.legalLinkLabel }}</a>.
            </p>

            <div class="d-grid oling-contact-form__submit">
              <button type="button" class="btn btn-primary btn-lg" id="button-send">{{ page.formSection.submitLabel }}</button>
            </div>
          </form>
        </article>
      </div>
    </div>
  </section>

  {% include 'public/_cta_band.html.twig' with {
    eyebrow: page.cta.eyebrow,
    title: page.cta.title,
    text: page.legacyBodyHtml is defined and page.legacyBodyHtml ? page.legacyBodyHtml|striptags : page.cta.text,
    primaryCta: page.cta.primaryCta
  } %}
</main>
{% endblock %}

{% extends 'admin/crm/layout.html.twig' %}
{% block workspace_filters %}
<div class="portfolio-filters">
<nav class="segment-filter segmented" aria-label="Filtrer le portefeuille">{% for key,label in {'':'Tous',markets:'Marchés publics',clients:'Clients'} %}<a class="{{ segment==key?'selected':'' }}" aria-current="{{ segment==key?'page':'false' }}" href="{{ path('admin_crm',app.request.query.all|merge({view:view,segment:key,mode:mode,scope:scope,page:1})) }}">{{ label }}</a>{% endfor %}</nav>
<form class="filters" method="get">
  <input type="hidden" name="view" value="{{ view }}"><input type="hidden" name="segment" value="{{ segment }}"><input type="hidden" name="mode" value="{{ mode }}">
  {% for key,value in {origin:origin,status:status,kind:kind,decision:decision} %}{% if value %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endif %}{% endfor %}
  <label class="search"><span class="sr-only">Recherche</span><input type="search" name="q" value="{{ q }}" placeholder="Société, contact, affaire…"></label>
  {% if view=='portfolio' %}<label><span class="sr-only">Affaires</span><select name="scope"><option value="active" {{ scope=='active'?'selected':'' }}>En cours</option><option value="closed" {{ scope=='closed'?'selected':'' }}>Clôturées</option><option value="all" {{ scope=='all'?'selected':'' }}>Toutes les étapes</option></select></label>{% endif %}
  {% if view=='todo' %}<label><span class="sr-only">Priorité</span><select name="due"><option value="">Toutes les dates</option>{% for key,label in {overdue:'En retard',today:"Aujourd’hui",week:'7 prochains jours',undated:'Sans relance planifiée'} %}<option value="{{ key }}" {{ due==key?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label>{% endif %}
  <button>Appliquer</button>{% if q or origin or status or kind or decision or due %}<a class="reset-filter" href="{{ path('admin_crm',{view:view,segment:segment,mode:mode,scope:scope}) }}">Effacer les filtres{% if status %} · {{ statuses[status]|default(status) }}{% endif %}</a>{% endif %}
</form></div>
{% endblock %}
{% block crm %}
<header class="page-head workspace-heading"><div><div class="eyebrow">RELATIONS & DÉVELOPPEMENT</div><h1>{{ {portfolio:({markets:'Marchés publics',clients:'Demandes clients'}[segment]|default('Votre portefeuille')),todo:'Actions et relances',review:'Imports à réviser',qualify:'À qualifier',all:'Toutes les affaires',active:'Affaires en cours'}[view]|default('Votre portefeuille') }}</h1><p class="sr-only">{{ view=='todo'?'Relances et dépôts distincts, triés par leur prochaine date utile.':view=='portfolio' and segment=='markets'?'Tous vos marchés, classés selon votre avancement.':(view=='portfolio' and segment=='clients'?'Formulaires OLING et MAPSI, complétés par vos saisies manuelles.':'Tous vos marchés et clients, de la qualification à la décision.') }}</p></div><div id="deadline-summary" aria-live="polite">{% include 'admin/crm/_deadlines.html.twig' %}</div></header>

<div class="view-toolbar"><div class="segmented"><a class="{{ mode=='board'?'selected':'' }}" aria-current="{{ mode=='board'?'page':'false' }}" href="{{ path('admin_crm',app.request.query.all|merge({mode:'board',page:1})) }}">▥ Kanban</a><a class="{{ mode=='list'?'selected':'' }}" aria-current="{{ mode=='list'?'page':'false' }}" href="{{ path('admin_crm',app.request.query.all|merge({mode:'list',page:1})) }}">☰ Liste</a></div><p class="board-help"><span data-board-total>{{ total }}</span> fiches{% if mode=='board' %} · Glisser ou Détails pour changer le statut.{% endif %}</p><div class="crm-actions">{% if mode=='board' and view=='portfolio' %}
<div class="closure-targets" role="group" aria-label="Clôturer une proposition" aria-describedby="closure-help">
{% for key,label in {lost:'Clôturée perdue',won:'Clôturée gagnée'} %}<a class="closure-target closure-{{ key }}" data-close-status="{{ key }}" href="{{ path('admin_crm',app.request.query.all|merge({scope:'closed',status:key,page:1})) }}" title="Déposez une carte pour la clôturer ; cliquez pour consulter les propositions {{ key=='won'?'gagnées':'perdues' }}."><span class="closure-icon" aria-hidden="true">{{ key=='won'?'✓':'×' }}</span><span>{{ label }}</span><span class="closure-count" data-closed-count="{{ key }}">{{ closed_counts[key] }}</span><span class="closure-saving" aria-hidden="true">…</span></a>{% endfor %}
</div><span class="sr-only" id="closure-help">Compteurs selon la recherche et les filtres du portefeuille, toutes étapes confondues. Glissez une carte, ou utilisez son menu Détails puis Avancement au clavier.</span>
{% endif %}<a href="{{ path('admin_crm_export') }}">Exporter CSV</a><a class="btn primary" href="{{ path('admin_crm_new') }}">＋ Nouvelle affaire</a></div></div>
{% if mode=='board' %}
<nav class="column-jump" aria-label="Accès aux colonnes">{% for key,label in columns %}<button type="button" data-column="{{ key }}" aria-label="{{ label }}">{{ key=='sent'?'Envoyée / déposée':label }}</button>{% endfor %}</nav>
<div class="board-scroll" role="region" aria-label="Défilement horizontal du Kanban" tabindex="0"><div></div></div>
<div class="board" style="--columns:{{ columns|length }}"  data-token="{{ csrf_token('crm') }}" data-field="status" data-total="{{ total }}" data-status-filter="{{ status }}" data-view="{{ view }}" data-due="{{ due }}" tabindex="0" role="region" aria-label="Kanban commercial">
{% for key,label in columns %}<section class="lane" tabindex="-1" data-value="{{ key }}" aria-labelledby="lane-{{ key }}"><header><span class="dot dot-{{ key }}"></span><h2 id="lane-{{ key }}"{% if key=='no_go' %} title="Nous décidons de ne pas poursuivre cette opportunité"{% endif %}>{{ label }}</h2><span>{{ deals|filter(d => d.status==key)|length }}</span></header><div class="lane-cards">{% for d in deals %}{% if d.status==key %}{% include 'admin/crm/_card.html.twig' %}{% endif %}{% endfor %}</div></section>{% endfor %}</div>{% else %}
<div class="crm-card crm-table" role="region" aria-label="Liste des affaires" tabindex="0"><table><caption class="sr-only">{{ view=='todo'?'Actions et relances, triées par date pertinente':'Affaires du portefeuille' }}</caption><thead><tr><th scope="col">Affaire / organisation</th><th scope="col">Action attendue</th><th scope="col">Relance commerciale</th><th scope="col">Dépôt / remise</th><th scope="col">Avancement</th></tr></thead><tbody>
{% for d in deals %}<tr><td><a href="{{ path('admin_crm_show',{id:d.id}) }}"><strong>{{ d.title }}</strong></a><small>{{ d.organization ?: d.buyer ?: 'Organisation à préciser' }}</small><small>{{ d.kind=='public' or d.origin=='watch'?'Marché public':'Client' }}</small></td><td class="action-cell">{{ d.next_action ?: 'Action à définir' }}{% if d.next_action and not d.reminder %}<small>Sans relance planifiée</small>{% endif %}</td><td>{% include 'admin/crm/_date.html.twig' with {value:d.reminder,label:'Relance',empty:'Non planifiée',actionable:d.status not in ['won','lost','no_go','archived']} only %}</td><td>{% include 'admin/crm/_date.html.twig' with {value:d.deadline,label:d.kind=='public' or d.origin=='watch'?'Dépôt':'Remise',empty:'Non renseignée',actionable:d.status not in ['sent','discussion','won','lost','no_go','archived']} only %}</td><td><span class="crm-badge badge-{{ d.status }}">{{ statuses[d.status] }}</span></td></tr>
{% else %}<tr><td colspan="5" class="empty-state">Aucune fiche pour ces filtres. Modifiez la recherche ou ajoutez une affaire.</td></tr>{% endfor %}
</tbody></table></div>{% endif %}
<div class="pagination">{% if mode=='list' %}{% if page>1 %}<a href="{{ path('admin_crm',app.request.query.all|merge({page:page-1})) }}">← Précédent</a>{% endif %}<span>Page {{ page }} · {{ total }} résultat(s)</span>{% if page*50<total %}<a href="{{ path('admin_crm',app.request.query.all|merge({page:page+1})) }}">Suivant →</a>{% endif %}{% else %}<span><span data-board-total>{{ total }}</span> fiche(s)</span>{% endif %}</div>
<details class="connections"><summary>Connexions et alimentation</summary><p>Demandes clients : formulaires OLING et MAPSI · Saisie manuelle disponible.</p><p>Outlook : {{ connections.email?'Connecté en lecture seule':'Désactivé' }} · Veille : {{ connections.watch?'Import activé':'Désactivée' }} · Tâches : {{ connections.scheduler?'Activées':'Désactivées' }}</p><p>Dernier passage Outlook : {{ sync.last_success|default('En attente') }} · Import veille : {{ watch.last_success|default('En attente') }}</p>{% if sync.next|default(null) %}<p>Lecture de l’historique en cours.</p>{% endif %}{% if sync.error|default(null) %}<p class="alert alert-danger">{{ sync.error }}</p>{% endif %}<p>Formulaires : {{ forms.pending|default(0) }} en attente de reprise · {{ forms.mapsi_notification_pending|default(0) }} notification(s) MAPSI à vérifier · Dernier traitement : {{ forms.last_success|default('En attente') }}</p><form method="post" action="{{ path('admin_crm_sync') }}"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><button {% if not connections.email or not connections.scheduler %}disabled{% endif %}>Relancer l’alimentation</button></form></details>
{% endblock %}

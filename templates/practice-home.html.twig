{% extends 'base.html.twig' %}

{% block title %}{{ practiceNarrative.metaTitle|default(practice.designation ~ ' | OLING') }}{% endblock %}
{% block meta_description %}{{ practiceNarrative.metaDescription|default(practiceNarrative.intro|striptags) }}{% endblock %}

{% block body %}
<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: practiceNarrative.eyebrow,
    title: practiceNarrative.headline,
    intro: practiceNarrative.intro,
    primaryCta: {route: 'contact', label: 'Parler de votre projet'},
    secondaryCta: {route: 'expertises_index', label: 'Voir les expertises'},
    externalCta: practice.slug == 'mapsi' ? {href: 'https://mapsi.fr', label: 'Accéder au site MAPSI'} : null,
    highlights: practiceNarrative.focus|slice(0, 3)
  } %}

  <section class="oling-shell-section">
    <div class="container">
      <div class="oling-two-col">
        <article class="oling-surface oling-surface--light">
          <span class="oling-kicker">{{ practice.designationShort ?: 'Practice OLING' }}</span>
          <h2>{% if practice.slug == 'consulting' %}Quel rôle joue OLING dans un projet d’AMOA SI ?{% else %}{{ practice.designation }}{% endif %}</h2>
          <p>{{ practiceNarrative.promise }}</p>
          {% if practice.description %}
            <div class="oling-richtext">{{ practice.description|raw }}</div>
          {% endif %}
        </article>
        <article class="oling-surface oling-surface--light">
          <span class="oling-kicker">Services clés</span>
          <h2>{% if practice.slug == 'consulting' %}Quelles expertises OLING peut mobiliser autour de l’AMOA SI ?{% else %}Les expertises rattachées à cette practice{% endif %}</h2>
          <ul class="oling-check-list">
            {% for item in practiceNarrative.focus %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </article>
      </div>
    </div>
  </section>

  {% if practiceNarrative.missionPhases is defined and practiceNarrative.missionPhases|length > 0 %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">AMOA SI</span>
          <h2>Que couvre une mission d’AMOA SI chez OLING ?</h2>
          <p>Nous intervenons comme tiers indépendant pour rendre le projet lisible, arbitrable et pilotable, sans posture d’éditeur ni de revendeur.</p>
        </div>
        <div class="oling-service-link-grid">
          {% for item in practiceNarrative.missionPhases %}
            <article class="oling-surface oling-surface--light">
              <h3>{{ item }}</h3>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if practiceNarrative.projectContexts is defined and practiceNarrative.projectContexts|length > 0 %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-two-col">
          <article class="oling-surface oling-surface--light">
            <span class="oling-kicker">Projets</span>
            <h2>Dans quels projets OLING intervient-il ?</h2>
            <ul class="oling-check-list">
              {% for item in practiceNarrative.projectContexts %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </article>
          <article class="oling-surface oling-surface--light">
            <span class="oling-kicker">Livrables</span>
            <h2>Quels livrables et dispositifs sont mobilisables ?</h2>
            <ul class="oling-check-list">
              {% for item in practiceNarrative.deliverables|default([]) %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </article>
        </div>
      </div>
    </section>
  {% endif %}

  {% if practiceNarrative.clientTypes is defined and practiceNarrative.clientTypes|length > 0 %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">Contextes</span>
          <h2>Pour quels types d’organisation et de gouvernance ?</h2>
        </div>
        <div class="oling-service-link-grid">
          {% for item in practiceNarrative.clientTypes %}
            <article class="oling-surface oling-surface--light">
              <p class="mb-0">{{ item }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <section class="oling-shell-section oling-shell-section--tint">
    <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">Offres</span>
          <h2>{{ practice.designationShort ?: 'Services OLING' }}</h2>
          <p>{{ practice.introductionShort ?: 'Cette practice regroupe un même angle d’expertise. Les services ci-dessous décrivent ensuite les interventions concrètes, livrables et dispositifs activables selon votre contexte.' }}</p>
      </div>
      <div class="oling-service-link-grid">
        {% for service in practice.services %}
          <a class="oling-service-link-card" href="{{ path('service', {practice: service.practice.slug, slug: service.slug}) }}">
            <span class="oling-kicker">{{ service.designationShort ?: 'Offre OLING' }}</span>
            <h3>{{ service.designation }}</h3>
            <p>{{ service.introductionShort ?: service.descriptionShort ?: 'Voir le détail de cette offre.' }}</p>
            <span class="oling-service-link-card__more">Voir l'offre</span>
          </a>
        {% else %}
          <article class="oling-surface oling-surface--light">
            <p>Services en cours de publication.</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  {% if projects|length > 0 %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">Cas et contextes</span>
          <h2>Quelques projets liés à cette practice</h2>
        </div>
        <div class="oling-project-proof-grid">
          {% for project in projects|slice(0, 3) %}
            <article class="oling-proof-card">
              <span class="oling-kicker">{{ project.metier ? project.metier.designation : 'Projet' }}</span>
              <h3>{{ project.designation }}</h3>
              <p>{{ project.description ? project.description|striptags|slice(0, 180) ~ '…' : 'Projet pilote avec une logique de clarté, d\'exécution et de sécurisation.' }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if teams|length > 0 %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">Équipe</span>
          <h2>Experts mobilisables sur cette practice</h2>
        </div>
        <div class="oling-team-mini-list">
          {% for team in teams %}
            <div class="oling-team-mini">
              <img class="oling-team-mini__avatar" src="{{ team.photo ?: asset('img/160x160/img1.jpg') }}" alt="Photo de {{ team.noncomplet }}">
              <div class="oling-team-mini__meta">
                <div class="oling-team-mini__name">{{ team.noncomplet }}</div>
                {% if team.titre %}
                  <div class="oling-team-mini__title">{{ team.titre }}</div>
                {% endif %}
                {% if team.linkedin %}
                  <a class="oling-team-mini__link" href="{{ team.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if practiceNarrative.supportLinks is defined and practiceNarrative.supportLinks|length > 0 %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">Pages liées</span>
          <h2>Pages liées pour approfondir l’AMOA SI</h2>
          <p>Chaque lien ci-dessous renvoie vers une page utile pour approfondir un projet, une expertise ou un contexte d’intervention.</p>
        </div>
        <div class="oling-service-link-grid">
          {% for item in practiceNarrative.supportLinks %}
            <a class="oling-service-link-card" href="{{ item.href }}">
              <span class="oling-kicker">Page liée</span>
              <h3>{{ item.label }}</h3>
              <p>{{ item.description }}</p>
              <span class="oling-service-link-card__more">Ouvrir la page liée</span>
            </a>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% include 'public/_cta_band.html.twig' with {
    title: 'Remettre de la clarté et de la maîtrise dans vos transformations',
    text: 'OLING peut intervenir en renfort ponctuel ou sur la durée pour structurer les décisions, piloter et fiabiliser l\'exécution du projet.',
    primaryCta: {route: 'contact', label: 'Demander un échange'}
  } %}
</main>

{% if practice.slug == 'consulting' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AMOA SI et pilotage de projets de transformation",
    "serviceType": "Assistance à maîtrise d’ouvrage SI",
    "provider": {
      "@type": "ProfessionalService",
      "name": "OLING Management et Technologie",
      "url": "https://oling.fr"
    },
    "url": "https://oling.fr/amoa-si",
    "areaServed": ["France", "Guadeloupe", "Martinique", "Guyane", "Réunion", "Saint-Pierre-et-Miquelon"],
    "description": "Cadrage, expression des besoins, consultation, aide au choix, pilotage fournisseurs, recette, migration et conduite du changement sur les projets SI."
  }
  </script>
{% endif %}
{% endblock %}

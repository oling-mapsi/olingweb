{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}
{% block canonical_url %}{{ app.request.schemeAndHttpHost ~ (canonicalPath|default(app.request.pathInfo)) }}{% endblock %}

{% block body %}
<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.intro,
    primaryCta: page.primaryCta,
    secondaryCta: page.secondaryCta,
    highlights: page.highlights
  } %}

  {% for block in page.sections %}
    <section class="oling-shell-section oling-about-foundation">
      <div class="container">
        <div class="oling-two-col oling-about-foundation__grid">
          {% for item in block.items %}
            <article class="oling-about-principle">
              {% if item.kicker is defined %}<span class="oling-kicker">{{ item.kicker }}</span>{% endif %}
              {% if item.title is defined %}<h2>{{ item.title }}</h2>{% endif %}
              {% if item.html is defined and item.html %}
                <div class="oling-richtext">{{ item.html|raw }}</div>
              {% elseif item.list is defined and item.list %}
                <ul class="oling-check-list">
                  {% for entry in item.list %}
                    <li>{{ entry }}</li>
                  {% endfor %}
                </ul>
              {% elseif loop.last and page.legacySideHtml is defined and page.legacySideHtml %}
                <div class="oling-richtext">{{ page.legacySideHtml|raw }}</div>
              {% elseif item.text is defined %}
                <p>{{ item.text }}</p>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endfor %}

  {% include 'public/_iso27001_certification_proof.html.twig' with {
    headingId: 'iso27001-certification-about'
  } %}

  {% if teamPreview is defined and teamPreview|length > 0 %}
    <section class="oling-shell-section oling-about-leadership" aria-labelledby="oling-about-leadership-heading">
      <div class="container">
        <div class="oling-about-leadership__heading">
          <div>
            <span class="oling-kicker">{{ 'leadership.eyebrow'|trans }}</span>
            <h2 id="oling-about-leadership-heading">{{ 'leadership.about_title'|trans }}</h2>
          </div>
          <p>{{ 'leadership.about_intro'|trans }}</p>
        </div>
        <div class="oling-leadership-grid oling-leadership-grid--preview">
          {% for member in teamPreview %}
            {% include 'public/_leadership_card.html.twig' with {person: member, mode: 'preview'} only %}
          {% endfor %}
        </div>
        <div class="oling-about-leadership__actions oling-section-actions">
          {% set currentLocale = app.request.locale|default('fr') %}
          {% set teamPath = currentLocale == 'en' ? '/en/team' : (currentLocale == 'es' ? '/es/equipo' : path('team')) %}
          {% set contactPath = currentLocale == 'en' ? '/en/contact' : (currentLocale == 'es' ? '/es/contacto' : path('contact')) %}
          <a class="btn btn-primary" href="{{ teamPath }}">{{ 'leadership.meet_label'|trans }}</a>
          <a class="btn btn-outline-dark" href="{{ contactPath }}">{{ 'leadership.contact_label'|trans }}</a>
        </div>
      </div>
    </section>
  {% endif %}

  {% if page.legacyBodyHtml is defined and page.legacyBodyHtml %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ page.bodySection.kicker }}</span>
          <h2>{{ page.bodySection.title }}</h2>
        </div>
        <div class="oling-surface oling-surface--light">
          <div class="oling-richtext">{{ page.legacyBodyHtml|raw }}</div>
        </div>
      </div>
    </section>
  {% endif %}

  <section class="oling-shell-section oling-about-links">
    <div class="container">
      <div class="oling-section-head">
        <span class="oling-kicker">{{ page.linksSection.kicker }}</span>
        <h2>{{ page.linksSection.title }}</h2>
      </div>
      <div class="oling-service-link-grid">
        {% for link in page.linksSection.links %}
          <a class="oling-service-link-card" href="{{ link.route is defined ? path(link.route, link.routeParams|default({})) : link.url }}" {% if link.url is defined %}target="_blank" rel="noopener"{% endif %}>
            <span class="oling-kicker">{{ link.kicker }}</span>
            <h3>{{ link.title }}</h3>
            <p>{{ link.text }}</p>
            <span class="oling-service-link-card__more">{{ link.moreLabel }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  {% include 'public/_cta_band.html.twig' with {
    title: page.cta.title,
    text: page.cta.text,
    primaryCta: {
      route: page.cta.primaryCta.route ?? 'contact',
      label: page.cta.primaryCta.label ?? 'Contact'
    }
  } %}
</main>
{% endblock %}

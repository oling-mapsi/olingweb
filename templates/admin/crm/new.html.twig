{% extends 'admin/crm/layout.html.twig' %}
{% block crm %}<h2>Nouvelle affaire</h2><form method="post" class="crm-card crm-grid"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><label>Intitulé<input name="fields[title]" value="{{ values.title|default('') }}" required maxlength="1000"></label><label>Organisation<input name="fields[organization]" value="{{ values.organization|default('') }}"></label><label>Type<select name="kind"><option value="private">Commercial privé</option><option value="public">Marché public</option></select></label><label>Email<input type="email" name="fields[email]" value="{{ values.email|default('') }}"></label><button class="btn btn-primary wide">Créer l’affaire</button></form>{% endblock %}

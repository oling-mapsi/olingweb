<div class="cms-table-wrap"><table class="cms-table cms-site-table"><thead><tr><th>Image</th><th>Page ou contenu</th><th>Visibilité</th><th>Actions</th></tr></thead><tbody>{% for row in rows %}<tr data-site-key="{{ row.key }}"><td>{% include 'admin/catalogue/_thumbnail.html.twig' %}</td><td><strong>{{ row.displayTitle }}</strong><small class="cms-subtitle">{{ row.ownerLabel }}</small><span class="cms-subtitle">{{ row.description }}</span>{% if row.publicUrl %}{% if row.canView %}<a class="cms-site-url" href="{{ row.publicUrl }}" target="_blank" rel="noopener">{{ row.publicUrl }}</a>{% else %}<span class="cms-site-url">{{ row.publicUrl }}</span>{% endif %}{% else %}<span class="cms-subtitle">Pas de page publique</span>{% endif %}{% if row.associatedPages|default([]) %}<div class="cms-associated-pages"><small>Pages complémentaires SEO/GEO</small>{% for page in row.associatedPages %}<div data-associated-page="{{ page.key }}"><div class="cms-associated-title">{% if page.thumbnail %}<img src="{{ page.thumbnail }}" alt="{{ page.displayTitle }}" width="40" height="30">{% endif %}<strong class="small">{{ page.displayTitle }}</strong> <span class="cms-status">{{ page.visibility }}</span></div>{% if page.canView %}<a class="cms-site-url" href="{{ page.publicUrl }}" target="_blank" rel="noopener">{{ page.publicUrl }}</a>{% else %}<span class="cms-site-url">{{ page.publicUrl }}</span>{% endif %}{% if page.canView %}<a class="btn btn-outline-secondary btn-sm" href="{{ page.publicUrl }}" target="_blank" rel="noopener">Voir sur le site</a>{% endif %} <a class="btn btn-outline-primary btn-sm" href="{{ page.edit }}">Modifier cette page</a></div>{% endfor %}</div>{% endif %}{% if row.publicOwner %}<p class="small mt-1">Le rendu de cette URL est porté par <a href="{{ row.publicOwner.edit }}">{{ row.publicOwner.title }}</a>. La fiche du secteur ci-dessus reste distincte.</p>{% endif %}{% if row.services|default([]) %}<details><summary class="small">{{ row.services|length }} prestations liées</summary>{% for service in row.services %}<a class="cms-subtitle" href="{{ service.edit }}">{{ service.title }}</a>{% endfor %}</details>{% endif %}{% if row.references %}<details><summary class="small">{{ row.references|length }} références associées</summary>{% for ref in row.references %}<a class="cms-subtitle" href="{{ ref.edit }}">{{ ref.title }}</a>{% endfor %}</details>{% endif %}{% if row.technical=='team' %}{% if row.bio %}<details><summary class="small">Biographie et profil public</summary><p class="small">{{ row.bio|striptags }}</p></details>{% endif %}<small class="cms-subtitle">Ordre : {{ row.displayOrder ?? 'non défini' }}</small>{% endif %}</td><td><span class="cms-status {{ row.visibility=='En ligne' ? 'cms-status-published' : '' }}">{{ row.visibility }}</span><details class="cms-site-status"><summary>Publication et SEO</summary><p>Statut éditorial enregistré : {{ row.editorialLabel }}</p><p>Indexabilité SEO : {{ row.indexability }}. L’indexation Google n’est pas mesurée ici.</p>{% if row.http %}<small>Observation HTTP {{ row.http }} · {{ row.observedAt }}</small>{% endif %}</details></td><td><div class="cms-site-actions">{% if row.canView %}<a class="btn btn-outline-secondary btn-sm" href="{{ row.publicUrl }}" target="_blank" rel="noopener">Voir sur le site</a>{% endif %}{% if row.preview %}<a class="btn btn-outline-secondary btn-sm" href="{{ row.preview }}" target="_blank" rel="noopener">Aperçu administrateur</a>{% endif %}{% if row.edit %}<a class="btn btn-primary btn-sm" href="{{ row.edit }}">Modifier</a>{% else %}<small>Pas d’éditeur de page autonome</small>{% endif %}{% if row.domainUrl %}<a class="small" href="{{ row.domainUrl }}">{{ row.localPageCount|default(0)>0 ? 'Pages complémentaires SEO/GEO (' ~ row.localPageCount ~ ')' : 'Pages associées' }}</a>{% endif %}</div></td></tr>{% else %}<tr><td colspan="4">Aucun contenu ne correspond à cette recherche.</td></tr>{% endfor %}</tbody></table></div>

<article class="deal-card" data-id="{{ d.id }}" data-version="{{ d.version }}" data-url="{{ path('admin_crm_move',{id:d.id}) }}" draggable="true"><div class="card-meta"><span class="drag-grip" aria-hidden="true" title="Glisser pour déplacer">⠿</span><span>{{ d.kind=='public' or d.origin=='watch'?'Marché public':'Client' }} {{ d.site }}</span><span>{{ d.amount?d.amount~' €':'' }}</span></div><h3><a draggable="false" href="{{ path('admin_crm_show',{id:d.id}) }}">{{ d.title }}</a></h3><p class="company">{{ d.organization ?: d.buyer ?: 'Société à préciser' }}</p><p class="contact">{{ d.contact ?: d.email ?: 'Contact à préciser' }}</p><div class="next-action"><small>PROCHAINE ACTION</small><p>{{ d.next_action ?: 'À définir' }}</p>{% if d.reminder %}<time>{{ d.reminder|date('d/m/Y H:i','Europe/Paris') }}</time>{% endif %}</div>{% if d.deadline %}<p class="deadline">Échéance · {{ d.deadline|date('d/m/Y H:i','Europe/Paris') }}</p>{% endif %}
{% if d.origin=='watch' %}<span class="crm-badge">{{ decisions[d.decision] }}</span>{% endif %}
{% if view!='markets' %}<label class="status-label">Changer le statut<select class="card-status" aria-label="Statut de {{ d.title }}">{% for value,label in statuses %}<option value="{{ value }}" {{ value==d.status?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label>{% else %}<label class="status-label">Décision<select class="card-status" aria-label="Décision de {{ d.title }}">{% for value,label in decisions %}<option value="{{ value }}" {{ value==d.decision?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label><a draggable="false" class="card-link" href="{{ path('admin_crm_show',{id:d.id}) }}">Examiner et décider →</a>{% endif %}</article>

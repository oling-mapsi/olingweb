{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}

{% block body %}
{% set locale = app.request.locale|default('fr') %}
{% set ui = {
  fr: {
    cards_kicker: 'Fiches expertise',
    cards_title: 'Expertises transverses',
    cards_lead: 'Neuf expertises structurées pour cadrer, piloter et déployer',
    cards_text: 'Chaque fiche aide d’abord à qualifier un sujet. Une fois le bon angle identifié, les pages services détaillent l’intervention, et les pages secteurs montrent dans quels contextes métier cette expertise devient prioritaire.',
    card_more: 'Voir la fiche'
  },
  en: {
    cards_kicker: 'Expertise pages',
    cards_title: 'Cross-functional expertise',
    cards_lead: 'Nine structured areas of expertise to scope, steer and deliver',
    cards_text: 'Each page helps qualify the issue first. Once the right angle is clear, service pages detail the intervention and sector pages show where this expertise becomes a priority.',
    card_more: 'View page'
  },
  es: {
    cards_kicker: 'Fichas de especialización',
    cards_title: 'Especializaciones transversales',
    cards_lead: 'Nueve áreas estructuradas para encuadrar, pilotar y desplegar',
    cards_text: 'Cada ficha ayuda primero a calificar el tema. Una vez identificado el enfoque adecuado, las páginas de servicios detallan la intervención y las páginas sectoriales muestran dónde esta especialización se vuelve prioritaria.',
    card_more: 'Ver ficha'
  }
}[locale]|default({}) %}
{% set universes = [
  {
    title: 'AMOA & Applications métiers',
    intro: 'ERP, CRM, GMAO, SI Finance, SIRH, data et IA : cadrage, choix, recette et mise en production.',
    href: path('services_index') ~ '#amoa-applications-metiers',
    items: [
      {label: 'AMOA SI', href: path('amoa_si'), text: 'Cadrage, gouvernance projet, expression des besoins, recette et conduite du changement.'},
      {label: 'ERP', href: '/business-apps/erp', text: 'Choix du progiciel, déploiement, reprise de données, interfaces et mise en production.'},
      {label: 'CRM', href: '/crm', text: 'Processus commerciaux, données client, choix de solution, adoption et reporting.'},
      {label: 'GMAO', href: '/gmao', text: 'Maintenance, actifs, données équipements, mobilité terrain, recette et déploiement.'},
      {label: 'SI Finance', href: '/si-finance', text: 'Processus finance, ERP/EPM, reporting, contrôle interne et intégrations.'},
      {label: 'Facturation électronique', href: '/facturation-electronique-amoa', text: 'Cadrage e-invoicing, flux, formats, plateformes agréées (PA) et conduite du changement.'},
      {label: 'Data / BI', href: '/business-apps/bi-et-analytique', text: 'Reporting, données décisionnelles, tableaux de bord et pilotage par les indicateurs.'},
      {label: 'IA & automatisation', href: '/business-apps/transformation-digitale-automatisation-et-ia-utile', text: 'Processus, automatisation utile, agents métier, cadrage et mesure des gains.'}
    ]
  },
  {
    title: 'Gouvernance & Performance DSI',
    intro: 'Organiser le SI, prioriser les décisions et rendre les projets pilotables.',
    href: path('services_index') ~ '#gouvernance-performance-dsi',
    items: [
      {label: 'Schéma directeur SI', href: '/consulting/plan-strategique', text: 'Diagnostic, trajectoire SI, priorisation du portefeuille et feuille de route.'},
      {label: 'Pilotage de projets / PMO', href: '/consulting/pilotage-des-plans', text: 'Planning, budget, risques, fournisseurs, comités et décisions de cadrage.'},
      {label: 'Organisation & processus', href: '/consulting/management-des-processus', text: 'Clarification des processus, responsabilités, irritants et modes de fonctionnement.'},
      {label: 'Gouvernance des données', href: '/consulting/gouvernance-des-donnees', text: 'Référentiels, qualité des données, responsabilités et usages de pilotage.'},
      {label: 'Infrastructure & modernisation SI', href: '/infrastructure-si-amoa', text: 'Cadrage infrastructure, scénarios techniques, risques, planning et gouvernance de transition.'},
      {label: 'DSI externalisée', href: '/dsi-externalisee', text: 'Appui de direction SI, priorités, fournisseurs, budget et continuité opérationnelle.'}
    ]
  },
  {
    title: 'Conformité, Risques & Résilience',
    intro: 'RGPD, cyber, QSE, PCA/PRA, risques, contrôle interne et IA : obligations, contrôles et preuves.',
    href: path('services_index') ~ '#conformite-risques-resilience',
    items: [
      {label: 'RGPD / DPO', href: '/expertises-audit/rgpd', text: 'DPO externalisé, registre, DPIA, droits, contrats et pilotage de conformité.'},
      {label: 'Cybersécurité / ISO 27001', href: '/cyber-securite', text: 'Gouvernance sécurité, risques, PSSI, contrôles, ISO 27001, NIS2 et DORA.'},
      {label: 'PCA / PRA / ISO 22301', href: '/pca-pra-continuite-activite', text: 'BIA, activités critiques, RTO/RPO, continuité métier, reprise SI et exercices.'},
      {label: 'ISO 9001 / QSE', href: '/expertises-audit/qse', text: 'Qualité, sécurité, environnement, audits, actions correctives et revue de direction.'},
      {label: 'Risques & contrôle interne', href: '/gestion-risques-audit-controle-interne', text: 'Cartographie des risques, contrôles, plans de maîtrise et reporting.'},
      {label: 'Conformité IA / AI Act', href: '/expertises-audit/conformite-ia-gouvernance-et-ai-act', text: 'Usages IA, responsabilités, registres, risques, supervision humaine et preuves.'}
    ]
  }
] %}

<main id="content" class="oling-expertises-index oling-public-editorial oling-public-editorial--expertises" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.intro,
    primaryCta: page.primaryCta,
    secondaryCta: page.secondaryCta,
    highlights: page.highlights
  } %}

  {% if locale == 'fr' %}
  <section class="oling-universes oling-expertises-domains" aria-labelledby="expertises-domains-title">
    <div class="container">
      <div class="oling-universes__head">
        <span class="oling-universes__overline" aria-hidden="true">01 — Une vision d’ensemble</span>
        <span class="oling-kicker">Domaines d’intervention</span>
        <h2 id="expertises-domains-title">Nos 3 domaines d’intervention</h2>
      </div>
      <div class="oling-universes__grid">
        {% for universe in universes %}
          <article class="oling-universe oling-universe--{{ loop.index }}" aria-labelledby="expertise-universe-{{ loop.index }}">
            <div class="oling-universe__head">
              <div class="oling-universe__ordinal" aria-hidden="true">
                <span>{{ '%02d'|format(loop.index) }}</span><span>/ 03</span>
              </div>
              <span class="oling-kicker">Domaine d’intervention</span>
              <h3 id="expertise-universe-{{ loop.index }}">{{ universe.title }}</h3>
              <p>{{ universe.intro }}</p>
              <a class="oling-universe__cta" href="{{ universe.href }}">Voir les services</a>
            </div>
            <ul class="oling-universe__links">
              {% for item in universe.items %}
                <li>
                  <a class="oling-universe__link" href="{{ item.href }}">
                    <strong>{{ item.label }}</strong>
                    <span>{{ item.text }}</span>
                    <span class="oling-universe__link-icon" aria-hidden="true">↗</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section class="oling-expertises-needs" aria-labelledby="expertises-needs-title">
    <div class="container oling-expertises-needs__inner">
      <div>
        <span class="oling-kicker">{{ page.section.kicker }}</span>
        <h2 id="expertises-needs-title">{{ page.section.title }}</h2>
      </div>
      <div>
        <p>{{ page.section.text }}</p>
      </div>
    </div>
  </section>

  <section class="oling-shell-section oling-expertises-featured" aria-labelledby="expertises-featured-title">
    <div class="container">
      <div class="oling-section-head">
        <span class="oling-kicker">{{ ui.cards_kicker }}</span>
        <h2 id="expertises-featured-title">{{ ui.cards_title }}</h2>
        <p class="oling-expertises-needs__lead">{{ ui.cards_lead }}</p>
        <p>{{ ui.cards_text }}</p>
      </div>
      <div class="oling-expertise-index-grid">
        {% for slug, expertisePage in expertisePages %}
          <article class="oling-expertise-index-card">
            <div class="oling-expertise-index-card__top">
              <span class="oling-kicker">{{ expertisePage.nav }}</span>
              <span class="oling-expertise-index-card__number" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
            </div>
            <h3>{{ expertisePage.title }}</h3>
            <p>{{ expertisePage.intro }}</p>
            <a class="oling-expertise-index-card__link" href="{{ expertisePage.href|default(path('expertises_show', {slug: slug})) }}">{{ ui.card_more }}</a>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  {% if locale == 'fr' %}
  <section class="oling-shell-section oling-expertises-mapsi" aria-labelledby="expertises-mapsi-title">
    <div class="container oling-expertises-mapsi__inner">
      <div class="oling-section-head mb-0">
        <span class="oling-kicker">Plateforme GRC</span>
        <h2 id="expertises-mapsi-title">MAPSI</h2>
        <p>La plateforme GRC développée par OLING outille des dispositifs de risques, conformité, qualité, RGPD, PCA et contrôle interne.</p>
      </div>
      <a class="oling-universe__cta" href="https://mapsi.fr/" target="_blank" rel="noopener">Accéder à mapsi.fr</a>
    </div>
  </section>

  <section class="oling-shell-section oling-expertises-complementary" aria-labelledby="expertises-audit-complementaires-title">
    <div class="container">
      <div class="oling-section-head">
        <span class="oling-kicker">Audit et pilotage</span>
        <h2 id="expertises-audit-complementaires-title">Expertises complémentaires</h2>
        <p>Ces interventions complètent les pages owner lorsque le besoin porte sur un contrôle, une fonction ou une preuve spécifique.</p>
      </div>
      <div class="oling-expertise-index-grid">
        <article class="oling-expertise-index-card oling-expertise-index-card--secondary">
          <div class="oling-expertise-index-card__top">
            <span class="oling-kicker">Audit</span>
            <span class="oling-expertise-index-card__number" aria-hidden="true">↗</span>
          </div>
          <h3>Achats et marchés</h3>
          <p>Procédures, conformité achats, marchés publics et sécurisation des décisions.</p>
          <a class="oling-expertise-index-card__link" href="/expertises-audit/achats-marches">Voir la fiche</a>
        </article>
        <article class="oling-expertise-index-card oling-expertise-index-card--secondary">
          <div class="oling-expertise-index-card__top">
            <span class="oling-kicker">Contrôle</span>
            <span class="oling-expertise-index-card__number" aria-hidden="true">↗</span>
          </div>
          <h3>Contrôle interne</h3>
          <p>Contrôles clés, risques, responsabilités et plans de maîtrise.</p>
          <a class="oling-expertise-index-card__link" href="/expertises-audit/controle-interne">Voir la fiche</a>
        </article>
        <article class="oling-expertise-index-card oling-expertise-index-card--secondary">
          <div class="oling-expertise-index-card__top">
            <span class="oling-kicker">Pilotage</span>
            <span class="oling-expertise-index-card__number" aria-hidden="true">↗</span>
          </div>
          <h3>Contrôle de gestion</h3>
          <p>Indicateurs, budget, reporting et performance opérationnelle.</p>
          <a class="oling-expertise-index-card__link" href="/expertises-audit/controle-de-gestion">Voir la fiche</a>
        </article>
        <article class="oling-expertise-index-card oling-expertise-index-card--secondary">
          <div class="oling-expertise-index-card__top">
            <span class="oling-kicker">Finance</span>
            <span class="oling-expertise-index-card__number" aria-hidden="true">↗</span>
          </div>
          <h3>Audit finance</h3>
          <p>Processus financiers, contrôles, données et fiabilisation du pilotage.</p>
          <a class="oling-expertise-index-card__link" href="/expertises-audit/finance">Voir la fiche</a>
        </article>
        <article class="oling-expertise-index-card oling-expertise-index-card--secondary">
          <div class="oling-expertise-index-card__top">
            <span class="oling-kicker">RSE</span>
            <span class="oling-expertise-index-card__number" aria-hidden="true">↗</span>
          </div>
          <h3>Audit RSE</h3>
          <p>Engagements, preuves, conformité et pilotage responsable.</p>
          <a class="oling-expertise-index-card__link" href="/expertises-audit/rse">Voir la fiche</a>
        </article>
      </div>
    </div>
  </section>
  {% endif %}

  {% include 'public/_cta_band.html.twig' with {
    title: page.cta.title,
    text: page.cta.text,
    primaryCta: page.cta.primaryCta
  } %}
</main>
{% endblock %}

{{ form_start(form, {'action':form_action|default(''),'attr':{'id':'service-editor'}}) }}
{% set editingImages=app.request.query.get('section')=='images' %}{% set contentEditor %}<div class="cms-card">{{ form_row(form.designation) }}{% if not service.id %}{{ form_row(form.practice,{'label':'Famille métier'}) }}{% endif %}{{ form_row(form.designationShort) }}{{ form_row(form.introductionShort,{'attr':{'class':'form-control js-wysiwyg'}}) }}{{ form_row(form.descriptionShort,{'attr':{'class':'form-control js-wysiwyg'}}) }}{{ form_row(form.description,{'attr':{'class':'form-control js-wysiwyg'}}) }}</div>{% endset %}{% if not editingImages %}{{ contentEditor|raw }}{% endif %}
<section class="cms-card" id="illustrations"><h2>Image principale & illustrations</h2><div class="cms-media-grid">
{% for field,label in {'image1':'Image principale','image2':'Illustration secondaire','imageHero':'Image du héros (bandeau de la page)'} %}
<div class="admin-media-card p-3"><h3 class="h6">{{ label }}</h3>{% set stored=attribute(service,field) %}{% set current=field=='imageHero' ? (stored ?: service.image1 ?: service.image2) : stored %}{% if current %}<img class="admin-media-preview__img" src="{{ asset(current) }}" alt="{{ label }} actuelle">{% else %}<div class="cms-thumb cms-no-image" aria-label="Aucune image associée">▧</div>{% endif %}{% if field=='imageHero' %}<p class="small text-muted">L’image dédiée est prioritaire sur l’image principale. Aucun format carré ou portrait n’est imposé : l’illustration est conservée entière.</p>{{ form_row(form.imageHeroUseMain) }}{{ form_row(form.imageHeroFile,{'label':'Remplacer l’image du héros (fichier original)','help':'Un nouveau fichier remplace l’image dédiée et prend la priorité sur l’option ci-dessus.','attr':{'class':'form-control'}}) }}{% else %}{{ form_row(attribute(form,field~'File'),{'label':'Remplacer ' ~ label|lower,'attr':{'class':'form-control'}}) }}{% endif %}<details><summary>Adresse de l’image</summary>{{ form_row(attribute(form,field)) }}</details></div>
{% endfor %}</div></section>
{% if editingImages %}<details class="cms-secondary"><summary>Titre & contenu de la prestation</summary>{{ contentEditor|raw }}</details>{% endif %}
<details class="cms-secondary"><summary>SEO/GEO</summary>{% for child in form %}{% if child.vars.name starts with 'seoAdvanced' %}{{ form_row(child) }}{% endif %}{% endfor %}</details>
<details class="cms-secondary"><summary>Traductions</summary><a href="{{ path('admin_translations_index') }}">Ouvrir les traductions existantes</a></details>
<details class="cms-secondary"><summary>Associations & réglages avancés</summary>{% for child in form %}{% if child.vars.name not in ['designation','designationShort','introductionShort','descriptionShort','description','image1','image1File','image2','image2File','imageHero','imageHeroFile','imageHeroUseMain','_token'] and not (child.vars.name starts with 'seoAdvanced') and not (child.vars.name=='practice' and not service.id) %}{% if child.vars.name=='ico' %}            <div class="mb-3">
                {{ form_label(form.ico) }}
                <div class="admin-icon-picker js-icon-picker">
                    <div class="admin-icon-picker__input">
                        {{ form_widget(form.ico, {'attr': {'class': 'form-control js-icon-picker-input'}}) }}
                        <button type="button" class="btn btn-outline-secondary btn-sm js-icon-picker-toggle">Choisir une icône</button>
                    </div>
                    <div class="admin-icon-picker__current">
                        <span class="text-muted">Icône actuelle :</span>
                        <span class="admin-icon-picker__preview js-icon-picker-preview"></span>
                        <span class="admin-icon-picker__label js-icon-picker-label"></span>
                    </div>
                    <div class="admin-icon-picker__panel js-icon-picker-panel">
                        <div class="admin-icon-picker__search">
                            <input type="search" class="form-control js-icon-picker-search" placeholder="Rechercher une icône...">
                            <div class="admin-icon-picker__hint js-icon-picker-hint"></div>
                        </div>
                        <div class="admin-icon-picker__grid js-icon-picker-grid"></div>
                    </div>
                </div>
                {{ form_errors(form.ico) }}
            </div>

{% else %}{{ form_row(child) }}{% endif %}{% endif %}{% endfor %}{% if service.id %}<a href="{{ path('admin_catalogue_relations',{technical:'service',id:service.id}) }}">Gérer les pages associées</a>{% endif %}</details>
<div class="cms-editor-actions"><button class="btn btn-primary">Enregistrer</button>{% if service.practice %}<a class="btn btn-outline-secondary" href="/{{ service.practice.slug }}/{{ service.slug }}" target="_blank" rel="noopener">Voir la page</a>{% endif %}<a href="{{ path('admin_catalogue_index',{type:'service'}) }}">Retour</a></div>
{{ form_end(form) }}

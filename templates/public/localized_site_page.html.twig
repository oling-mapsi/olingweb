{% extends 'base.html.twig' %}

{% block title %}{{ page.title }}{% endblock %}
{% block meta_description %}{{ page.metaDescription ?: page.heroIntro|striptags }}{% endblock %}
{% block canonical_url %}{{ app.request.schemeAndHttpHost ~ canonicalPath }}{% endblock %}

{% block body %}
  <main class="oling-section">
    <div class="container">
      {% if page.heroBadge %}
        <p class="oling-eyebrow">{{ page.heroBadge }}</p>
      {% endif %}
      <h1>{{ page.heroTitle ?: page.title }}</h1>
      {% if page.heroIntro %}
        <div class="lead">{{ page.heroIntro|raw }}</div>
      {% endif %}
      {% if page.bodyHtml %}
        <div class="oling-richtext">{{ page.bodyHtml|raw }}</div>
      {% endif %}
    </div>
  </main>
{% endblock %}

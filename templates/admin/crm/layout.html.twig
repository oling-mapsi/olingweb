<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{% block title %}CRM | OLING{% endblock %}</title><link rel="stylesheet" href="/crm/workspace.css?v=12"><script src="/crm/workspace.js?v=12" defer></script></head><body class="crm-workspace crm-shell">
<a class="skip-link" href="#crm-main">Aller au contenu</a>
<header class="app-header"><div class="topbar">
<a class="brand" href="{{ path('admin_crm') }}" aria-label="OLING — Portefeuille CRM"><img src="/crm/oling-logo.png" width="40" height="40" alt="Oling"></a>
<nav aria-label="Navigation principale">
<details class="portfolio-menu"><summary class="{{ view|default('portfolio')=='portfolio'?'active':'' }}" {% if view|default('portfolio')=='portfolio' %}aria-current="page"{% endif %}>Portefeuille{% if segment|default('') %} · {{ segment=='clients'?'B2B':'B2G' }}{% endif %} <span aria-hidden="true">⌄</span></summary>
<div class="portfolio-options">{% for key,label in {'':'Tous',clients:'B2B',markets:'B2G'} %}<a href="{{ path('admin_crm',{view:'portfolio',segment:key,mode:mode|default('board'),scope:scope|default('active')}) }}" aria-current="{{ view|default('portfolio')=='portfolio' and segment|default('')==key?'page':'false' }}" title="{{ key=='clients'?'Clients hors marchés publics':(key=='markets'?'Marchés publics':'Tous les clients et marchés') }}">{{ label }}</a>{% endfor %}</div></details>
<a class="{{ view|default('portfolio')=='todo'?'active':'' }}" aria-current="{{ view|default('portfolio')=='todo'?'page':'false' }}" href="{{ path('admin_crm',{view:'todo'}) }}">Actions et relances</a>
</nav>
{% block workspace_filters %}{% endblock %}
{% if app.request.host in ['crm.oling.fr','crm.localhost'] %}<form class="session-action" method="post" action="{{ path('admin_crm_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button>Déconnexion</button></form>{% else %}<a class="admin-link" href="{{ path('logout') }}">Déconnexion</a>{% endif %}
</div></header>
<main id="crm-main" class="crm" tabindex="-1">{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}<div id="save-status" class="save-status" role="status" aria-live="polite" hidden></div><div id="save-error" class="alert alert-danger" role="alert" hidden></div>{% block crm %}{% endblock %}</main><footer class="footer"><span>OLING</span>{% include 'admin/crm/_feeds.html.twig' %}</footer></body></html>

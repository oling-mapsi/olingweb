{% extends 'base.html.twig' %}

{% block title %}{{ serviceNarrative.metaTitle ?? (service.designation ~ ' | OLING') }}{% endblock %}
{% block meta_description %}{{ serviceNarrative.metaDescription ?? serviceNarrative.intro|striptags }}{% endblock %}
{% block body_class %} service-detail-page{% endblock %}

{% block body %}
{% set phoneOwnerPaths = [
  '/business-apps/erp',
  '/consulting/reforme-facturation-electronique-amoa',
  '/expertises-audit/rgpd',
  '/expertises-audit/qse',
  '/expertises-audit/si',
  '/expertises-audit/conformite-ia-gouvernance-et-ai-act',
  '/consulting/amoa-ia-pilotage-de-projets-ia-et-agents-metier'
] %}
<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: serviceNarrative.eyebrow,
    title: serviceNarrative.headline,
    intro: serviceNarrative.intro,
    primaryCta: serviceNarrative.showHeroCta is defined and not serviceNarrative.showHeroCta ? null : {route: 'contact', label: 'service.hero.primary_cta'|trans},
    secondaryCta: null,
    highlights: serviceNarrative.outcomes|slice(0, 3)
  } %}

  <section class="oling-shell-section">
    <div class="container">
      <div class="oling-two-col">
        <article class="oling-surface oling-surface--light">
          <span class="oling-kicker">{{ 'service.coverage.kicker'|trans }}</span>
          <h2>{{ serviceNarrative.coverageTitle|default(service.designation) }}</h2>
          {% if serviceNarrative.hideLegacyDescription|default(false) %}
            {% if serviceNarrative.coverageText is defined %}
              <p>{{ serviceNarrative.coverageText }}</p>
            {% endif %}
            {% if serviceNarrative.coverageItems is defined %}
              <ul class="oling-check-list">
                {% for item in serviceNarrative.coverageItems %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          {% else %}
            <div class="oling-richtext">{{ service.description|raw }}</div>
          {% endif %}
        </article>
        <article class="oling-surface oling-surface--light">
          <span class="oling-kicker">{{ 'service.outcomes.kicker'|trans }}</span>
          <h2>{{ 'service.outcomes.title'|trans }}</h2>
          <ul class="oling-check-list">
            {% for item in serviceNarrative.outcomes %}
              <li>{{ item }}</li>
            {% endfor %}
            <li>{{ 'service.outcomes.default_deliverable'|trans }}</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  {% if app.request.pathInfo == '/expertises-audit/si' %}
    {% include 'public/_iso27001_certification_proof.html.twig' with {
      headingId: 'iso27001-certification-owner'
    } %}
  {% endif %}

  {% if serviceNarrative.promise is defined or serviceNarrative.focus is defined %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-two-col">
          {% if serviceNarrative.promise is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">{{ 'service.promise.kicker'|trans }}</span>
              <h2>{{ serviceNarrative.promiseTitle|default('service.promise.default_title'|trans) }}</h2>
              <p>{{ serviceNarrative.promise }}</p>
            </article>
          {% endif %}
          {% if serviceNarrative.focus is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">{{ 'service.focus.kicker'|trans }}</span>
              <h2>{{ serviceNarrative.focusTitle|default('service.focus.default_title'|trans) }}</h2>
              <ul class="oling-check-list">
                {% for item in serviceNarrative.focus %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </article>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if serviceNarrative.missionPhases is defined or serviceNarrative.deliverables is defined %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-two-col">
          {% if serviceNarrative.missionPhases is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">{{ 'service.mission_phases.kicker'|trans }}</span>
              <h2>{{ serviceNarrative.missionPhasesTitle|default('service.mission_phases.default_title'|trans) }}</h2>
              <ul class="oling-check-list">
                {% for item in serviceNarrative.missionPhases %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </article>
          {% endif %}
          {% if serviceNarrative.deliverables is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">{{ 'service.deliverables.kicker'|trans }}</span>
              <h2>{{ serviceNarrative.deliverablesTitle|default('service.deliverables.default_title'|trans) }}</h2>
              <ul class="oling-check-list">
                {% for item in serviceNarrative.deliverables %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </article>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if serviceNarrative.projectContexts is defined or serviceNarrative.clientTypes is defined %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-two-col">
          {% if serviceNarrative.projectContexts is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">{{ 'service.project_contexts.kicker'|trans }}</span>
              <h2>{{ serviceNarrative.projectContextsTitle|default('service.project_contexts.default_title'|trans) }}</h2>
              <ul class="oling-check-list">
                {% for item in serviceNarrative.projectContexts %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </article>
          {% endif %}
          {% if serviceNarrative.clientTypes is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">{{ 'service.client_types.kicker'|trans }}</span>
              <h2>{{ serviceNarrative.clientTypesTitle|default('service.client_types.default_title'|trans) }}</h2>
              <ul class="oling-check-list">
                {% for item in serviceNarrative.clientTypes %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </article>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if serviceNarrative.citablePassages is defined %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'service.citable.kicker'|trans }}</span>
          <h2>{{ serviceNarrative.citablePassagesTitle }}</h2>
        </div>
        <div class="row g-4">
          {% for passage in serviceNarrative.citablePassages %}
            <article class="col-lg-6">
              <h3 class="h5">{{ passage.title }}</h3>
              <p class="mb-0">{{ passage.text }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if serviceNarrative.supportLinks is defined %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'service.support_links.kicker'|trans }}</span>
          <h2>{{ serviceNarrative.supportLinksTitle|default('service.support_links.default_title'|trans) }}</h2>
          <p>{{ serviceNarrative.supportLinksIntro|default('service.support_links.default_intro'|trans) }}</p>
        </div>
        <div class="oling-service-link-grid">
          {% for link in serviceNarrative.supportLinks %}
            <a class="oling-service-link-card" href="{{ link.href }}">
              <span class="oling-kicker">{{ 'service.support_links.card_kicker'|trans }}</span>
              <h3>{{ link.label }}</h3>
              <p>{{ link.description }}</p>
              <span class="oling-service-link-card__more">{{ 'common.view_page'|trans }}</span>
            </a>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if serviceNarrative.anonymousProofs is defined and serviceNarrative.anonymousProofs|length > 0 %}
    {% include 'public/_anonymous_proof_cards.html.twig' with {
      proofs: serviceNarrative.anonymousProofs,
      sectionClass: 'oling-shell-section oling-shell-section--tint',
      title: serviceNarrative.anonymousProofsTitle|default('service.proofs.default_title'|trans),
      intro: serviceNarrative.anonymousProofsIntro|default('service.proofs.default_intro'|trans)
    } %}
  {% elseif service.projets|length > 0 %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'service.related_cases.kicker'|trans }}</span>
          <h2>{{ 'service.related_cases.title'|trans }}</h2>
        </div>
        <div class="oling-project-proof-grid">
          {% for project in service.projets|slice(0, 3) %}
            <article class="oling-proof-card">
              <span class="oling-kicker">{{ project.metier ? project.metier.designation : 'common.project'|trans }}</span>
              <h3>{{ project.designation }}</h3>
              <p>{{ project.description ? project.description|striptags|slice(0, 180) ~ '…' : 'service.related_cases.default_description'|trans }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if service.teams|length > 0 %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'service.experts.kicker'|trans }}</span>
          <h2>{{ 'service.experts.title'|trans }}</h2>
        </div>
        <div class="oling-team-mini-list">
          {% for team in service.teams %}
            <div class="oling-team-mini">
              <img class="oling-team-mini__avatar" src="{{ team.photo ?: asset('img/160x160/img1.jpg') }}" alt="Photo de {{ team.noncomplet }}">
              <div class="oling-team-mini__meta">
                <div class="oling-team-mini__name">{{ team.noncomplet }}</div>
                {% if team.titre %}
                  <div class="oling-team-mini__title">{{ team.titre }}</div>
                {% endif %}
                {% if team.linkedin %}
                  <a class="oling-team-mini__link" href="{{ team.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'team.linkedin'|trans({'%name%': team.noncomplet}) }}">
                    <i class="bi-linkedin" aria-hidden="true"></i>
                  </a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% include 'public/_cta_band.html.twig' with {
    eyebrow: 'service.final_cta.eyebrow'|trans,
    title: serviceNarrative.finalCtaTitle|default('service.final_cta.default_title'|trans),
    text: serviceNarrative.finalCtaText|default('service.final_cta.default_text'|trans),
    primaryCta: {route: 'contact', label: serviceNarrative.finalCtaLabel|default('service.final_cta.default_label'|trans)},
    phoneCta: app.request.pathInfo in phoneOwnerPaths
  } %}
</main>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ (serviceNarrative.schemaName ?? service.designation)|striptags|e('js') }}",
  "serviceType": "{{ (serviceNarrative.schemaServiceType ?? service.practice.designation)|striptags|e('js') }}",
  "provider": {
    "@type": "ProfessionalService",
    "name": "OLING Management et Technologie",
    "url": "https://oling.fr"
  },
  "areaServed": ["France", "Guadeloupe", "Martinique", "Guyane"],
  "url": "{{ site_base_url ~ app.request.pathInfo }}",
  "description": "{{ (serviceNarrative.metaDescription ?? serviceNarrative.intro)|striptags|e('js') }}"
}
</script>
{% endblock %}

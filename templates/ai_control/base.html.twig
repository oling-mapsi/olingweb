<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{% block title %}OLING · Tour de contrôle IA{% endblock %}</title>
<style>
:root{font-family:Inter,system-ui,-apple-system,sans-serif;color:#203448;background:#f5f7fa;font-size:15px}*{box-sizing:border-box}body{margin:0}a{color:#145f93;text-decoration:none}a:hover{text-decoration:underline}header{background:#fff;border-bottom:1px solid #dde5ed;padding:18px 4vw;display:flex;align-items:center;gap:32px;flex-wrap:wrap}.brand{font-size:23px;font-weight:800;letter-spacing:-1px;color:#13334a}.brand span{font-weight:400;color:#64788a;font-size:14px;letter-spacing:0;margin-left:12px}nav{display:flex;gap:8px;flex:1}nav a{padding:10px 14px;color:#516574;border-radius:7px}nav a.active{color:#165d8b;background:#eaf2f8;font-weight:650}main{max-width:1260px;margin:0 auto;padding:36px 24px 60px}h1{font-size:30px;letter-spacing:-.7px;margin:6px 0 10px}h2{font-size:19px;margin:0 0 18px}h3{font-size:16px}p{line-height:1.6}.muted{color:#647587}.eyebrow{text-transform:uppercase;letter-spacing:1.7px;font-size:11px;font-weight:700;color:#648097}.intro{display:flex;justify-content:space-between;gap:24px;align-items:center;margin-bottom:28px}.badge{font-size:12px;display:inline-block;padding:6px 10px;border-radius:6px;background:#edf2f6;color:#456178;white-space:nowrap}.online{background:#e5f4ed;color:#21664a}.offline{background:#fff2db;color:#855a1b}.panel,.metric{background:#fff;border:1px solid #dfe6ed;border-radius:12px;padding:24px;margin-bottom:20px}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.metric strong{display:block;font-size:32px;font-weight:650;margin-top:10px}.grid{display:grid;grid-template-columns:1.5fr 1fr;gap:24px}.stack>*+*{margin-top:16px}label{display:block;font-size:13px;font-weight:650;margin-bottom:8px}input,textarea,select{font:inherit;width:100%;border:1px solid #c9d5df;border-radius:7px;padding:11px;background:#fff;color:#203448}textarea{min-height:150px;resize:vertical}button,.button{font:inherit;cursor:pointer;display:inline-block;background:#175f8c;color:white;border:1px solid #175f8c;border-radius:7px;padding:10px 15px;font-weight:600}button.secondary,.button.secondary{background:white;color:#355770;border-color:#cbd8e2}button.danger{background:white;color:#9c4545;border-color:#e0bdbd}.actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center}form{margin:0}.logout{font-size:12px!important;padding:7px 10px!important}table{width:100%;border-collapse:collapse}th{text-align:left;color:#718296;font-size:11px;letter-spacing:.6px;text-transform:uppercase}td,th{padding:14px 9px;border-bottom:1px solid #edf1f5;vertical-align:top}td small{display:block;margin-top:7px;color:#6a7c8c}.table-wrap{overflow:auto}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.7 ui-monospace,monospace;background:#f7f9fb;padding:15px;border-radius:7px}details{padding:12px 0;border-bottom:1px solid #edf1f5}summary{cursor:pointer;font-weight:600}.empty{padding:25px;color:#738293;text-align:center}.notice{border-left:3px solid #e7bd67;background:#fff8e9;padding:14px 18px;margin:18px 0;line-height:1.6}.login{max-width:440px;margin:8vh auto}.login .panel{padding:36px}.login .brand{margin-bottom:30px}.error{background:#fcebec;color:#943c43;padding:12px;border-radius:6px}.small{font-size:12px}.timeline{list-style:none;padding:0}.timeline li{padding:10px 0;border-bottom:1px solid #edf1f5}.timeline small{color:#718296}footer{color:#778997;font-size:12px;margin-top:30px}@media(max-width:800px){header{gap:12px;padding:16px}nav{order:3;flex:0 0 100%;width:100%;gap:4px;overflow:auto}nav a{padding:10px 8px;font-size:14px}main{padding:24px 16px}.grid{grid-template-columns:1fr}.metrics{gap:8px}.metric{padding:16px}.intro{align-items:flex-start;flex-direction:column}h1{font-size:26px}.brand span{display:none}}
</style></head><body>
{% block shell %}<header><a class="brand" href="{{ path('admin_ai') }}">OLING<span>Tour de contrôle IA</span></a><nav aria-label="Navigation principale">{% for k,label in {home:'Aujourd’hui',missions:'Missions',assets:'Assets',prompts:'Prompts'} %}<a class="{{ view|default('') == k ? 'active' : '' }}" href="{{ path('admin_ai',{view:k}) }}">{{ label }}</a>{% endfor %}</nav><form action="{{ path('admin_ai_logout') }}" method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="secondary logout">Déconnexion</button></form></header><main>{% block body %}{% endblock %}<footer>OLING AI · Missions et preuves privées · Validation humaine avant clôture</footer></main>{% endblock %}</body></html>

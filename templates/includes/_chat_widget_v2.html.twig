<div
  id="oling-chat-widget"
  class="oling-chat-widget"
  data-create-url="{{ path('api_chat_conversation_create') }}"
  data-show-url-template="{{ path('api_chat_conversation_show', {token: 'CHAT_TOKEN'}) }}"
  data-message-url-template="{{ path('api_chat_conversation_message', {token: 'CHAT_TOKEN'}) }}"
  data-lead-url-template="{{ path('api_chat_conversation_lead', {token: 'CHAT_TOKEN'}) }}"
  data-csrf-token="{{ csrf_token('chat_widget') }}"
  data-contact-fallback-url="{{ path('contact', {chat_fallback: 1}) }}"
  data-privacy-url="{{ path('polrgpd') }}"
>
  <button type="button" class="oling-chat-widget__launcher" aria-controls="oling-chat-panel" aria-expanded="false" aria-label="Ouvrir l'assistant OLING">
    <span class="oling-chat-widget__launcher-voice" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    <span class="oling-chat-widget__launcher-core" aria-hidden="true">
      <span class="oling-chat-widget__launcher-dot"></span>
    </span>
    <span class="oling-chat-widget__launcher-label"><strong>Assistant OLING</strong><span>IA experte sur nos expertises et expériences</span></span>
  </button>

  <section id="oling-chat-panel" class="oling-chat-widget__panel" aria-hidden="true">
    <header class="oling-chat-widget__header">
      <div class="oling-chat-widget__header-figure" aria-hidden="true">
        <span class="oling-chat-widget__header-avatar">
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path d="M12 12.2a3.2 3.2 0 1 0-3.2-3.2 3.2 3.2 0 0 0 3.2 3.2Zm-6.1 6.3a5.7 5.7 0 0 1 12.2 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            <path d="M17.4 12.8a2.4 2.4 0 1 0-1.9-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M18.9 18.2a4.6 4.6 0 0 0-2.5-3.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
      </div>
      <div class="oling-chat-widget__header-copy">
        <span class="oling-chat-widget__header-kicker text-white">Assistant expert OLING</span>
      </div>
      <button type="button" class="oling-chat-widget__close" aria-label="Fermer le chat" title="Fermer">
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="oling-chat-widget__body">
      <div class="oling-chat-widget__summary d-none" data-chat-summary></div>

      <div class="oling-chat-widget__messages" data-chat-messages></div>

      <div class="oling-chat-widget__lead d-none" data-chat-lead>
        <div class="oling-chat-widget__lead-head">
          <div class="oling-chat-widget__lead-title">Coordonnées de contact</div>
          <p>Ces informations servent uniquement à transmettre une synthèse exploitable à un consultant OLING.</p>
        </div>
        <div class="row g-2">
          <div class="col-12">
            <label class="oling-chat-widget__field-label" for="chatFullName">
              Nom et prénom <span class="oling-chat-widget__field-required" aria-hidden="true">*</span>
            </label>
            <input type="text" class="form-control" id="chatFullName" name="chatFullName" placeholder="Nom et prénom" required>
          </div>
          <div class="col-12">
            <label class="oling-chat-widget__field-label" for="chatEmail">
              Email professionnel <span class="oling-chat-widget__field-required" aria-hidden="true">*</span>
            </label>
            <input type="email" class="form-control" id="chatEmail" name="chatEmail" placeholder="Email professionnel" required>
          </div>
          <div class="col-12">
            <label class="oling-chat-widget__field-label" for="chatPhone">Téléphone</label>
            <input type="text" class="form-control" id="chatPhone" name="chatPhone" placeholder="Téléphone">
          </div>
          <div class="col-12">
            <label class="oling-chat-widget__field-label" for="chatCompany">
              Société <span class="oling-chat-widget__field-required" aria-hidden="true">*</span>
            </label>
            <input type="text" class="form-control" id="chatCompany" name="chatCompany" placeholder="Société" required>
          </div>
          <div class="col-12">
            <label class="oling-chat-widget__field-label" for="chatNeedDescription">
              Description synthétique du besoin <span class="oling-chat-widget__field-required" aria-hidden="true">*</span>
            </label>
            <textarea class="form-control" id="chatNeedDescription" name="chatNeedDescription" rows="4" placeholder="Description synthétique du besoin" required></textarea>
          </div>
          <div class="col-12">
            <label class="oling-chat-widget__consent">
              <input type="checkbox" name="chatConsent">
              <span>J’accepte que les informations transmises soient utilisées par OLING pour traiter ma demande de contact. <a href="{{ path('polrgpd') }}" target="_blank" rel="noopener" data-chat-bypass="true">Politique RGPD</a></span>
            </label>
          </div>
          <div class="col-12">
            <button type="button" class="btn btn-primary w-100" data-chat-submit-lead>Transmettre la demande</button>
          </div>
        </div>
      </div>

      <div class="oling-chat-widget__error d-none" data-chat-error></div>
      <div class="oling-chat-widget__statusline d-none" data-chat-status></div>
    </div>

    <form class="oling-chat-widget__composer" data-chat-composer>
      <div class="oling-chat-widget__composer-shell">
        <textarea class="form-control" rows="3" placeholder="Décrivez votre contexte, enjeu ou blocage..." name="chatMessage"></textarea>
        <p class="oling-chat-widget__composer-note">Réponse générée par l’IA à partir des contenus publics OLING.</p>
        <div class="oling-chat-widget__composer-bar">
          <div class="oling-chat-widget__composer-tools">
            <a href="{{ path('contact', {chat_fallback: 1}) }}" class="oling-chat-widget__aux" data-chat-bypass="true" data-label="Contact" aria-label="Contact" title="Contact">
              <span class="oling-chat-widget__aux-icon oling-chat-widget__aux-icon--contact" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                  <path d="M4 7.5h16v9H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="m5 8 7 5 7-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
            <button type="button" class="oling-chat-widget__aux oling-chat-widget__aux-button d-none" data-chat-reset data-label="Réinitialiser le chat" aria-label="Réinitialiser le chat" title="Réinitialiser le chat">
              <span class="oling-chat-widget__aux-icon oling-chat-widget__aux-icon--reset" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                  <path d="M20 11a8 8 0 1 1-2.34-5.66" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                  <path d="M20 4v6h-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>
          </div>
          <button type="submit" class="oling-chat-widget__send" aria-label="Envoyer" title="Envoyer">
            <span aria-hidden="true">➜</span>
          </button>
        </div>
      </div>
    </form>
  </section>
</div>

{% extends 'base.html.twig' %}

{% block title %}Article Growth | Admin{% endblock %}
{% block meta_description %}Edition article Growth{% endblock %}
{% block stylesheets %}{{ parent() }}<style>.growth-editor{min-height:320px;max-height:680px;overflow:auto;overflow-wrap:anywhere}.growth-editor img,.growth-article-preview img{max-width:100%;height:auto}.growth-editor h2{font-size:1.25rem}.growth-editor h3{font-size:1.1rem}</style>{% endblock %}

{% block body %}
<main id="content" role="main" class="admin">
  <div class="container content-space-2 content-space-lg-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
      <div>
        <h1 class="h3 mb-1">{{ campaign.name|default('Article') }}</h1>
        {% if campaign %}
          <p class="text-muted mb-0">{{ campaign.status }} · {{ campaign.selected_channels|join(', ') }}</p>
          {% if campaign.generation|default(null) %}
            <p class="small text-muted mb-0">{{ campaign.generation.status|default('') in ['PENDING', 'RUNNING'] ? 'Creation des articles en cours' : 'Articles sauvegardes' }}</p>
          {% endif %}
        {% endif %}
      </div>
      <a class="btn btn-outline-primary btn-sm" href="{{ path('admin_growth_index') }}#articles">Retour aux articles</a>
    </div>

    {% include 'admin/_nav.html.twig' %}

    {% for label,messages in app.flashes %}
      {% for message in messages %}
        <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }}">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    {% if not available or not campaign %}
      <div class="alert alert-warning">Growth indisponible : {{ message }}</div>
    {% else %}
      <div class="d-flex flex-wrap gap-2 mb-4">
        <form method="post" action="{{ path('admin_growth_generate', {id: campaign.id}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('growth_generate_' ~ campaign.id) }}">
          <button class="btn btn-outline-primary">Ameliorer avec l'IA</button>
        </form>
        <form method="post" action="{{ path('admin_growth_archive', {id: campaign.id}) }}" onsubmit="return confirm('Archiver cet article ?');">
          <input type="hidden" name="_token" value="{{ csrf_token('growth_archive_' ~ campaign.id) }}">
          <button class="btn btn-outline-secondary">Archiver</button>
        </form>
        <form method="post" action="{{ path('admin_growth_delete', {id: campaign.id}) }}" onsubmit="return confirm('Supprimer cet article jamais publie ?');">
          <input type="hidden" name="_token" value="{{ csrf_token('growth_delete_' ~ campaign.id) }}">
          <button class="btn btn-outline-danger">Supprimer</button>
        </form>
      </div>

      <div class="alert alert-info" id="growth-generation-status" data-status-url="{{ path('admin_growth_status', {id: campaign.id}) }}">
        {% if campaign.generation.status|default('') in ['PENDING', 'RUNNING'] %}
          Creation de vos articles en cours.
        {% elseif campaign.generation|default(null) and campaign.generation.status|default('') == 'FAILED' %}
          {{ campaign.generation.error_message|default('Generation suspendue. Relance possible apres correction.') }}
        {% else %}
          Brief original conserve dans Growth Factory. Relire chaque version, verifier les liens internes et approuver avant publication.
        {% endif %}
      </div>
      <form id="growth-batch-publish" method="post" action="{{ path('admin_growth_publish_selected', {id: campaign.id}) }}" class="mb-3" onsubmit="const selected = [...this.elements].filter(el => el.name === 'asset_ids[]' &amp;&amp; el.checked); return selected.length &gt; 0 &amp;&amp; confirm(selected.map(el => el.dataset.confirmation).join('\n\n'));">
        <input type="hidden" name="_token" value="{{ csrf_token('growth_publish_selected_' ~ campaign.id) }}">
        <button class="btn btn-outline-primary">Publier les articles selectionnes</button>
      </form>

      {% block articles %}
      <div class="row g-4" id="growth-articles">
        {% for channel in campaign.selected_channels %}
          {% set channel_assets = campaign.assets_by_channel_list[channel]|default([]) %}
          {% if channel_assets is empty %}
            {% set channel_assets = [null] %}
          {% endif %}
          {% for asset in channel_assets %}
          {% set image = asset.image|default({}) %}
          {% set seo = asset.seo_geo|default({}) %}
          {% set links = seo.internal_links|default([]) %}
          <div class="col-lg-6" data-article-key="{{ asset.id|default(channel ~ '_pending') }}">
            <section class="card h-100">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                  <div>
                    <h2 class="h5 mb-1">{{ channel_options[channel]|default(channel) }}{% if asset and asset.locale|default('fr-FR') != 'fr-FR' %} · {{ asset.locale }}{% elseif channel == 'oling_site' and asset %} · FR{% endif %}</h2>
                    <span class="badge bg-secondary">{{ asset.status|default('A generer') }}</span>
                  </div>
                  {% if asset %}<span class="small text-muted">v{{ asset.version }}</span>{% endif %}
                </div>
                {% if asset %}
                  <h3 class="h5">{{ asset.title }}</h3>
                  <p class="small text-muted">{{ asset.excerpt|default('') }}</p>
                  <form method="post" action="{{ path('admin_growth_asset_update', {id: campaign.id, assetId: asset.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('growth_asset_' ~ campaign.id ~ '_' ~ asset.id) }}">
                    <input type="hidden" name="expected_version" value="{{ asset.version }}">
                    <div class="mb-3">
                      <label class="form-label">Titre / H1</label>
                      <input class="form-control" name="title" value="{{ asset.title }}">
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Article</label>
                      <div class="btn-group mb-2" role="toolbar" aria-label="Mise en forme">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-growth-command="bold" title="Gras"><strong>B</strong></button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-growth-command="italic" title="Italique"><em>I</em></button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-growth-command="formatBlock" data-value="h2" title="Intertitre">H2</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-growth-command="insertUnorderedList" title="Liste">Liste</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-growth-command="createLink" title="Lien">Lien</button>
                      </div>
                      <div class="form-control growth-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Contenu de l'article">{{ asset.editable_html|raw }}</div>
                      <input type="hidden" name="content_text" value="{{ asset.content_text }}">
                      <input type="hidden" name="content_html" value="{{ asset.content_html }}">
                    </div>
                    {% if image.data_url|default('') %}
                      <div class="border rounded p-3 mb-3">
                        <strong>Illustration retenue</strong>
                        <img class="img-fluid rounded mt-2" src="{{ path('admin_growth_asset_image_binary', {id: campaign.id, assetId: asset.id}) }}" alt="{{ image.alt_text|default('Illustration article') }}">
                        <div class="small text-muted mt-2">{{ image.alt_text|default('') }} · {{ image.model|default('') }}</div>
                      </div>
                    {% elseif image.image_url|default('') %}
                      <div class="border rounded p-3 mb-3">
                        <strong>Illustration retenue</strong>
                        <img class="img-fluid rounded mt-2" src="{{ path('admin_growth_asset_image_binary', {id: campaign.id, assetId: asset.id}) }}" alt="{{ image.alt_text|default('Illustration article') }}">
                        <div class="small text-muted mt-2">{{ image.alt_text|default('') }} · {{ image.model|default('') }}</div>
                      </div>
                    {% endif %}
                    {% if image.image_url|default('') %}
                      <label class="form-label" for="image-position-{{ asset.id }}">Emplacement de l'illustration</label>
                      <select class="form-select mb-3" name="image_placement" id="image-position-{{ asset.id }}">
                        {% for value, label in {'after_intro': "Apres l'introduction", 'after_heading': 'Apres le premier intertitre', 'end': "Fin de l'article"} %}
                          <option value="{{ value }}" {{ image.placement|default('after_intro') == value ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                      </select>
                    {% endif %}
                    {% set seo_ready = seo.status|default('') == 'READY' %}
                    <div class="border rounded p-3 mb-3">
                      <div class="d-flex justify-content-between gap-2">
                        <strong>Referencement : {{ seo.status|default('Corrections necessaires') == 'READY' ? 'Pret' : 'Corrections necessaires' }}</strong>
                        <span class="badge {{ seo_ready ? 'bg-success' : 'bg-warning text-dark' }}">{{ seo.status|default('A verifier') }}</span>
                      </div>
                      {% if seo.checks|default([]) %}
                        <ul class="small mt-2 mb-0">
                          {% for check in seo.checks %}
                            <li>{{ check.passed ? 'OK' : 'A corriger' }} - {{ check.label }}</li>
                          {% endfor %}
                        </ul>
                      {% else %}
                        <div class="small text-muted mt-2">Lancez le controle SEO/GEO pour enregistrer les metadonnees et le maillage.</div>
                      {% endif %}
                    </div>
                    <div class="border rounded p-3 mb-3">
                      <strong>Liens internes proposes</strong>
                      <ul class="mb-0 mt-2">
                        {% for link in links %}
                          <li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.anchor|default(link.label) }}</a><div class="small text-muted">{{ link.url }}{% if link.reason|default('') %} · {{ link.reason }}{% endif %}{% if link.verification|default('') == 'verified' %} · Verifie{% endif %}</div></li>
                        {% else %}
                          <li class="text-muted">Aucun lien disponible pour ce canal.</li>
                        {% endfor %}
                      </ul>
                    </div>
                    {% if asset.illustration_suggestion|default('') %}
                      <div class="border rounded p-3 mb-3">
                        <strong>Brief illustration</strong>
                        <p class="small text-muted mb-0">{{ asset.illustration_suggestion }}</p>
                      </div>
                    {% endif %}
                    {% set quality = asset.editorial_quality|default({}) %}
                    {% if quality %}
                      <div class="border rounded p-3 mb-3">
                        <strong>Qualite editoriale : {{ quality.passed|default(false) ? (quality.issues|default([]) ? 'conforme avec recommandations' : 'conforme') : 'corrections necessaires' }}</strong>
                        {% if quality.issues|default([]) %}
                          <ul class="small mt-2 mb-0">
                            {% for issue in asset.quality_issues|default(quality.issues) %}
                              <li>{{ issue.label|default(issue.message|default('Controle editorial')) }}{% if issue.count|default(1) > 1 %} ({{ issue.count }} affirmations){% endif %}</li>
                            {% endfor %}
                          </ul>
                          <details class="small mt-2"><summary>Anomalies detaillees</summary><ul>{% for issue in quality.issues %}<li>{{ issue.message|default(issue.code|default('Controle editorial')) }}</li>{% endfor %}</ul></details>
                        {% endif %}
                      </div>
                    {% endif %}
                    {% if asset.sources|default([]) or asset.claims|default([]) %}
                      <details class="mb-3 small"><summary>Sources et affirmations du dernier controle</summary>
                        {% for source in asset.sources|default([]) %}<p class="mt-2 mb-1"><strong>{{ source.label }}</strong> · {{ source.source_id }}<br>{{ source.summary }}</p>{% endfor %}
                        <ul>{% for claim in asset.claims|default([]) %}<li>{{ claim.text }} · {{ claim.source_ids|default([])|join(', ') ?: 'Source manquante' }} · {{ claim.verified|default(false) ? 'Etayee lors du controle' : 'A verifier' }}</li>{% endfor %}</ul>
                      </details>
                    {% endif %}
                    {% if asset.public_url|default('') %}
                      <p class="small text-muted">{{ asset.status == 'PUBLISHED' ? 'URL publique' : 'URL prevue' }} : <a href="{{ asset.public_url }}" rel="noopener" target="_blank">{{ asset.public_url }}</a></p>
                    {% endif %}
                    {% set locale_label = {'fr-FR': 'FR', 'en-US': 'EN', 'es-ES': 'ES'}[asset.locale|default('fr-FR')]|default(asset.locale|default('FR')) %}
                    {% set site_label = channel == 'mapsi_site' ? 'MAPSI.fr' : 'OLING.fr' %}
                    {% set readiness = publication_readiness[asset.id]|default({}) %}
                    {% set readiness_reasons = readiness.reasons|default([]) %}
                    {% set can_publish = readiness.publishable|default(false) and asset.status|default('') == 'APPROVED' and not asset.quality_blocking|default(false) %}
                    {% set public_url = asset.public_url|default(readiness.public_url|default('')) %}
                    {% if can_publish %}
                      <input type="hidden" name="expected_versions[{{ asset.id }}]" value="{{ asset.version }}" form="growth-batch-publish">
                      <input type="hidden" name="approved_hashes[{{ asset.id }}]" value="{{ asset.approved_content_hash|default('') }}" form="growth-batch-publish">
                      <label class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="asset_ids[]" value="{{ asset.id }}" form="growth-batch-publish" data-confirmation="{{ site_label }} · {{ locale_label }} · {{ asset.title }} · v{{ asset.version }} · URL prevue : {{ public_url ?: seo.metadata.canonical|default('A confirmer par le site') }} · Illustration : {{ image.image_url|default('') ? 'oui' : 'non' }} · Qualite conforme · SEO : {{ seo.status|default('A verifier') }}">
                        <span class="form-check-label">Selectionner cet article approuve</span>
                      </label>
                    {% endif %}
                    <div class="d-flex flex-wrap gap-2">
                      <button class="btn btn-outline-primary btn-sm">Enregistrer le brouillon</button>
                      <a class="btn btn-outline-secondary btn-sm" href="{{ path('admin_growth_asset_preview', {id: campaign.id, assetId: asset.id}) }}" target="_blank" rel="noopener">Preview</a>
                    </div>
                  </form>
                  <div class="d-flex flex-wrap gap-2 mt-2">
                    <form method="post" action="{{ path('admin_growth_asset_image', {id: campaign.id, assetId: asset.id}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('growth_image_' ~ campaign.id ~ '_' ~ asset.id) }}">
                      <input type="hidden" name="expected_version" value="{{ asset.version }}">
                      <input type="hidden" name="visual_brief" value="{{ asset.illustration_suggestion|default('') }}">
                      <button class="btn btn-outline-secondary btn-sm">Generer une illustration</button>
                    </form>
                    <form method="post" action="{{ path('admin_growth_asset_repair', {id: campaign.id, assetId: asset.id}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('growth_repair_' ~ campaign.id ~ '_' ~ asset.id) }}">
                      <input type="hidden" name="expected_version" value="{{ asset.version }}">
                      <button class="btn btn-outline-primary btn-sm">Corriger avec l'IA</button>
                    </form>
                    <form method="post" action="{{ path('admin_growth_asset_seo_geo', {id: campaign.id, assetId: asset.id}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('growth_seo_geo_' ~ campaign.id ~ '_' ~ asset.id) }}">
                      <input type="hidden" name="expected_version" value="{{ asset.version }}">
                      <button class="btn btn-outline-primary btn-sm">Verifier SEO/GEO</button>
                    </form>
                    <form method="post" action="{{ path('admin_growth_asset_review', {id: campaign.id, assetId: asset.id}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('growth_review_' ~ campaign.id ~ '_' ~ asset.id) }}">
                      <input type="hidden" name="expected_version" value="{{ asset.version }}">
                      <button class="btn btn-outline-secondary btn-sm">Valider la revue</button>
                    </form>
                    <form method="post" action="{{ path('admin_growth_asset_approve', {id: campaign.id, assetId: asset.id}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('growth_approve_' ~ campaign.id ~ '_' ~ asset.id) }}">
                      <input type="hidden" name="expected_version" value="{{ asset.version }}">
                      <button class="btn btn-success btn-sm" {% if asset.quality_blocking|default(false) %}disabled{% endif %}>Approuver</button>
                    </form>
                    {% if asset.status|default('') == 'PUBLISHED' %}
                      <a class="btn btn-success btn-sm{% if not public_url %} disabled{% endif %}" href="{{ public_url ?: '#' }}" target="_blank" rel="noopener">Publié</a>
                      <form method="post" action="{{ path('admin_growth_asset_unpublish', {id: campaign.id, assetId: asset.id}) }}" onsubmit="return confirm('Dépublier cet article de {{ site_label|e('js') }} en {{ locale_label|e('js') }} : {{ asset.title|e('js') }} ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('growth_unpublish_asset_' ~ campaign.id ~ '_' ~ asset.id) }}">
                        <button class="btn btn-outline-danger btn-sm">Dépublier</button>
                      </form>
                    {% else %}
                      <form method="post" action="{{ path('admin_growth_asset_publish', {id: campaign.id, assetId: asset.id}) }}" onsubmit="return confirm('Publier cet article sur {{ site_label|e('js') }} en {{ locale_label|e('js') }} : {{ asset.title|e('js') }}{% if public_url %} ({{ public_url|e('js') }}){% endif %} ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('growth_publish_asset_' ~ campaign.id ~ '_' ~ asset.id) }}">
                        <input type="hidden" name="expected_version" value="{{ asset.version }}">
                        <input type="hidden" name="approved_content_hash" value="{{ asset.approved_content_hash|default('') }}">
                        <button class="btn btn-primary btn-sm" {% if not can_publish %}disabled{% endif %}>Publier cet article</button>
                      </form>
                    {% endif %}
                  </div>
                  {% if readiness_reasons %}
                    <p class="small text-muted mt-2 mb-0">{{ readiness_reasons|join(' ') }}</p>
                  {% endif %}
                  {% if asset.quality_blocking|default(false) %}<p class="small text-danger mt-2">Approbation impossible : corrigez les anomalies editoriales bloquantes.</p>{% endif %}
                {% else %}
                  <p class="text-muted mb-0">Aucun contenu recu pour ce site.</p>
                {% endif %}
              </div>
            </section>
          </div>
          {% endfor %}
        {% endfor %}
      </div>
      {% endblock %}
    {% endif %}
  </div>
</main>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener('mousedown', event => { if (event.target.closest('[data-growth-command]')) event.preventDefault(); });
    document.addEventListener('click', event => {
      const button = event.target.closest('[data-growth-command]');
      if (!button) return;
      const command = button.dataset.growthCommand;
      let value = button.dataset.value || null;
      if (command === 'createLink') {
        value = prompt('URL du lien');
        if (!value || !/^(https?:\/\/|\/[^\/])/i.test(value)) return;
      }
      document.execCommand(command, false, value);
    });
    document.addEventListener('paste', event => {
      if (!event.target.closest('.growth-editor')) return;
      event.preventDefault();
      document.execCommand('insertText', false, event.clipboardData.getData('text/plain'));
    });
    document.addEventListener('submit', event => {
      const form = event.target;
      const editor = form.querySelector('.growth-editor');
      if (!editor) return;
      const content = editor.cloneNode(true);
      for (const image of content.querySelectorAll('img')) {
        const match = image.getAttribute('src')?.match(/^\/admin\/growth\/campaigns\/[^/]+\/assets\/([^/]+)\/image$/);
        if (match) image.setAttribute('src', '/studio-simple/assets/'+match[1]+'/image');
      }
      for (const div of content.querySelectorAll('div')) {
        const paragraph = document.createElement('p');
        paragraph.append(...div.childNodes);
        div.replaceWith(paragraph);
      }
      form.elements.content_html.value = content.innerHTML;
      form.elements.content_text.value = editor.innerText;
    });
  </script>
  {% if campaign.generation.status|default('') in ['PENDING', 'RUNNING'] %}
    <script>
      (() => {
        const node = document.getElementById('growth-generation-status');
        if (!node || !node.dataset.statusUrl) return;
        const labels = {'fr-FR': 'FR', 'en-US': 'EN', 'es-ES': 'ES'};
        const stages = {WAITING: 'Analyse du brief', DRAFTING: "Redaction de l'article", REWRITING: 'Revision editoriale', QUALITY_CHECK: 'Verification des sources', ILLUSTRATION: "Creation de l'illustration", SAVING: "Enregistrement de l'article", READY_FOR_REVIEW: 'Article disponible', FAILED: 'Generation suspendue'};
        document.addEventListener('input', (event) => {
          const card = event.target.closest('[data-article-key]');
          if (card) card.dataset.dirty = 'true';
        });
        const refreshArticles = async () => {
          const url = new URL(window.location.href);
          url.searchParams.set('fragment', 'articles');
          const response = await fetch(url, {headers: {'Accept': 'text/html'}});
          if (!response.ok || response.redirected) return;
          const documentPart = new DOMParser().parseFromString(await response.text(), 'text/html');
          const incoming = documentPart.getElementById('growth-articles');
          const current = document.getElementById('growth-articles');
          if (!incoming || !current) return;
          const oldCards = new Map([...current.children].map(card => [card.dataset.articleKey, card]));
          for (const fresh of [...incoming.children]) {
            const old = oldCards.get(fresh.dataset.articleKey);
            oldCards.delete(fresh.dataset.articleKey);
            if (old && (old.dataset.dirty || old.contains(document.activeElement))) continue;
            if (old) old.replaceWith(fresh); else current.append(fresh);
          }
          for (const old of oldCards.values()) if (!old.dataset.dirty) old.remove();
        };
        const poll = async () => {
          try {
            const response = await fetch(node.dataset.statusUrl, {headers: {'Accept': 'application/json'}});
            const data = await response.json();
            if (!data.available) {
              node.textContent = data.message || 'Growth Factory indisponible.';
              window.setTimeout(poll, 10000);
              return;
            }
            const assets = Array.isArray(data.assets) ? data.assets : [];
            const done = assets.map((asset) => `${asset.channel === 'oling_site' ? 'OLING' : 'MAPSI'} ${labels[asset.locale] || asset.locale}: article disponible`).join(' · ');
            const parts = (data.generation?.stage || 'WAITING').split(':');
            const stage = parts.at(-1);
            const active = parts.length === 3 ? `${parts[0] === 'oling_site' ? 'OLING' : 'MAPSI'} ${labels[parts[1]] || parts[1]} : ` : '';
            const expected = (data.channels || []).flatMap(channel => channel === 'oling_site' ? ['fr-FR','en-US','es-ES'].map(locale => ({channel,locale})) : channel === 'mapsi_site' ? [{channel,locale:'fr-FR'}] : []);
            const languages = expected.map(item => {
              const ready = assets.some(asset => asset.channel === item.channel && asset.locale === item.locale);
              const running = parts[0] === item.channel && parts[1] === item.locale;
              return `${item.channel === 'oling_site' ? 'OLING' : 'MAPSI'} ${labels[item.locale]} : ${ready ? 'article disponible' : running ? stages[stage] || stage : 'en attente'}`;
            }).join(' · ');
            const activity = data.generation?.updated_at ? ` · Derniere activite : ${new Date(data.generation.updated_at).toLocaleTimeString('fr-FR')}` : '';
            node.textContent = `${active}${stages[stage] || 'Creation des articles en cours'}. ${languages || done}${activity}`;
            if (data.generation?.status === 'FAILED') node.textContent = `${data.generation.error_message || 'Generation suspendue.'} ${languages || done}${activity}`;
            await refreshArticles();
            if (['PENDING', 'RUNNING'].includes(data.generation?.status)) window.setTimeout(poll, 5000);
          } catch (e) {
            window.setTimeout(poll, 10000);
          }
        };
        window.setTimeout(poll, 3000);
      })();
    </script>
  {% endif %}
{% endblock %}

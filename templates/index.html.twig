{% extends 'base.html.twig' %}

{% block title %}{{ homePage.seoTitle }}{% endblock %}
{% block meta_description %}{{ homePage.metaDescription }}{% endblock %}

{% block body %}
<main id="content" role="main" class="oling-home-radical">
  <section class="oling-home-hero">
    <div class="container">
      {% set defaultHeroMetier = homeHeroMetiers[0] ?? null %}
      <div class="oling-home-hero__grid">
        <div class="oling-home-hero__copy">
          {% set heroEyebrow = homePage.hero.eyebrow|default('')|striptags|trim %}
          {% if heroEyebrow and 'iso 27001' not in heroEyebrow|lower %}
            <div class="oling-home-hero__meta">
              <span class="oling-home-hero__eyebrow">{{ heroEyebrow }}</span>
            </div>
          {% endif %}
          <h1>
            {% for line in homePage.hero.titleLines %}
              <span>{{ line }}</span>
            {% endfor %}
          </h1>
          <p>{{ homePage.hero.intro }}</p>
          <div class="oling-home-hero__actions">
            {% set secondaryHeroCta = homePage.hero.secondaryCta|default({}) %}
            {% set secondaryHeroHref = secondaryHeroCta.url|default(secondaryHeroCta.route is defined ? path(secondaryHeroCta.route, secondaryHeroCta.routeParams|default({})) : '#') %}
            <a class="btn btn-primary" href="{{ secondaryHeroHref }}">{{ secondaryHeroCta.label|default('Voir les expertises') }}</a>
          </div>
          <div class="oling-home-hero__tags">
            {% for tag in homePage.hero.tags %}
              <span>{{ tag }}</span>
            {% endfor %}
          </div>
        </div>

        <div class="oling-home-hero__visuals">
          <article class="oling-home-hero-card oling-home-hero-card--portrait">
            {% set heroPortrait = defaultHeroMetier ? defaultHeroMetier.image : homePage.hero.portraitImage %}
            {% set heroPortraitAlt = defaultHeroMetier ? defaultHeroMetier.designation : homePage.hero.portraitAlt %}
            <img
              data-home-hero-image
              src="{{ heroPortrait starts with 'http://' or heroPortrait starts with 'https://' or heroPortrait starts with '/' ? heroPortrait : asset(heroPortrait) }}"
              alt="{{ heroPortraitAlt }}"
            >
          </article>
          <article class="oling-home-hero-card oling-home-hero-card--statement">
            <span>{{ homePage.hero.statement.eyebrow }}</span>
            <strong>{{ homePage.hero.statement.title }}</strong>
            <p>{{ homePage.hero.statement.text }}</p>
          </article>
          <article
            class="oling-home-hero-card oling-home-hero-card--signal"
            data-home-hero-rotator
            data-home-hero-metiers="{{ homeHeroMetiers|json_encode|e('html_attr') }}"
          >
            <span>{{ homePage.hero.signal.eyebrow }}</span>
            <strong data-home-hero-text1>{{ defaultHeroMetier ? defaultHeroMetier.text1 : homePage.hero.signal.title }}</strong>
            <p data-home-hero-text2>{{ defaultHeroMetier and defaultHeroMetier.text2 ? defaultHeroMetier.text2 : (homePage.hero.signal.text is defined ? homePage.hero.signal.text : '') }}</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="oling-home-kpis">
    <div class="container">
      {% if homePage.kpisSection is defined %}
      <div class="oling-home-section-head">
        <span>{{ homePage.kpisSection.eyebrow }}</span>
        <div>
          <h2>{{ homePage.kpisSection.title }}</h2>
        </div>
      </div>
      {% endif %}

      <div class="oling-home-kpis__grid">
        {% for item in homePage.kpis %}
          <article class="oling-home-kpi oling-home-kpi--{{ item.variant }}">
            {% if item.variant == 'image' %}
              {% set kpiImage = item.image %}
              <img src="{{ kpiImage starts with 'http://' or kpiImage starts with 'https://' or kpiImage starts with '/' ? kpiImage : asset(kpiImage) }}" alt="{{ item.alt|default('Illustration') }}">
            {% else %}
              <strong>{{ item.label }}</strong>
              <span>{{ item.text }}</span>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="oling-home-expertises">
    <div class="container">
      {% set practicesEyebrow = homePracticesSection and homePracticesSection.eyebrow ? homePracticesSection.eyebrow : homePage.practices.eyebrow %}
      {% set practicesTitle = homePracticesSection and homePracticesSection.title ? homePracticesSection.title : homePage.practices.title %}
      {% set practicesIntro = homePracticesSection and homePracticesSection.intro ? homePracticesSection.intro : null %}
      {% set leadPractice = homePractices[0] ?? null %}
      <div class="oling-home-section-head">
        <span>{{ practicesEyebrow }}</span>
        <div>
          <h2>{{ practicesTitle }}</h2>
          {% if practicesIntro %}
            <p>{{ practicesIntro|raw }}</p>
          {% endif %}
        </div>
      </div>

      <div class="oling-home-expertises__stack">
        {% if leadPractice %}
        <a class="oling-home-panel oling-home-panel--wide oling-home-panel--dark" href="{{ path('practice_home', {slug: leadPractice.slug}) }}">
          <div class="oling-home-panel__media">
            {% set leadImage = leadPractice.image1 ?: leadPractice.image2 %}
            {% if leadImage %}
              <img src="{{ asset(leadImage) }}" alt="{{ leadPractice.designation }}">
            {% endif %}
          </div>
          <div class="oling-home-panel__body">
            <span>{{ '%02d'|format(1) }}</span>
            <h3>{{ leadPractice.designation }}</h3>
            <p>{{ leadPractice.introductionShort ?: leadPractice.introduction ?: leadPractice.descriptionShort ?: '' }}</p>
          </div>
        </a>
        {% endif %}

        <div class="oling-home-panel-grid">
          {% for practice in homePractices|slice(1) %}
            {% set cardVariant = loop.last ? 'image' : (loop.index is even ? 'blue' : 'pink') %}
            <a class="oling-home-panel oling-home-panel--{{ cardVariant }}" href="{{ path('practice_home', {slug: practice.slug}) }}">
              {% if cardVariant == 'image' %}
                <div class="oling-home-panel__media">
                  {% set panelImage = practice.image1 ?: practice.image2 %}
                  {% if panelImage %}
                    <img src="{{ asset(panelImage) }}" alt="{{ practice.designation }}">
                  {% endif %}
                </div>
              {% endif %}
              <div class="oling-home-panel__body">
                <span>{{ '%02d'|format(loop.index + 1) }}</span>
                <h3>{{ practice.designation }}</h3>
                <p>{{ practice.introductionShort ?: practice.introduction ?: practice.descriptionShort ?: '' }}</p>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <section class="oling-home-support oling-home-support--accompaniments">
    <div class="container">
      <div class="oling-home-section-head">
        <span>{{ homePage.accompaniments.eyebrow }}</span>
        <div>
          <h2>{{ homePage.accompaniments.title }}</h2>
        </div>
      </div>

      <div class="oling-home-list-grid">
        {% for item in homePage.accompaniments.items|default([]) %}
          {% set itemHref = item.url|default(item.route is defined ? path(item.route, item.routeParams|default({})) : '#') %}
          <a class="oling-home-list-card" href="{{ itemHref }}">
            <h3>{{ item.title }}</h3>
            <p>{{ item.text }}</p>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="oling-home-proof">
    <div class="container">
      <div class="oling-home-proof__grid">
        <div class="oling-home-proof__copy">
          <span>{{ homePage.proof.eyebrow }}</span>
          <h2>{{ homePage.proof.title }}</h2>
          <div class="oling-home-proof__list">
            {% for item in homePage.proof.items|slice(0, 3) %}
              <article>
                <h3>{{ item.title }}</h3>
                <p>{{ item.text }}</p>
              </article>
            {% endfor %}
          </div>
        </div>
        <div class="oling-home-proof__visuals">
          <article class="oling-home-proof-tile oling-home-proof-tile--image">
            <div class="oling-home-panel__media">
              {% set proofImage = homePage.proof.image %}
              <img src="{{ proofImage starts with 'http://' or proofImage starts with 'https://' or proofImage starts with '/' ? proofImage : asset(proofImage) }}" alt="{{ homePage.proof.imageAlt }}">
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  {% if homeProjects|length > 0 %}
  <section class="oling-home-support oling-home-support--references">
    <div class="container">
      <div class="oling-home-section-head">
        <span>{{ homePage.projects.eyebrow }}</span>
        <div>
          <h2>{{ homePage.projects.title }}</h2>
          {% if homePage.projects.intro %}
            <p>{{ homePage.projects.intro }}</p>
          {% endif %}
        </div>
      </div>

      <div class="oling-home-project-grid">
        {% for project in homeProjects %}
          <a class="oling-home-project-card" href="{{ project.href }}">
            <div class="oling-home-project-card__media">
              <img src="{{ project.image starts with 'http://' or project.image starts with 'https://' or project.image starts with '/' ? project.image : asset(project.image) }}" alt="{{ project.title }}">
            </div>
            <div class="oling-home-project-card__body">
              {% if project.eyebrow %}
                <span>{{ project.eyebrow }}</span>
              {% endif %}
              <h3>{{ project.title }}</h3>
              <p>{{ project.excerpt }}</p>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if latestResources|default([])|length > 0 %}
  <section class="oling-home-intro oling-home-intro--resources">
    <div class="container">
      <div class="oling-home-section-head">
        <span>{{ homePage.resources.eyebrow }}</span>
        <div>
          <h2>{{ homePage.resources.title }}</h2>
          {% if homePage.resources.intro %}
            <p>{{ homePage.resources.intro }}</p>
          {% endif %}
        </div>
      </div>

      <div class="oling-home-resources__grid">
        {% for resource in latestResources|default([]) %}
          <article class="oling-home-resource-card">
            <span>Ressource{% if resource.publicationDate %} · {{ resource.publicationDate|date('d/m/Y') }}{% endif %}</span>
            <h3><a href="{{ path('seo_resource', {slug: resource.slug}) }}">{{ resource.title }}</a></h3>
            {% if resource.intro is not empty %}
              <p>{{ resource.intro|striptags }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      {% if homePage.resources.cta is defined %}
        {% set resourcesHref = homePage.resources.cta.url|default(homePage.resources.cta.route is defined ? path(homePage.resources.cta.route, homePage.resources.cta.routeParams|default({})) : null) %}
        {% if resourcesHref %}
          <div class="oling-home-section-actions">
            <a class="btn btn-outline-dark" href="{{ resourcesHref }}">{{ homePage.resources.cta.label }}</a>
          </div>
        {% endif %}
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% include 'public/_cta_band.html.twig' with {
    eyebrow: homePage.finalCta.eyebrow,
    title: homePage.finalCta.title,
    text: homePage.finalCta.text,
    primaryCta: homePage.finalCta.primaryCta
  } %}
</main>
{% endblock %}

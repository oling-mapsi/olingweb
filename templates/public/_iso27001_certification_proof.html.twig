<style>
  .oling-certification-proof {
    border-block: 1px solid rgba(14, 42, 63, 0.16);
    background: #f3f7f8;
  }
  .oling-certification-proof__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }
  .oling-certification-proof__inner h2 {
    margin-bottom: 0.75rem;
  }
  .oling-certification-proof__details {
    padding-left: 1.25rem;
    border-left: 3px solid #167c80;
  }
  .oling-certification-proof__details p {
    margin-bottom: 0.75rem;
  }
  .oling-certification-proof__link {
    color: #075b62;
    font-weight: 700;
    text-decoration: underline !important;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }
  .oling-certification-proof__link:hover {
    color: #0e2a3f !important;
  }
  .oling-certification-proof__link:focus-visible {
    color: #0e2a3f !important;
    outline: 3px solid #f2b84b;
    outline-offset: 4px;
  }
  .oling-certification-proof__search {
    margin-top: 0.9rem;
    color: #314955;
    font-size: 0.92rem;
  }

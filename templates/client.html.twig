{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}

{% block body %}
<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.intro,
    primaryCta: page.primaryCta,
    secondaryCta: page.secondaryCta,
    highlights: page.highlights
  } %}

  <section class="oling-page-section">
    <div class="container">
      {% if (page.methodSection.left.html is defined and page.methodSection.left.html) or (page.legacySideHtml is defined and page.legacySideHtml) %}
        <div class="oling-two-col mb-4">
          <article class="oling-surface oling-surface--light">
            <span class="oling-kicker">{{ page.methodSection.left.kicker }}</span>
            <h2>{{ page.methodSection.left.title }}</h2>
            <div class="oling-richtext">{{ page.methodSection.left.html is defined and page.methodSection.left.html ? page.methodSection.left.html|raw : page.legacySideHtml|raw }}</div>
          </article>
          <article class="oling-surface oling-surface--light">
            <span class="oling-kicker">{{ page.methodSection.right.kicker }}</span>
            <h2>{{ page.methodSection.right.title }}</h2>
            <p>{{ page.methodSection.right.text }}</p>
          </article>
        </div>
      {% endif %}

      <div class="oling-page-section__prose">
        {% if page.legacyBodyHtml is defined and page.legacyBodyHtml %}
          <div class="oling-surface oling-surface--light">
            <div class="oling-richtext">{{ page.legacyBodyHtml|raw }}</div>
          </div>
        {% else %}
          <div class="oling-surface oling-surface--light">
            <span class="oling-kicker">{{ page.referencesSection.kicker }}</span>
            <h2>{{ page.referencesSection.title }}</h2>
            <p>{{ page.referencesSection.text }}</p>
            <img class="img-fluid rounded-4 mt-3" src="{{ asset(page.referencesSection.image) }}" alt="{{ page.referencesSection.imageAlt }}">
          </div>
        {% endif %}
      </div>
    </div>
  </section>
</main>
{% endblock %}

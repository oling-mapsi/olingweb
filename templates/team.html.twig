{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}
{% block canonical_url %}{{ app.request.schemeAndHttpHost ~ (canonicalPath|default(app.request.pathInfo)) }}{% endblock %}

{% block body %}
<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: 'leadership.team_title'|trans,
    intro: 'leadership.team_intro'|trans,
    primaryCta: page.primaryCta,
    secondaryCta: page.secondaryCta,
    highlights: page.highlights
  } %}

  <section class="oling-shell-section oling-leadership-page" aria-labelledby="oling-leadership-heading">
    <div class="container">
      {% if page.legacyBodyHtml is defined and page.legacyBodyHtml %}
        <div class="oling-leadership-page__legacy oling-richtext">
          {{ page.legacyBodyHtml|raw }}
        </div>
      {% endif %}
      <div class="oling-leadership-page__heading">
        <span class="oling-kicker">{{ 'leadership.eyebrow'|trans }}</span>
        <h2 id="oling-leadership-heading">{{ 'leadership.detail_heading'|trans }}</h2>
      </div>
      {% if team|length > 0 %}
        <div class="oling-leadership-grid oling-leadership-grid--detail">
          {% for people in team %}
            {% include 'public/_leadership_card.html.twig' with {person: people, mode: 'detail'} only %}
          {% endfor %}
        </div>
      {% else %}
        <p class="oling-leadership-page__empty">{{ 'leadership.empty'|trans }}</p>
      {% endif %}
    </div>
  </section>
</main>
<script type="application/ld+json">{{ {'@context': 'https://schema.org', '@graph': teamSchemas}|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}

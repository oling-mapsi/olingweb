{% extends 'base.html.twig' %}

{% block title %}{{ serviceNarrative.metaTitle ?? (service.designation ~ ' | OLING') }}{% endblock %}
{% block meta_description %}{{ serviceNarrative.metaDescription ?? serviceNarrative.intro|striptags }}{% endblock %}
{% block body_class %} service-detail-page{% endblock %}

{% block body %}
<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: serviceNarrative.eyebrow,
    title: serviceNarrative.headline,
    intro: serviceNarrative.intro,
    primaryCta: {route: 'contact', label: 'Parler de votre projet'},
    secondaryCta: {route: 'practice_home', routeParams: {slug: service.practice.slug}, label: 'Voir la practice'},
    highlights: serviceNarrative.outcomes|slice(0, 3)
  } %}

  <section class="oling-shell-section">
    <div class="container">
      <div class="oling-two-col">
        <article class="oling-surface oling-surface--light">
          <span class="oling-kicker">Ce que couvre l'offre</span>
          <h2>{{ service.designation }}</h2>
          <div class="oling-richtext">{{ service.description|raw }}</div>
        </article>
        <article class="oling-surface oling-surface--light">
          <span class="oling-kicker">Résultats attendus</span>
          <h2>Ce que cette intervention doit rendre possible</h2>
          <ul class="oling-check-list">
            {% for item in serviceNarrative.outcomes %}
              <li>{{ item }}</li>
            {% endfor %}
            <li>Des livrables utilisables pour arbitrer, piloter et faire adopter.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  {% if serviceNarrative.promise is defined or serviceNarrative.focus is defined %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-two-col">
          {% if serviceNarrative.promise is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">Positionnement</span>
              <h2>Pourquoi OLING intervient sur un projet ERP</h2>
              <p>{{ serviceNarrative.promise }}</p>
            </article>
          {% endif %}
          {% if serviceNarrative.focus is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">Périmètre</span>
              <h2>Ce que couvre une mission AMOA ERP</h2>
              <ul class="oling-check-list">
                {% for item in serviceNarrative.focus %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </article>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if serviceNarrative.missionPhases is defined or serviceNarrative.deliverables is defined %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-two-col">
          {% if serviceNarrative.missionPhases is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">Phases projet</span>
              <h2>Quand lancer une mission ERP avec OLING</h2>
              <ul class="oling-check-list">
                {% for item in serviceNarrative.missionPhases %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </article>
          {% endif %}
          {% if serviceNarrative.deliverables is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">Livrables</span>
              <h2>Livrables utiles pour cadrer, choisir et piloter</h2>
              <ul class="oling-check-list">
                {% for item in serviceNarrative.deliverables %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </article>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if serviceNarrative.projectContexts is defined or serviceNarrative.clientTypes is defined %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-two-col">
          {% if serviceNarrative.projectContexts is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">Contextes</span>
              <h2>Situations ou OLING apporte le plus de valeur</h2>
              <ul class="oling-check-list">
                {% for item in serviceNarrative.projectContexts %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </article>
          {% endif %}
          {% if serviceNarrative.clientTypes is defined %}
            <article class="oling-surface oling-surface--light">
              <span class="oling-kicker">Interlocuteurs</span>
              <h2>Equipes et organisations concernées</h2>
              <ul class="oling-check-list">
                {% for item in serviceNarrative.clientTypes %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </article>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  <section class="oling-shell-section oling-shell-section--tint">
    <div class="container">
      <div class="oling-section-head">
        <span class="oling-kicker">Practice</span>
        <h2>Autres offres de {{ service.practice.designation }}</h2>
        <p>La logique de practice permet de relier cadrage, outillage, conformité et exécution dans un même ensemble de services.</p>
      </div>
      <div class="oling-service-link-grid">
        {% for serv in services %}
          {% if serv.practice == service.practice %}
            <a class="oling-service-link-card" href="{{ path('service', {practice: serv.practice.slug, slug: serv.slug}) }}">
              <span class="oling-kicker">{{ serv.designationShort ?: 'Offre OLING' }}</span>
              <h3>{{ serv.designation }}</h3>
              <p>{{ serv.introductionShort ?: serv.descriptionShort ?: 'Voir le détail de cette offre.' }}</p>
              <span class="oling-service-link-card__more">{% if serv.id == service.id %}Offre actuelle{% else %}Voir l'offre{% endif %}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {% if serviceNarrative.supportLinks is defined %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">Maillage</span>
          <h2>Explorer les sujets liés à un projet ERP</h2>
          <p>Ces pages aident à relier cadrage ERP, transformations SI, applications connexes et preuves projet sans forcer de redirection métier.</p>
        </div>
        <div class="oling-service-link-grid">
          {% for link in serviceNarrative.supportLinks %}
            <a class="oling-service-link-card" href="{{ link.href }}">
              <span class="oling-kicker">Ressource liée</span>
              <h3>{{ link.label }}</h3>
              <p>{{ link.description }}</p>
              <span class="oling-service-link-card__more">Voir la page</span>
            </a>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if service.projets|length > 0 %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">Cas liés</span>
          <h2>Exemples de contextes d'intervention</h2>
        </div>
        <div class="oling-project-proof-grid">
          {% for project in service.projets|slice(0, 3) %}
            <article class="oling-proof-card">
              <span class="oling-kicker">{{ project.metier ? project.metier.designation : 'Projet' }}</span>
              <h3>{{ project.designation }}</h3>
              <p>{{ project.description ? project.description|striptags|slice(0, 180) ~ '…' : 'Intervention structurée pour mieux piloter un projet et ses risques.' }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if service.teams|length > 0 %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">Experts</span>
          <h2>Intervenants associés</h2>
        </div>
        <div class="oling-team-mini-list">
          {% for team in service.teams %}
            <div class="oling-team-mini">
              <img class="oling-team-mini__avatar" src="{{ team.photo ?: asset('img/160x160/img1.jpg') }}" alt="Photo de {{ team.noncomplet }}">
              <div class="oling-team-mini__meta">
                <div class="oling-team-mini__name">{{ team.noncomplet }}</div>
                {% if team.titre %}
                  <div class="oling-team-mini__title">{{ team.titre }}</div>
                {% endif %}
                {% if team.linkedin %}
                  <a class="oling-team-mini__link" href="{{ team.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% include 'public/_cta_band.html.twig' with {
    eyebrow: 'Passage à l\'action',
    title: 'Vérifier rapidement si cette offre est le bon niveau d\'intervention',
    text: 'OLING peut qualifier votre contexte, confirmer le bon angle d\'attaque et engager un cadrage utile sans surdimensionner le dispositif.',
    primaryCta: {route: 'contact', label: 'Parler de votre sujet'}
  } %}
</main>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ service.designation|striptags|e('js') }}",
  "serviceType": "{{ (serviceNarrative.schemaServiceType ?? service.practice.designation)|striptags|e('js') }}",
  "provider": {
    "@type": "ProfessionalService",
    "name": "OLING Management et Technologie",
    "url": "https://oling.fr"
  },
  "areaServed": ["France", "Guadeloupe", "Martinique", "Guyane"],
  "url": "{{ site_base_url ~ app.request.pathInfo }}",
  "description": "{{ (serviceNarrative.metaDescription ?? serviceNarrative.intro)|striptags|e('js') }}"
}
</script>
{% endblock %}

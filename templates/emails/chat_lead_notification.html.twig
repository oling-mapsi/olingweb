{% set c = chatContent %}
<h2>{{ c.email.title }}</h2>
<p><strong>{{ c.email.date }} :</strong> {{ conversation.submittedAt ? conversation.submittedAt|date('d/m/Y H:i') : '' }}</p>
<p><strong>{{ c.email.company }} :</strong> {{ lead.company }}<br>
<strong>{{ c.email.name }} :</strong> {{ lead.fullName }}<br>
<strong>{{ c.email.email }} :</strong> {{ lead.email }}<br>
<strong>{{ c.email.phone }} :</strong> {{ lead.phone }}<br>
<strong>{{ c.email.source }} :</strong> {{ conversation.sourceUrl ?: conversation.sourcePath }}</p>

<h3>{{ c.email.short_summary }}</h3>
<p>{{ conversation.summaryShort }}</p>

<h3>{{ c.email.qualification }}</h3>
<ul>
  <li><strong>{{ c.email.primary_need }} :</strong> {{ qualification.primary_need ?: c.labels.unqualified }}</li>
  <li><strong>{{ c.email.urgency }} :</strong> {{ qualification.urgency_level ?: c.labels.unqualified }}</li>
  <li><strong>{{ c.email.maturity }} :</strong> {{ qualification.maturity_level ?: c.labels.unqualified }}</li>
  <li><strong>{{ c.email.organization_type }} :</strong> {{ qualification.organization_type ?: c.labels.unqualified }}</li>
  <li><strong>{{ c.email.organization_size }} :</strong> {{ qualification.organization_size ?: c.labels.unqualified }}</li>
  <li><strong>{{ c.email.commercial_intent }} :</strong> {{ qualification.commercial_intent ?: c.labels.unqualified }}</li>
  <li><strong>{{ c.email.potential_value }} :</strong> {{ qualification.potential_value ?: c.labels.unqualified }}</li>
</ul>

<h3>{{ c.email.description }}</h3>
<p>{{ lead.needDescription|nl2br }}</p>

<h3>{{ c.email.consent }}</h3>
<p>{{ lead.rgpdConsent ? c.email.yes : c.email.no }} - {{ lead.rgpdConsentAt ? lead.rgpdConsentAt|date('d/m/Y H:i') : '' }}</p>

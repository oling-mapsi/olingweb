<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{% block title %}CRM | OLING{% endblock %}</title><link rel="stylesheet" href="/crm/workspace.css?v=9"><script src="/crm/workspace.js?v=9" defer></script></head><body class="crm-workspace">
<a class="skip-link" href="#crm-main">Aller au contenu</a>
<header class="app-header"><div class="topbar"><a class="brand" href="{{ path('admin_crm') }}"><img src="/crm/oling-logo.png" width="52" height="52" alt="Oling"><span>CRM<br>COMMERCIAL</span></a><nav aria-label="Navigation principale">{% for key,label in {portfolio:'Portefeuille',todo:'Actions et relances'} %}<a class="{{ view|default('portfolio')==key?'active':'' }}" aria-current="{{ view|default('portfolio')==key?'page':'false' }}" href="{{ path('admin_crm',{view:key}) }}">{{ label }}</a>{% endfor %}</nav>{% if app.request.host in ['crm.oling.fr','crm.localhost'] %}<form class="session-action" method="post" action="{{ path('admin_crm_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button>Déconnexion</button></form>{% else %}<a class="admin-link" href="{{ path('logout') }}">Déconnexion</a>{% endif %}</div>{% block workspace_filters %}{% endblock %}</header>
<main id="crm-main" class="crm" tabindex="-1">{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}<div id="save-status" class="save-status" role="status" aria-live="polite" hidden></div><div id="save-error" class="alert alert-danger" role="alert" hidden></div>{% block crm %}{% endblock %}</main><footer class="footer">OLING Management & Technologie · Espace privé</footer></body></html>

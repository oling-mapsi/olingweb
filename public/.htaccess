<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.oling\.fr$ [NC]
    RewriteRule ^ https://oling.fr%{REQUEST_URI} [R=301,L]

    # Generate services from current public content even when the legacy XML file exists.
    RewriteRule ^sitemap\.services\.xml$ index.php [QSA,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

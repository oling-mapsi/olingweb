<section class="oling-shell-hero{% if variant is defined and variant %} oling-shell-hero--{{ variant }}{% endif %}{% if mediaFrame|default('none') == 'framed' %} oling-shell-hero--framed{% endif %}">
  {% set currentLocale = app.request.locale|default('fr') %}
  {% set localizedRoutePaths = {
    contact: currentLocale == 'en' ? '/en/contact' : (currentLocale == 'es' ? '/es/contacto' : path('contact')),
    projets: currentLocale == 'en' ? '/en/projects' : (currentLocale == 'es' ? '/es/proyectos' : path('projets')),
    team: currentLocale == 'en' ? '/en/team' : (currentLocale == 'es' ? '/es/equipo' : path('team')),
    apropos: currentLocale == 'en' ? '/en/about' : (currentLocale == 'es' ? '/es/quienes-somos' : path('apropos')),
    expertises_index: currentLocale == 'en' ? '/en/areas-of-expertise' : (currentLocale == 'es' ? '/es/areas-de-especializacion' : path('expertises_index')),
    services_index: currentLocale == 'en' ? '/en/services' : (currentLocale == 'es' ? '/es/servicios-y-ofertas' : path('services_index'))
  } %}
  {% set heroImageRaw = image is defined and image ? image|trim : '' %}
  {% set heroImageSrc = heroImageRaw ? (heroImageRaw starts with 'http://' or heroImageRaw starts with 'https://' or heroImageRaw starts with 'data:' or heroImageRaw starts with '/' ? heroImageRaw : asset(heroImageRaw)) : null %}
  <div class="container">
    <div class="oling-shell-hero__inner{{ heroImageSrc ? ' oling-shell-hero__inner--media' : '' }}">
      <div class="oling-shell-hero__copy">
        {% if eyebrow is defined and eyebrow %}
          <span class="oling-shell-hero__eyebrow">{{ eyebrow }}</span>
        {% endif %}
        <h1>{{ title }}</h1>
        {% if intro is defined and intro %}
          <p class="oling-shell-hero__intro">{{ intro }}</p>
        {% endif %}
        {% if primaryCta is defined or secondaryCta is defined or externalCta is defined %}
          <div class="oling-shell-hero__actions">
            {% if primaryCta is defined and primaryCta %}
              {% set primaryRoute = primaryCta.route ?? 'contact' %}
              <a class="btn btn-primary" href="{{ localizedRoutePaths[primaryRoute]|default(null) ?: path(primaryRoute, primaryCta.routeParams|default({})) }}"{% if primaryCta.bypass|default(false) %} data-chat-bypass="true"{% endif %}>{{ primaryCta.label }}</a>
            {% endif %}
            {% if secondaryCta is defined and secondaryCta %}
              {% set secondaryRoute = secondaryCta.route ?? 'contact' %}
              <a class="btn btn-outline-dark" href="{{ localizedRoutePaths[secondaryRoute]|default(null) ?: path(secondaryRoute, secondaryCta.routeParams|default({})) }}">{{ secondaryCta.label }}</a>
            {% endif %}
            {% if externalCta is defined and externalCta %}
              <a class="btn btn-outline-dark" href="{{ externalCta.href }}" target="_blank" rel="noopener">{{ externalCta.label }}</a>
            {% endif %}
          </div>
        {% endif %}
      </div>
      {% if heroImageSrc %}
        {% include 'public/_hero_media.html.twig' with {
          imageSrc: heroImageSrc,
          imageAlt: imageAlt|default(title),
          imageDisplayMode: imageDisplayMode|default(heroMedia.displayMode|default(page.heroImageDisplayMode|default('auto'))),
          imageSize: imageSize|default(heroMedia.size|default(page.heroImageSize|default('auto'))),
          imageCaption: imageCaption|default(null),
          imageFocalPoint: imageFocalPoint|default(null)
        } %}
      {% endif %}
      {% if highlights is defined and highlights|length > 0 %}
        <div class="oling-shell-hero__highlights">
          {% for item in highlights %}
            <span>{{ item }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

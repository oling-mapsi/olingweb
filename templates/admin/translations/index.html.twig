{% extends 'base.html.twig' %}

{% block title %}Traductions{% endblock %}

{% block body %}
{% include 'admin/_nav.html.twig' %}

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="h3 mb-1">Traductions</h1>
      <p class="text-muted mb-0">Source FR, EN/ES, statuts, revue et publication contrôlée.</p>
    </div>
  </div>

  <form class="row g-2 mb-4" method="get">
    <div class="col-md-4">
      <select class="form-select" name="type">
        <option value="all" {{ type == 'all' ? 'selected' : '' }}>Tous types</option>
        <option value="page" {{ type == 'page' ? 'selected' : '' }}>Page</option>
        <option value="expertise" {{ type == 'expertise' ? 'selected' : '' }}>Expertise</option>
        <option value="sector" {{ type == 'sector' ? 'selected' : '' }}>Secteur</option>
        <option value="resource" {{ type == 'resource' ? 'selected' : '' }}>Ressource</option>
      </select>
    </div>
    <div class="col-md-3">
      <select class="form-select" name="locale">
        <option value="all" {{ locale == 'all' ? 'selected' : '' }}>EN + ES</option>
        <option value="en" {{ locale == 'en' ? 'selected' : '' }}>EN</option>
        <option value="es" {{ locale == 'es' ? 'selected' : '' }}>ES</option>
      </select>
    </div>
    <div class="col-md-3">
      <select class="form-select" name="status">
        <option value="all" {{ status == 'all' ? 'selected' : '' }}>Tous statuts</option>
        <option value="missing" {{ status == 'missing' ? 'selected' : '' }}>Manquantes</option>
        <option value="draft" {{ status == 'draft' ? 'selected' : '' }}>Brouillons</option>
        <option value="ai_translated" {{ status == 'ai_translated' ? 'selected' : '' }}>Traduites IA</option>
        <option value="to_review" {{ status == 'to_review' ? 'selected' : '' }}>À relire</option>
        <option value="reviewed" {{ status == 'reviewed' ? 'selected' : '' }}>Relues</option>
        <option value="published" {{ status == 'published' ? 'selected' : '' }}>Publiées</option>
        <option value="outdated" {{ status == 'outdated' ? 'selected' : '' }}>Source FR modifiée</option>
      </select>
    </div>
    <div class="col-md-2">
      <button class="btn btn-primary w-100" type="submit">Filtrer</button>
    </div>
  </form>

  {% set missingCount = rows|filter(row => row.status == 'missing')|length %}
  {% if type != 'all' and locale in ['en', 'es'] and status == 'missing' %}
    <form method="post" action="{{ path('admin_translations_bulk_generate') }}" class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-3" onsubmit="return confirm('{{ missingCount }} contenu(s) seront générés en {{ locale|upper }}. Confirmer ?');">
      <div><strong>{{ missingCount }}</strong> contenu(s) manquant(s) pour {{ type }} / {{ locale|upper }}.</div>
      <input type="hidden" name="_token" value="{{ csrf_token('translation_bulk_generate') }}">
      <input type="hidden" name="type" value="{{ type }}">
      <input type="hidden" name="locale" value="{{ locale }}">
      <input type="hidden" name="expected_count" value="{{ missingCount }}">
      <button class="btn btn-warning" type="submit" {{ missingCount == 0 ? 'disabled' : '' }}>Générer les traductions manquantes</button>
    </form>
  {% endif %}

  <div class="table-responsive">
    <table class="table table-sm align-middle">
      <thead>
        <tr>
          <th>Page FR</th>
          <th>Type</th>
          <th>Locale</th>
          <th>Statut</th>
          <th>Outdated</th>
          <th>Slug cible</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
          <tr>
            <td>
              <strong>{{ row.source ? row.source.title : row.page.slug }}</strong><br>
              <code>{{ row.page.slug }}</code>
            </td>
            <td>{{ row.type }}</td>
            <td>{{ row.locale|upper }}</td>
            <td><span class="badge {{ row.status == 'published' ? 'bg-success' : (row.status == 'missing' ? 'bg-light text-dark border' : 'bg-secondary') }}">{{ row.status }}</span></td>
            <td>{% if row.outdated %}<span class="badge bg-warning text-dark">Source FR modifiée</span>{% else %}—{% endif %}</td>
            <td>{{ row.translation ? row.translation.slug : '—' }}</td>
            <td class="text-end">
              {% if row.translation %}
                <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_translations_site_page_edit', {id: row.translation.id, locale: row.locale}) }}">Comparer / éditer</a>
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_translations_site_page_preview', {id: row.translation.id, locale: row.locale}) }}" target="_blank" rel="noopener">Prévisualiser</a>
              {% else %}
                <form method="post" action="{{ path('admin_translations_site_page_generate', {id: row.page.id, locale: row.locale}) }}" class="d-inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('translation_generate_' ~ row.page.id ~ '_' ~ row.locale) }}">
                  <button class="btn btn-sm btn-outline-secondary" type="submit">Générer avec l'IA</button>
                </form>
              {% endif %}
            </td>
          </tr>
        {% else %}
          <tr><td colspan="7" class="text-muted">Aucune traduction trouvée.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block body %}<main class="admin container-fluid content-space-2">
{% include 'admin/_nav.html.twig' %}<h1>{{ title }}</h1>
{% if type == 'service' %}<p>Les Services historiques constituent les fiches de référence métier. Les SitePage de prestation sont identifiées séparément par leur stockage et peuvent être associées à ces fiches.</p>{% endif %}
<p>{{ count }} contenus enregistrés. Les statuts historiques, le hub, les menus et l’indexation sont distincts.</p>
{% if type == 'service' %}<a class="btn btn-primary mb-3" href="{{ path('admin_services_new') }}">Créer un Service</a>{% elseif type == 'practice' %}<a class="btn btn-primary mb-3" href="{{ path('admin_practices_new') }}">Créer une Practice</a>{% elseif type == 'project' %}<a class="btn btn-primary mb-3" href="{{ path('admin_projets_new') }}">Créer un Projet</a>{% endif %}
<form method="get" class="row g-2 mb-4">
<div class="col"><label for="cms-q">Recherche</label><input id="cms-q" class="form-control" name="q" type="search" value="{{ filters.q }}" placeholder="Titre, slug ou URL"></div>
<div class="col"><label for="cms-practice">Practice</label><select id="cms-practice" name="practice" class="form-select"><option value="">Toutes</option><option value="none" {{ filters.practice == 'none' ? 'selected' : '' }}>Non classé</option>{% for item in practiceChoices %}<option value="{{ item.id }}" {{ filters.practice == item.id ? 'selected' : '' }}>{{ item.designation }}</option>{% endfor %}</select></div>
<div class="col"><label for="cms-status">Statut</label><select id="cms-status" name="status" class="form-select"><option value="">Tous</option>{% for value,label in {'published':'Publié','draft':'Brouillon','unpublished':'Non publié','legacy':'Historique'} %}<option value="{{ value }}" {{ filters.status == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
<div class="col"><label for="cms-hub">Hub</label><select id="cms-hub" name="hub" class="form-select"><option value="">Tous</option>{% for value,label in {'yes':'Visible','no':'Absent','unknown':'À vérifier'} %}<option value="{{ value }}" {{ filters.hub == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
<div class="col"><label for="cms-type">Type technique</label><select id="cms-type" name="technical" class="form-select"><option value="">Tous</option>{% for value in ['practice','service','project','page','sector','legal'] %}<option value="{{ value }}" {{ filters.technical == value ? 'selected' : '' }}>{{ value }}</option>{% endfor %}</select></div>
<div class="col"><label for="cms-sort">Tri</label><select id="cms-sort" name="sort" class="form-select">{% for value,label in {'title':'Titre','id':'ID','status':'Statut'} %}<option value="{{ value }}" {{ filters.sort == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
<div class="col"><label for="cms-indexation">Indexation observée</label><select id="cms-indexation" name="indexation" class="form-select"><option value="">Toutes</option>{% for value,label in {'yes':'Indexable','no':'Non indexable','unknown':'À vérifier'} %}<option value="{{ value }}" {{ filters.indexation == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
<div class="col"><label for="cms-navigation">Navigation observée</label><select id="cms-navigation" name="navigation" class="form-select"><option value="">Toutes</option>{% for value,label in {'yes':'Visible','no':'Absent','unknown':'À vérifier'} %}<option value="{{ value }}" {{ filters.navigation == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div><div class="col-auto align-self-end"><button class="btn btn-primary">Filtrer</button></div></form>
{% include 'admin/catalogue/_table.html.twig' %}
<nav aria-label="Pagination du catalogue">Page {{ page }} / {{ pages }} {% if page > 1 %}<a href="{{ path('admin_catalogue_index', app.request.query.all|merge({type:type,page:page-1})) }}">Précédente</a>{% endif %} {% if page < pages %}<a href="{{ path('admin_catalogue_index', app.request.query.all|merge({type:type,page:page+1})) }}">Suivante</a>{% endif %}</nav>
</main>{% endblock %}

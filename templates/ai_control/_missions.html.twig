<div class="table-wrap"><table><thead><tr><th>Mission</th><th>Avancement</th><th>Dernière activité</th></tr></thead><tbody>{% for m in missions %}<tr><td><a href="{{ path('admin_ai_mission',{id:m.id}) }}">{{ m.title }}</a><small>{{ m.project }} · {{ m.executor }}</small></td><td><span class="badge">{{ states[m.status] }}</span></td><td class="small">{{ m.updated_at|date('d/m/Y H:i','Europe/Paris') }}</td></tr>{% else %}<tr><td colspan="3" class="empty">Votre première mission commence par un objectif clair.</td></tr>{% endfor %}</tbody></table></div>

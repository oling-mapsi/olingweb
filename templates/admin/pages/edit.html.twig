{% extends 'base.html.twig' %}
{% block title %}{{ page.title }} | Admin{% endblock %}
{% block body %}<main class="admin">
{% set preview=cms_admin_item(page) %}
<div class="cms-editor-head"><div><h1>{{ preview.title }}</h1><p>Vous modifiez {{ editorMode=='resource' ? 'l’article' : 'la SitePage' }} #{{ page.id }} · <a href="{{ publicUrl }}" target="_blank" rel="noopener">{{ publicUrl ?: page.slug }}</a></p><p class="small">Cette édition ne modifie aucune autre page associée.</p></div>{% if preview.thumbnail %}<img class="cms-editor-image" src="{{ preview.thumbnail }}" alt="{{ preview.title }}">{% endif %}<button class="btn btn-primary" type="submit" form="page-editor">Enregistrer</button></div>
{% for label,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ label }}">{{ message }}</div>{% endfor %}{% endfor %}
{{ form_start(form,{'attr':{'id':'page-editor'}}) }}{{ form_errors(form) }}
{% set editingImages=app.request.query.get('section')=='images' %}{% set contentEditor %}<section class="cms-card"><h2>Titre & contenu</h2>{% for name in ['heroTitle','heroIntro','bodyHtml'] %}{% if attribute(form,name) is defined %}{{ form_row(attribute(form,name)) }}{% endif %}{% endfor %}</section>{% endset %}{% if not editingImages %}{{ contentEditor|raw }}{% endif %}
<section class="cms-card" id="illustrations"><h2>Image principale & illustrations</h2>{% if page.heroImage %}<img class="cms-editor-image mb-3" src="{{ asset(page.heroImage) }}" alt="Image principale actuelle">{% endif %}{{ form_row(form.heroImageFile,{'label':'Remplacer l’image principale'}) }}<details><summary>Adresse de l’image</summary>{{ form_row(form.heroImage) }}</details>{% if page.slug in ['expertises-index','secteurs-index','projets','apropos','ressources'] %}<a class="btn btn-outline-primary mt-3" href="{{ path('admin_catalogue_media',{technical:'page',id:page.id,slot:'hero'}) }}">Personnaliser le héros : image, cadrage et légende</a><p class="small mt-2">Les réglages du média Hero permettent de choisir une image entière ou recadrée, sa taille, son point focal, son texte alternatif et sa légende. Les titres et l’introduction restent dans « Titre & contenu ».</p>{% endif %}<p class="small mt-3">Les illustrations intégrées au contenu restent dans leur emplacement.</p><a href="{{ path('admin_catalogue_media',{technical:'page',id:page.id}) }}">Gérer les illustrations supplémentaires de cette page</a></section>
{% if editingImages %}<details class="cms-secondary"><summary>Titre & contenu de la page</summary>{{ contentEditor|raw }}</details>{% endif %}<details class="cms-secondary"><summary>SEO/GEO</summary>{{ form_row(form.title) }}{{ form_row(form.seoDescription) }}{% for child in form %}{% if child.vars.name starts with 'seoAdvanced' %}{{ form_row(child) }}{% endif %}{% endfor %}</details>
<details class="cms-secondary"><summary>Traductions</summary>{% for code,label in {'en':'English','es':'Español'} %}{% set state=translationStates[code]|default({id:null}) %}{% if state.id %}<a class="btn btn-outline-secondary btn-sm" href="{{ path('admin_translations_site_page_edit',{id:state.id,locale:code}) }}">Modifier {{ label }}</a>{% else %}<span>{{ label }} : traduction absente</span>{% endif %}{% endfor %}</details>
<details class="cms-secondary"><summary>Associations</summary>{% for service in page.catalogServices %}<a class="d-block" href="{{ path('admin_catalogue_service',{id:service.id}) }}">{{ service.designation }}</a>{% endfor %}<a href="{{ path('admin_catalogue_relations',{technical:'page',id:page.id}) }}">Gérer les pages associées</a></details>
<details class="cms-secondary"><summary>Réglages avancés</summary>{% for child in form %}{% if child.vars.name not in ['heroTitle','heroIntro','bodyHtml','heroImageFile','heroImage','title','seoDescription','_token'] and not (child.vars.name starts with 'seoAdvanced') %}{{ form_row(child) }}{% endif %}{% endfor %}</details>
<div class="cms-editor-actions"><button class="btn btn-primary">Enregistrer</button>{% if publicUrl %}<a class="btn btn-outline-secondary" href="{{ publicUrl }}" target="_blank" rel="noopener">Voir la page</a>{% endif %}<a href="{{ path('admin_catalogue_site_pages') }}">Retour</a></div>{{ form_end(form) }}
</main>{% endblock %}

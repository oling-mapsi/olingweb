{% extends 'base.html.twig' %}
{% block title %}{{ service.designation }} | Admin{% endblock %}
{% block body %}<main class="admin">
{% set preview=cms_admin_item(service) %}<div class="cms-editor-head"><div><h1>{{ service.designation }}</h1><p>Service historique #{{ service.id }} · {{ preview.url ?: 'URL non renseignée' }}</p><a class="small" href="{{ path('admin_catalogue_service',{id:service.id}) }}">← Fiche de la prestation et pages associées</a></div>{% if preview.thumbnail %}<img class="cms-editor-image" src="{{ preview.thumbnail }}" alt="{{ service.designation }}">{% endif %}<div class="d-flex gap-2"><button class="btn btn-primary" type="submit" form="service-editor">Enregistrer</button>{% if preview.url %}<a class="btn btn-outline-secondary" href="{{ preview.url }}" target="_blank" rel="noopener">Voir la page</a>{% endif %}</div></div>
{% for label,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ label }}">{{ message }}</div>{% endfor %}{% endfor %}
{% include 'admin/services/_form.html.twig' with {form:form,service:service,form_action:path('admin_services_edit',{id:service.id})} %}
<details class="cms-secondary"><summary>Suppression — réglages avancés</summary>            <form method="post" action="{{ path('admin_services_delete', {id: service.id}) }}" onsubmit="return confirm('Supprimer ce service ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="confirm-delete-service-{{ service.id }}" required>
                    <label class="form-check-label" for="confirm-delete-service-{{ service.id }}">
                        Je confirme la suppression.
                    </label>
                </div>
                <button class="btn btn-outline-danger">Supprimer</button>
            </form></details>
</main>{% endblock %}

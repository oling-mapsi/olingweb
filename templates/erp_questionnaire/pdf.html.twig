<!doctype html>
{% set c = erpContent %}
<html lang="{{ submission.locale }}">
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: DejaVu Sans, sans-serif; color: #17324a; font-size: 11px; line-height: 1.45; }
    .header { display: table; width: 100%; border-bottom: 2px solid #e24d7c; padding-bottom: 14px; margin-bottom: 18px; }
    .brand, .meta { display: table-cell; vertical-align: middle; }
    .brand img { width: 110px; }
    .meta { text-align: right; color: #53697d; }
    h1 { font-size: 22px; margin: 0 0 8px; color: #17324a; }
    h2 { font-size: 14px; margin: 16px 0 6px; color: #b93162; }
    p { margin: 0 0 6px; }
    ul { margin: 0 0 8px 16px; padding: 0; }
    li { margin: 0 0 3px; }
    .box { border: 1px solid #d9e6f2; background: #f5f9fd; padding: 12px; margin-bottom: 12px; }
    .grid { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    .grid td { border: 1px solid #d9e6f2; padding: 6px; vertical-align: top; }
    .label { color: #53697d; font-size: 9px; text-transform: uppercase; }
    .notice { margin-top: 18px; padding: 10px; background: #fff6f9; border: 1px solid #f0bfd0; color: #7b2444; }
  </style>
</head>
<body>
  <div class="header">
    <div class="brand">{% if logoDataUri %}<img src="{{ logoDataUri }}" alt="OLING">{% else %}<strong>OLING</strong>{% endif %}</div>
    <div class="meta">{{ c.ui.pdf_meta }}<br>{{ submission.createdAt ? submission.createdAt|date('d/m/Y') : c.ui.today }}</div>
  </div>

  <h1>{{ c.ui.pdf_title }}</h1>
  <div class="box"><strong>{{ c.ui.executive_summary }}</strong><br>{{ summary.executive_summary }}</div>

  <table class="grid">
    <tr><td><span class="label">Prospect</span><br>{{ submission.fullName }}</td><td><span class="label">{{ c.fields.company }}</span><br>{{ submission.company }}</td></tr>
    <tr><td><span class="label">{{ c.fields.email }}</span><br>{{ submission.email }}</td><td><span class="label">{{ c.fields.phone }}</span><br>{{ submission.phone }}</td></tr>
    <tr><td><span class="label">{{ c.fields.jobTitle }}</span><br>{{ submission.jobTitle ?: c.summary.clarify }}</td><td><span class="label">{{ c.fields.sector }}</span><br>{{ submission.sector ?: c.summary.clarify }}</td></tr>
  </table>

  {% for key in ['context','expressed_need','maturity','complexity','amoa_charge_estimate','amoa_budget_estimate','recommended_commercial_next_step'] %}
    {% set title = c.summary_titles[key] %}
    <h2>{{ title }}</h2>
    <p>{{ summary[key] }}</p>
  {% endfor %}

  {% for key in ['current_situation','functional_scope','irritants','risks','constraints','data_interfaces','security_rgpd','project_organization','recommended_deliverables','macro_approach','macro_planning','estimation_assumptions','missing_information','priority_meeting_questions'] %}
    {% set title = c.summary_titles[key] %}
    <h2>{{ title }}</h2>
    <ul>{% for item in summary[key] %}<li>{{ item }}</li>{% endfor %}</ul>
  {% endfor %}

  <div class="notice">{{ c.ui.notice }}</div>
</body>
</html>

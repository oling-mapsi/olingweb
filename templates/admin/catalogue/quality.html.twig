{% extends 'base.html.twig' %}{% block title %}Qualité du catalogue{% endblock %}
{% block body %}<main class="admin container-fluid content-space-2">{% include 'admin/_nav.html.twig' %}<h1>Qualité du catalogue</h1><p>Diagnostic sans correction automatique. Les liens HTTP, canonicals et métadonnées sont contrôlés séparément dans la capture SEO.</p>
<table class="table"><thead><tr><th>Niveau</th><th>Contenu</th><th>Anomalie</th><th>Actions</th></tr></thead><tbody>
{% for row in rows %}{% for alert in row.anomalies %}<tr><td>{{ {'error':'Erreur bloquante','warning':'Avertissement','recommendation':'Recommandation'}[alert.level] }}</td><td>{{ row.title }} · {{ row.technical }} #{{ row.id }}</td><td>{{ alert.message }}</td><td><a href="{{ row.edit }}">Modifier</a>{% if row.technical in ['service','page','project'] %} · <a href="{{ path('admin_catalogue_relations',{technical:row.technical,id:row.id}) }}">Relations</a>{% endif %}</td></tr>{% endfor %}{% else %}<tr><td colspan="4">Aucune anomalie de classification détectée.</td></tr>{% endfor %}</tbody></table></main>{% endblock %}

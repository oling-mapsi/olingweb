<article class="cms-card" data-hub="{{ row.slug }}"><div class="cms-site-hub">{% if row.thumbnail %}<img src="{{ row.thumbnail }}" alt="{{ row.displayTitle }}">{% endif %}<div><h2>{{ row.displayTitle }}</h2><a class="cms-site-url" href="{{ row.publicUrl }}" target="_blank" rel="noopener">{{ row.publicUrl }}</a><span class="cms-status {{ row.visibility=='En ligne' ? 'cms-status-published' : '' }}">{{ row.visibility }}</span><div class="cms-site-hub-actions"><a class="btn btn-outline-secondary btn-sm" href="{{ row.publicUrl }}" target="_blank" rel="noopener">Voir la page publique</a><a class="btn btn-primary btn-sm" href="{{ row.edit }}">{{ row.editLabel|default('Modifier la présentation') }}</a>{% if row.preview %}<a class="btn btn-outline-secondary btn-sm" href="{{ row.preview }}" target="_blank" rel="noopener">Aperçu administrateur</a>{% endif %}</div></div></div><details class="cms-site-status"><summary>Ce que cette page permet de modifier</summary><div class="cms-hub-contract"><div><strong>Champs CMS qui alimentent cette page</strong><ul>{% for field in row.fields.direct %}<li>{{ field }}</li>{% endfor %}</ul>{% for field in row.fields.structured %}<p>{{ field }}</p>{% endfor %}</div><div><strong>Autres fiches et listes générées</strong><ul>{% for field in row.fields.generated %}<li>{{ field }}</li>{% endfor %}</ul><strong>Défini dans les gabarits</strong><ul>{% for field in row.fields.template %}<li>{{ field }}</li>{% endfor %}</ul></div></div></details></article>

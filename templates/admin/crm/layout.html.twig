<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{% block title %}CRM | OLING{% endblock %}</title><link rel="stylesheet" href="/crm/workspace.css?v=7"><script src="/crm/workspace.js?v=7" defer></script></head><body class="crm-workspace">
<a class="skip-link" href="#crm-main">Aller au contenu</a>
<header class="topbar"><a class="brand" href="{{ path('admin_crm') }}"><img src="/crm/oling-logo.png" width="52" height="52" alt="Oling"><span>CRM<br>COMMERCIAL</span></a><nav aria-label="Navigation principale">{% for key,label in {portfolio:'Portefeuille',todo:'Actions et relances'} %}<a class="{{ view|default('portfolio')==key?'active':'' }}" aria-current="{{ view|default('portfolio')==key?'page':'false' }}" href="{{ path('admin_crm',{view:key}) }}">{{ label }}</a>{% endfor %}</nav><a class="admin-link" href="{{ app.environment=='prod'?'https://oling.fr/admin':'/admin' }}">Back-office ↗</a></header>
<main id="crm-main" class="crm" tabindex="-1">{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}<div id="save-status" class="save-status" role="status" aria-live="polite" hidden></div><div id="save-error" class="alert alert-danger" role="alert" hidden></div>{% block crm %}{% endblock %}</main><footer class="footer">OLING Management & Technologie · Espace privé</footer></body></html>

{% extends 'admin/crm/layout.html.twig' %}
{% block crm %}
<header class="page-head"><div><div class="eyebrow">RELATIONS & DÉVELOPPEMENT</div><h1>{{ {portfolio:'Votre portefeuille',markets:'Marchés publics',clients:'Demandes clients',todo:'Actions et relances',review:'Imports à réviser',qualify:'À qualifier',all:'Toutes les affaires',active:'Affaires en cours'}[view]|default('Votre portefeuille') }}</h1><p>{{ view=='markets'?'Examinez les avis, choisissez les marchés à suivre.':(view=='clients'?'Formulaires OLING et MAPSI, complétés par vos saisies manuelles.':'Tous vos marchés et clients, de la qualification à la décision.') }}</p></div><a class="btn primary" href="{{ path('admin_crm_new') }}">＋ Nouvelle affaire</a></header>
<div id="deadline-summary" aria-live="polite">{% include 'admin/crm/_deadlines.html.twig' %}</div>
{% if view=='portfolio' %}
<nav class="segment-filter segmented" aria-label="Filtrer le portefeuille">{% for key,label in {'':'Tous',markets:'Marchés publics',clients:'Clients'} %}<a class="{{ segment==key?'selected':'' }}" aria-current="{{ segment==key?'page':'false' }}" href="{{ path('admin_crm',{view:'portfolio',segment:key,mode:mode}) }}">{{ label }}</a>{% endfor %}</nav>
<form class="filters simple-filters" method="get"><input type="hidden" name="view" value="portfolio"><input type="hidden" name="segment" value="{{ segment }}"><input type="hidden" name="mode" value="{{ mode }}"><label class="search">Recherche<input name="q" value="{{ q }}" placeholder="Société, contact, affaire…"></label><button>Rechercher</button></form>
{% else %}<form class="filters" method="get"><input type="hidden" name="segment" value="{{ segment }}"><input type="hidden" name="view" value="{{ view }}"><input type="hidden" name="mode" value="{{ mode }}"><label class="search">Recherche<input name="q" value="{{ q }}" placeholder="Société, contact, référence, affaire…"></label><label>Origine<select name="origin"><option value="">Toutes</option>{% for key,label in {form:'Formulaire',email:'Email',watch:'Veille',manual:'Manuelle'} %}<option value="{{ key }}" {{ origin==key?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label><label>Statut<select name="status"><option value="">Tous</option>{% for key,label in statuses %}<option value="{{ key }}" {{ status==key?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label>{% if view=='markets' %}<label>Décision<select name="decision"><option value="">Toutes</option>{% for key,label in decisions %}<option value="{{ key }}" {{ decision==key?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label>{% endif %}<label>Échéance<select name="due"><option value="">Toutes</option><option value="overdue" {{ due=='overdue'?'selected':'' }}>En retard</option><option value="week" {{ due=='week'?'selected':'' }}>Sous 7 jours</option></select></label><button>Appliquer</button></form>{% endif %}
<div class="view-toolbar"><div class="segmented"><a class="{{ mode=='board'?'selected':'' }}" href="{{ path('admin_crm',app.request.query.all|merge({mode:'board',page:1})) }}">▥ Kanban</a><a class="{{ mode=='list'?'selected':'' }}" href="{{ path('admin_crm',app.request.query.all|merge({mode:'list',page:1})) }}">☰ Liste</a></div><div class="crm-actions"><a href="{{ path('admin_crm',{view:'review',mode:'list'}) }}">Imports à réviser</a><a href="{{ path('admin_crm_export') }}">Exporter CSV</a></div></div>
{% if mode=='board' %}{% set columns=view=='markets'?decisions:statuses %}
<div class="board-controls"><p class="board-help">{{ total }} fiches · Glissez pour déplacer, survolez pour les détails.</p><button type="button" id="board-density" aria-pressed="false">Agrandir les cartes</button></div>
<nav class="column-jump" aria-label="Accès aux colonnes">{% for key,label in columns %}<button type="button" data-column="{{ key }}">{{ label }}</button>{% endfor %}</nav>
<div class="board-scroll" role="region" aria-label="Défilement horizontal du Kanban" tabindex="0"><div></div></div>
<div class="board" style="--columns:{{ columns|length }}"  data-token="{{ csrf_token('crm') }}" data-field="{{ view=='markets'?'decision':'status' }}">
{% for key,label in columns %}<section class="lane" tabindex="-1" data-value="{{ key }}"><header><span class="dot dot-{{ key }}"></span><h2{% if key=='no_go' %} title="Nous décidons de ne pas poursuivre cette opportunité"{% endif %}>{{ label }}</h2><span>{{ deals|filter(d => (view=='markets'?d.decision:d.status)==key)|length }}</span></header><div class="lane-cards">{% for d in deals %}{% if (view=='markets'?d.decision:d.status)==key %}{% include 'admin/crm/_card.html.twig' %}{% endif %}{% endfor %}</div></section>{% endfor %}</div>{% else %}
<div class="crm-card crm-table"><table><thead><tr><th>Affaire / société</th><th>Contact</th><th>{{ view=='markets'?'Décision':'Statut' }}</th><th>Prochaine action</th><th>Échéance</th><th>Origine</th></tr></thead><tbody>{% for d in deals %}<tr><td><a href="{{ path('admin_crm_show',{id:d.id}) }}"><strong>{{ d.title }}</strong></a><small>{{ d.organization ?: d.buyer ?: 'Société à préciser' }}</small></td><td>{{ d.contact ?: 'À préciser' }}<small>{{ d.email }}</small></td><td><span class="crm-badge">{{ view=='markets'?decisions[d.decision]:statuses[d.status] }}</span></td><td>{{ d.next_action ?: 'À définir' }}<small>{{ d.reminder?d.reminder|date('d/m/Y H:i','Europe/Paris'):'' }}</small></td><td>{{ d.deadline?d.deadline|date('d/m/Y H:i','Europe/Paris'):'—' }}</td><td>{{ {form:'Formulaire',email:'Email',watch:'Veille',manual:'Manuelle'}[d.origin] }} {{ d.site }}</td></tr>{% else %}<tr><td colspan="6">Aucune fiche. Modifiez les filtres ou ajoutez une affaire.</td></tr>{% endfor %}</tbody></table></div>{% endif %}
<div class="pagination">{% if mode=='list' %}{% if page>1 %}<a href="{{ path('admin_crm',app.request.query.all|merge({page:page-1})) }}">← Précédent</a>{% endif %}<span>Page {{ page }} · {{ total }} résultat(s)</span>{% if page*50<total %}<a href="{{ path('admin_crm',app.request.query.all|merge({page:page+1})) }}">Suivant →</a>{% endif %}{% else %}<span>{{ total }} fiche(s)</span>{% endif %}</div>
<details class="connections"><summary>Connexions et alimentation</summary><p>Demandes clients : formulaires OLING et MAPSI · Saisie manuelle disponible.</p><p>Outlook : {{ connections.email?'Connecté en lecture seule':'Désactivé' }} · Veille : {{ connections.watch?'Import activé':'Désactivée' }} · Tâches : {{ connections.scheduler?'Activées':'Désactivées' }}</p><p>Dernier passage Outlook : {{ sync.last_success|default('En attente') }} · Import veille : {{ watch.last_success|default('En attente') }}</p>{% if sync.next|default(null) %}<p>Lecture de l’historique en cours.</p>{% endif %}{% if sync.error|default(null) %}<p class="alert alert-danger">{{ sync.error }}</p>{% endif %}<p>Formulaires : {{ forms.pending|default(0) }} en attente de reprise · {{ forms.mapsi_notification_pending|default(0) }} notification(s) MAPSI à vérifier · Dernier traitement : {{ forms.last_success|default('En attente') }}</p><form method="post" action="{{ path('admin_crm_sync') }}"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><button {% if not connections.email or not connections.scheduler %}disabled{% endif %}>Relancer l’alimentation</button></form></details>
{% endblock %}

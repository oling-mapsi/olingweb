<section class="oling-cta-band">
  {% set currentLocale = app.request.locale|default('fr') %}
  {% set localizedRoutePaths = {
    contact: currentLocale == 'en' ? '/en/contact' : (currentLocale == 'es' ? '/es/contacto' : path('contact')),
    projets: currentLocale == 'en' ? '/en/projects' : (currentLocale == 'es' ? '/es/proyectos' : path('projets')),
    team: currentLocale == 'en' ? '/en/team' : (currentLocale == 'es' ? '/es/equipo' : path('team')),
    expertises_index: currentLocale == 'en' ? '/en/consulting-expertise' : (currentLocale == 'es' ? '/es/areas-de-especializacion' : path('expertises_index')),
    services_index: currentLocale == 'en' ? '/en/services' : (currentLocale == 'es' ? '/es/servicios-y-ofertas' : path('services_index'))
  } %}
  <div class="container">
    <div class="oling-cta-band__inner">
      <div>
        <span class="oling-kicker">{{ eyebrow|default('common.project_discussion'|trans) }}</span>
        <h2>{{ title }}</h2>
        <p>{{ text }}</p>
      </div>
      <div class="oling-cta-band__actions">
        {% set primaryRoute = primaryCta.route ?? 'contact' %}
        <a class="btn btn-primary" href="{{ localizedRoutePaths[primaryRoute]|default(null) ?: path(primaryRoute, primaryCta.routeParams|default({})) }}">{{ primaryCta.label }}</a>
        {% if secondaryCta is defined and secondaryCta %}
          {% set secondaryRoute = secondaryCta.route ?? 'contact' %}
          <a class="btn btn-outline-dark" href="{{ localizedRoutePaths[secondaryRoute]|default(null) ?: path(secondaryRoute, secondaryCta.routeParams|default({})) }}">{{ secondaryCta.label }}</a>
        {% endif %}
        {% if phoneCta is defined and phoneCta %}
          <a class="btn btn-outline-light" href="tel:+33189701560" data-demand-phone="owner" data-demand-location="final">{{ 'common.call_us'|trans }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

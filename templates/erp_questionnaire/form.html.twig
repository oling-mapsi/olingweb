{% extends 'base.html.twig' %}

{% set c = erpContent %}
{% block title %}{{ c.ui.form_title }}{% endblock %}
{% block meta_description %}{{ c.ui.form_meta_description }}{% endblock %}

{% block body %}
{% set v = values|default({}) %}
{% set labels = c.fields %}
{% set options = c.options %}
<main id="content" role="main" class="oling-seo-cabinet">
  <section class="oling-section oling-section--tight">
    <div class="container">
      <div class="oling-surface p-4 p-lg-5">
        <span class="oling-kicker">{{ c.ui.form_kicker }}</span>
        <h1 class="h2">{{ c.ui.form_h1 }}</h1>
        <p class="oling-lede mb-2">{{ c.ui.form_lede }}</p>
        <p class="mb-0">{{ c.ui.form_intro }}</p>
      </div>
    </div>
  </section>

  <section class="oling-section oling-section--tight">
    <div class="container">
      {% if errors is not empty %}
        <div class="alert alert-danger"><ul class="mb-0">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>
      {% endif %}

      <form method="post" class="oling-surface p-4 p-lg-5 erp-questionnaire">
        <input type="hidden" name="_token" value="{{ csrf_token('erp_questionnaire') }}">
        <input class="d-none" tabindex="-1" autocomplete="off" name="website" value="">

        <section class="mb-5">
          <span class="oling-kicker">{{ c.sections.identification }}</span>
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label">{{ labels.fullName }} *</label><input class="form-control" maxlength="160" name="fullName" value="{{ v.fullName|default('') }}" required></div>
            <div class="col-md-6"><label class="form-label">{{ labels.email }} *</label><input type="email" class="form-control" maxlength="180" name="email" value="{{ v.email|default('') }}" required></div>
            <div class="col-md-6"><label class="form-label">{{ labels.phone }} *</label><input class="form-control" maxlength="50" name="phone" value="{{ v.phone|default('') }}" required></div>
            <div class="col-md-6"><label class="form-label">{{ labels.company }} *</label><input class="form-control" maxlength="180" name="company" value="{{ v.company|default('') }}" required></div>
            <div class="col-md-6"><label class="form-label">{{ labels.jobTitle }}</label><input class="form-control" maxlength="160" name="jobTitle" value="{{ v.jobTitle|default('') }}"></div>
            <div class="col-md-6"><label class="form-label">{{ labels.sector }}</label><input class="form-control" maxlength="160" name="sector" value="{{ v.sector|default('') }}"></div>
          </div>
        </section>

        <section class="mb-5">
          <span class="oling-kicker">{{ c.sections.solution }}</span>
          <div class="row g-3">
            <div class="col-md-3"><label class="form-label">{{ labels.organizationSize }}</label><select class="form-select" name="organizationSize"><option value="">{{ options.common.unknown }}</option>{% for key in ['1_49','50_249','250_999','1000_plus'] %}<option value="{{ key }}" {{ v.organizationSize|default('') == key ? 'selected' : '' }}>{{ options.common[key] }}</option>{% endfor %}</select></div>
            <div class="col-md-3"><label class="form-label">{{ labels.userCount }}</label><select class="form-select" name="userCount"><option value="">{{ options.common.unknown }}</option>{% for key in ['1_49','50_249','250_999','1000_plus'] %}<option value="{{ key }}" {{ v.userCount|default('') == key ? 'selected' : '' }}>{{ options.common[key] }}</option>{% endfor %}</select></div>
            <div class="col-md-3"><label class="form-label">{{ labels.projectNature }}</label><select class="form-select" name="projectNature">{% for key in ['replacement','first_equipment','extension','rescue'] %}<option value="{{ key }}" {{ v.projectNature|default('replacement') == key ? 'selected' : '' }}>{{ options.common[key] }}</option>{% endfor %}</select></div>
            <div class="col-md-3"><label class="form-label">{{ labels.solutionType }} *</label><select class="form-select" name="solutionType" required><option value="">{{ options.common.choose }}</option>{% for key,label in options.solutionType %}<option value="{{ key }}" {{ v.solutionType|default('') == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
            <div class="col-md-4"><label class="form-label">{{ labels.hasExistingSolution }}</label><select class="form-select" name="hasExistingSolution" data-toggle-target="existing-block"><option value="yes" {{ v.hasExistingSolution|default('yes') == 'yes' ? 'selected' : '' }}>{{ options.common.yes }}</option><option value="no" {{ v.hasExistingSolution|default('') == 'no' ? 'selected' : '' }}>{{ options.common.no }}</option><option value="unknown" {{ v.hasExistingSolution|default('') == 'unknown' ? 'selected' : '' }}>{{ options.common.unknown }}</option></select></div>
            <div class="col-md-8 conditional" id="existing-block">
              <div class="row g-3">
                <div class="col-md-5"><label class="form-label">{{ labels.existingSolution }}</label><input class="form-control" maxlength="240" name="existingSolution" value="{{ v.existingSolution|default('') }}"></div>
                <div class="col-md-3"><label class="form-label">{{ labels.existingSolutionAge }}</label><select class="form-select" name="existingSolutionAge"><option value="">{{ options.common.unknown }}</option>{% for key in ['recent','mid','old'] %}<option value="{{ key }}" {{ v.existingSolutionAge|default('') == key ? 'selected' : '' }}>{{ options.common[key] }}</option>{% endfor %}</select></div>
                <div class="col-md-4"><label class="form-label">{{ labels.existingSolutionHosting }}</label><select class="form-select" name="existingSolutionHosting"><option value="">{{ options.common.unknown }}</option>{% for key in ['cloud','on_premise','hybrid','unknown'] %}<option value="{{ key }}" {{ v.existingSolutionHosting|default('') == key ? 'selected' : '' }}>{{ options.common[key] }}</option>{% endfor %}</select></div>
              </div>
            </div>
            <div class="col-12"><label class="form-label">{{ labels.context }} *</label><textarea class="form-control" maxlength="1200" rows="3" name="context" required>{{ v.context|default('') }}</textarea></div>
          </div>
        </section>

        <section class="mb-5">
          <span class="oling-kicker">{{ c.sections.scope }}</span>
          <div class="row g-3">
            <div class="col-12"><label class="form-label">{{ labels.need }} *</label><textarea class="form-control" maxlength="1200" rows="3" name="need" required>{{ v.need|default('') }}</textarea></div>
            <div class="col-12"><label class="form-label">{{ c.summary_titles.functional_scope }} *</label><div class="row g-2">{% for key,label in functionalOptions %}<div class="col-md-4"><label class="form-check"><input class="form-check-input" type="checkbox" name="functionalScope[]" value="{{ key }}" {{ key in v.functionalScope|default([]) ? 'checked' : '' }}> <span class="form-check-label">{{ label }}</span></label></div>{% endfor %}</div></div>
            <div class="col-12 conditional" id="finance-block"><label class="form-label">{{ labels.financeSpecific }}</label><textarea class="form-control" maxlength="800" rows="3" name="financeSpecific" placeholder="{{ options.common.finance_placeholder }}">{{ v.financeSpecific|default('') }}</textarea></div>
            <div class="col-md-6"><label class="form-label">{{ labels.irritants }} *</label><textarea class="form-control" maxlength="1200" rows="4" name="irritants" required placeholder="{{ options.common.irritants_placeholder }}">{{ v.irritants|default('') }}</textarea></div>
            <div class="col-md-6"><label class="form-label">{{ labels.scope }} *</label><textarea class="form-control" maxlength="1200" rows="4" name="scope" required>{{ v.scope|default('') }}</textarea></div>
          </div>
        </section>

        <section class="mb-5">
          <span class="oling-kicker">{{ c.sections.project }}</span>
          <div class="row g-3">
            <div class="col-md-3"><label class="form-label">{{ labels.projectMaturity }} *</label><select class="form-select" name="projectMaturity" required><option value="">Choisir</option>{% for key in ['idea','scoping','consultation','running','blocked'] %}<option value="{{ key }}" {{ v.projectMaturity|default('') == key ? 'selected' : '' }}>{{ options.common[key] }}</option>{% endfor %}</select></div>
            <div class="col-md-9 conditional" id="project-advanced-block"><div class="row g-3">
              <div class="col-md-4"><label class="form-label">{{ labels.hasSpecification }}</label><select class="form-select" name="hasSpecification"><option value="no">{{ options.common.no }}</option><option value="draft" {{ v.hasSpecification|default('') == 'draft' ? 'selected' : '' }}>{{ options.common.draft }}</option><option value="formalized" {{ v.hasSpecification|default('') == 'formalized' ? 'selected' : '' }}>{{ options.common.formalized }}</option></select></div>
              <div class="col-md-4"><label class="form-label">{{ labels.hasEditorIdentified }}</label><select class="form-select" name="hasEditorIdentified" data-toggle-target="editor-block"><option value="no">{{ options.common.no }}</option><option value="yes" {{ v.hasEditorIdentified|default('') == 'yes' ? 'selected' : '' }}>{{ options.common.yes }}</option><option value="unknown" {{ v.hasEditorIdentified|default('') == 'unknown' ? 'selected' : '' }}>{{ options.common.unknown }}</option></select></div>
              <div class="col-md-4"><label class="form-label">{{ labels.consultationStatus }}</label><select class="form-select" name="consultationStatus">{% for key in ['not_started','started','ongoing','unknown'] %}<option value="{{ key }}" {{ v.consultationStatus|default('not_started') == key ? 'selected' : '' }}>{{ options.common[key] }}</option>{% endfor %}</select></div>
            </div></div>
            <div class="col-12 conditional" id="editor-block"><label class="form-label">{{ labels.editorDetails }}</label><input class="form-control" maxlength="240" name="editorDetails" value="{{ v.editorDetails|default('') }}"></div>
            <div class="col-md-6"><label class="form-label">{{ labels.organization }} *</label><textarea class="form-control" maxlength="1000" rows="3" name="organization" required>{{ v.organization|default('') }}</textarea></div>
            <div class="col-md-3"><label class="form-label">{{ labels.sponsor }}</label><input class="form-control" maxlength="180" name="sponsor" value="{{ v.sponsor|default('') }}"></div>
            <div class="col-md-3"><label class="form-label">{{ labels.projectTeam }}</label><input class="form-control" maxlength="240" name="projectTeam" value="{{ v.projectTeam|default('') }}"></div>
            <div class="col-md-3"><label class="form-label">{{ labels.dataMigration }}</label><select class="form-select" name="dataMigration" data-toggle-target="migration-block"><option value="unknown">{{ options.common.unknown }}</option><option value="yes" {{ v.dataMigration|default('') == 'yes' ? 'selected' : '' }}>{{ options.common.yes }}</option><option value="no" {{ v.dataMigration|default('') == 'no' ? 'selected' : '' }}>{{ options.common.no }}</option></select></div>
            <div class="col-md-3"><label class="form-label">{{ labels.interfaceLevel }}</label><select class="form-select" name="interfaceLevel" data-toggle-target="interfaces-block">{% for key in ['none','few','several','many'] %}<option value="{{ key }}" {{ v.interfaceLevel|default('few') == key ? 'selected' : '' }}>{{ key == 'few' ? options.common.few_short : (key == 'many' ? options.common.many_short : options.common[key]) }}</option>{% endfor %}</select></div>
            <div class="col-md-6 conditional" id="migration-block"><label class="form-label">{{ labels.migrationDetails }}</label><textarea class="form-control" maxlength="800" rows="3" name="migrationDetails">{{ v.migrationDetails|default('') }}</textarea></div>
            <div class="col-md-6 conditional" id="interfaces-block"><label class="form-label">{{ labels.dataInterfaces }}</label><textarea class="form-control" maxlength="1000" rows="3" name="dataInterfaces">{{ v.dataInterfaces|default('') }}</textarea></div>
            <div class="col-md-6"><label class="form-label">{{ labels.securityRgpd }}</label><textarea class="form-control" maxlength="800" rows="3" name="securityRgpd">{{ v.securityRgpd|default('') }}</textarea></div>
            <div class="col-md-6"><label class="form-label">{{ labels.constraints }}</label><textarea class="form-control" maxlength="800" rows="3" name="constraints">{{ v.constraints|default('') }}</textarea></div>
          </div>
        </section>

        <section class="mb-4">
          <span class="oling-kicker">{{ c.sections.amoa }}</span>
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label">{{ labels.planning }} *</label><textarea class="form-control" maxlength="600" rows="3" name="planning" required>{{ v.planning|default('') }}</textarea></div>
            <div class="col-md-3"><label class="form-label">{{ labels.urgency }}</label><select class="form-select" name="urgency"><option value="">{{ options.common.unknown }}</option>{% for key in ['immediate','short_term','planned','exploratory'] %}<option value="{{ key }}" {{ v.urgency|default('') == key ? 'selected' : '' }}>{{ options.common[key] }}</option>{% endfor %}</select></div>
            <div class="col-md-3"><label class="form-label">{{ labels.budgetStatus }}</label><select class="form-select" name="budgetStatus"><option value="unknown">{{ options.common.unknown_budget }}</option><option value="known" {{ v.budgetStatus|default('') == 'known' ? 'selected' : '' }}>{{ options.common.known }}</option><option value="approx" {{ v.budgetStatus|default('') == 'approx' ? 'selected' : '' }}>{{ options.common.approximate }}</option><option value="confidential" {{ v.budgetStatus|default('') == 'confidential' ? 'selected' : '' }}>{{ options.common.confidential }}</option></select></div>
            <div class="col-md-4"><label class="form-label">{{ labels.budgetRange }}</label><select class="form-select" name="budgetRange"><option value="">{{ c.summary.confirm }}</option>{% for key in ['lt_15k','15_30k','30_60k','60k_plus','100k_plus'] %}<option value="{{ key }}" {{ v.budgetRange|default('') == key ? 'selected' : '' }}>{{ options.common[key] }}</option>{% endfor %}</select></div>
            <div class="col-md-8"><label class="form-label">{{ labels.amoaExpectations }} *</label><div class="row g-2">{% for key,label in options.amoaExpectations %}<div class="col-md-6"><label class="form-check"><input class="form-check-input" type="checkbox" name="amoaExpectations[]" value="{{ key }}" {{ key in v.amoaExpectations|default([]) ? 'checked' : '' }}> <span class="form-check-label">{{ label }}</span></label></div>{% endfor %}</div></div>
            <div class="col-12"><label class="form-check"><input class="form-check-input" type="checkbox" name="rgpdConsent" value="1" {{ v.rgpdConsent|default(false) ? 'checked' : '' }} required> <span class="form-check-label">{{ labels.rgpdConsent }} *</span></label></div>
          </div>
        </section>

        <button class="btn btn-primary btn-lg" type="submit">{{ c.ui.submit }}</button>
      </form>
    </div>
  </section>
</main>
<script>
document.querySelectorAll('[data-toggle-target]').forEach((select) => {
  const refresh = () => {
    const target = document.getElementById(select.dataset.toggleTarget);
    if (!target) return;
    const visible = (select.name === 'hasExistingSolution' && select.value === 'yes')
      || (select.name === 'dataMigration' && select.value === 'yes')
      || (select.name === 'interfaceLevel' && ['several', 'many'].includes(select.value))
      || (select.name === 'hasEditorIdentified' && select.value === 'yes');
    target.hidden = !visible;
  };
  select.addEventListener('change', refresh);
  refresh();
});
const refreshFinanceBlock = () => {
  const block = document.getElementById('finance-block');
  const solution = document.querySelector('[name="solutionType"]');
  if (!block || !solution) return;
  const checked = [...document.querySelectorAll('input[name="functionalScope[]"]:checked')].map((input) => input.value);
  block.hidden = !(solution.value === 'si_finance' || checked.includes('finance') || checked.includes('budget'));
};
document.querySelector('[name="solutionType"]')?.addEventListener('change', refreshFinanceBlock);
document.querySelectorAll('input[name="functionalScope[]"]').forEach((input) => input.addEventListener('change', refreshFinanceBlock));
refreshFinanceBlock();
const refreshProjectAdvancedBlock = () => {
  const block = document.getElementById('project-advanced-block');
  const maturity = document.querySelector('[name="projectMaturity"]');
  if (!block || !maturity) return;
  block.hidden = ['', 'idea'].includes(maturity.value);
};
document.querySelector('[name="projectMaturity"]')?.addEventListener('change', refreshProjectAdvancedBlock);
refreshProjectAdvancedBlock();
</script>
{% endblock %}

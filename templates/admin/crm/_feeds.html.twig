<div class="action-kpi footer-feed"><button class="kpi-trigger" type="button" aria-expanded="false" aria-controls="feed-status">Connexion et alimentation <span aria-hidden="true">ⓘ</span></button><div id="feed-status" class="kpi-popover" role="region" aria-label="État des alimentations" hidden><header><strong>Alimentations actives</strong><button class="kpi-close" type="button" aria-label="Fermer la liste">×</button></header><ul>{% for feed in crm_feed_status() %}<li><strong>{{ feed.name }}</strong><p>{{ feed.status }}</p><small>{{ feed.detail }}{% if feed.date %} · <time datetime="{{ feed.date }}">{{ feed.date|date('d/m/Y H:i','Europe/Paris') }}</time>{% endif %}</small></li>{% else %}<li>Aucune alimentation active dans cet environnement.</li>{% endfor %}</ul></div></div>

{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}
{% block canonical_url %}{{ app.request.schemeAndHttpHost ~ canonicalPath|default(app.request.pathInfo) }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/hub-heroes.css') }}?v=20261017b">
{% endblock %}

{% block body %}
{% set locale = app.request.locale|default('fr') %}
{% set ui = {
  fr: {primary: 'Échanger sur votre contexte', secondary: 'Voir nos expertises', sector: 'Secteur d’activité', specifics: 'Enjeux métier :', missions: 'Missions associées :', more: 'Découvrir notre accompagnement', empty: 'Aucun secteur n’est disponible pour le moment.', angles: 'Nos accompagnements', angles_title: 'Transformation SI, organisation et conformité', angles_text: 'Industrie, services et organisations réglementées : découvrez les enjeux et les expertises associés à votre activité.', vigilance: 'Enjeux métier :', page: 'Voir la page'},
  en: {primary: 'Discuss your context', secondary: 'View our expertise', sector: 'Sector served', specifics: 'Business priorities:', missions: 'Related assignments:', more: 'View the related approach', empty: 'No sector is available at the moment.', angles: 'Sector angles', angles_title: 'IT, organisation and compliance support', angles_text: 'Explore our work with manufacturers, service businesses and regulated organisations.', vigilance: 'Points of attention:', page: 'View page'},
  es: {primary: 'Hablar de su contexto', secondary: 'Ver nuestras especializaciones', sector: 'Sector atendido', specifics: 'Prioridades del sector:', missions: 'Misiones asociadas:', more: 'Ver el enfoque asociado', empty: 'No hay sectores disponibles por el momento.', angles: 'Enfoques sectoriales', angles_title: 'Sistemas de información, organización y cumplimiento normativo', angles_text: 'Consulte nuestro acompañamiento a industriales, empresas de servicios y organizaciones reguladas.', vigilance: 'Puntos de vigilancia:', page: 'Ver página'}
}[locale]|default({}) %}
<main id="content" role="main" class="oling-public-editorial oling-public-editorial--sectors-hub">
  {% set indexPage = page %}
  {% include 'public/_page_hero.html.twig' with {
    mediaFrame: indexPage.heroFrame|default('none'),
    variant: 'hub-sectors',
    eyebrow: indexPage.eyebrow,
    title: indexPage.title,
    intro: indexPage.intro,
    primaryCta: {route: 'contact', label: ui.primary},
    secondaryCta: {route: 'expertises_index', label: ui.secondary},
    highlights: indexPage.highlights,
    image: indexPage.heroImage|default(null),
    imageAlt: indexPage.heroImageAlt|default(indexPage.title),
    imageCaption: indexPage.heroImageCaption|default(null),
    imageFocalPoint: indexPage.heroImageFocalPoint|default(null),
    imageDisplayMode: indexPage.heroImageDisplayMode|default('auto'),
    imageSize: indexPage.heroImageSize|default('auto')
  } %}

  <section class="oling-shell-section oling-sectors-overview">
    <div class="container">
      <div class="oling-section-head">
        <span class="oling-kicker">{{ indexPage.section.kicker }}</span>
        <h2>{{ indexPage.section.title }}</h2>
        <p>{{ indexPage.section.text }}</p>
      </div>
      <div class="oling-sectors-grid">
        {% for sector in sectorCatalog %}
          {% set tag = 'article' %}
          <{{ tag }} class="oling-sector-card{{ sector.heroImage ? ' oling-sector-card--photographic' : '' }}">
            <div class="oling-sector-card__visual" aria-hidden="true">
              {% if sector.heroImage %}
                <img src="{{ asset(sector.heroImage) }}" alt="" width="640" height="360" loading="lazy" decoding="async">
              {% endif %}
              <span class="oling-sector-card__index">{{ '%02d'|format(loop.index) }}</span>
              <span class="oling-sector-card__line"></span>
            </div>
            <div class="oling-sector-card__body">
              <span class="oling-kicker">{{ ui.sector }}</span>
              <h2>{% if sector.detailUrl %}<a class="text-reset text-decoration-none" href="{{ sector.detailUrl }}">{{ sector.designation }}</a>{% else %}{{ sector.designation }}{% endif %}</h2>
              <p class="oling-sector-card__intro">{{ sector.intro }}</p>
              {% if sector.specifics is not empty %}
                <div class="oling-sector-card__details">
                  <span class="oling-sector-card__caption"><strong>{{ ui.specifics }}</strong></span>
                  <ul class="oling-sector-card__specifics">
                    {% for specific in sector.specifics %}
                      <li>{{ specific }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              {% for reference in sector.references|default([]) %}
                <p class="oling-sector-card__caption"><a href="{{ reference.href }}">{{ reference.title }}</a></p>
              {% endfor %}
              <div class="oling-sector-card__footer">
                {% if sector.detailUrl %}
                  <a class="oling-sector-card__more" href="{{ sector.detailUrl }}">{{ ui.more }} <span aria-hidden="true">↗</span></a>
                {% endif %}
              </div>
            </div>
          </{{ tag }}>
        {% else %}
          <div class="oling-surface oling-surface--light">
            <p class="mb-0">{{ ui.empty }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {% if sectorPages is not empty %}
    <section class="oling-shell-section oling-shell-section--tint oling-sectors-angles-section">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ ui.angles }}</span>
          <h2>{{ ui.angles_title }}</h2>
          <p>{{ ui.angles_text }}</p>
        </div>
        <div class="oling-sector-angles">
          {% for slug, sectorPage in sectorPages %}
            <a class="oling-sector-angle" href="{{ sectorPage.href|default(path('sectors_show', {slug: slug})) }}">
              <div class="oling-sector-angle__top">
                <span class="oling-kicker">{{ sectorPage.eyebrow }}</span>
                <span class="oling-sector-angle__index" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
              </div>
              <h2>{{ sectorPage.title }}</h2>
              <p>{{ sectorPage.intro }}</p>
              {% if sectorPage.issues is not empty %}
                <p class="oling-sector-angle__issues"><strong>{{ ui.vigilance }}</strong> {{ sectorPage.issues|slice(0, 2)|join(' · ') }}</p>
              {% endif %}
              <span class="oling-sector-angle__more">{{ ui.page }} <span aria-hidden="true">↗</span></span>
            </a>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% include 'public/_cta_band.html.twig' with {
    title: indexPage.cta.title,
    text: indexPage.cta.text,
    primaryCta: indexPage.cta.primaryCta
  } %}
</main>
{% endblock %}

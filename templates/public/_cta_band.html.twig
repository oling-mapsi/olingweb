<section class="oling-cta-band">
  <div class="container">
    <div class="oling-cta-band__inner">
      <div>
        <span class="oling-kicker">{{ eyebrow|default('Parlons de votre projet') }}</span>
        <h2>{{ title }}</h2>
        <p>{{ text }}</p>
      </div>
      <div class="oling-cta-band__actions">
        <a class="btn btn-primary" href="{{ path(primaryCta.route, primaryCta.routeParams|default({})) }}">{{ primaryCta.label }}</a>
        {% if secondaryCta is defined and secondaryCta %}
          <a class="btn btn-outline-dark" href="{{ path(secondaryCta.route, secondaryCta.routeParams|default({})) }}">{{ secondaryCta.label }}</a>
        {% endif %}
        {% if phoneCta is defined and phoneCta %}
          <a class="btn btn-outline-light" href="tel:+33189701560" data-demand-phone="owner" data-demand-location="final">Ou appelez-nous au 01 89 70 15 60</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

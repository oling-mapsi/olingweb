{% extends 'base.html.twig' %}{% block title %}Classifications et associations à valider | Admin{% endblock %}{% block body %}{% include 'admin/business/_style.html.twig' %}<main class="admin"><a href="{{ path('admin_catalogue_index',{type:'service'}) }}">← Expertises & prestations</a><h1>Classifications et associations à valider</h1><p class="cms-intro">25 classifications et 27 rapprochements. Aucun avis n’applique une relation.</p><div class="cms-business-note">{{ reviewEnabled ? 'Recette privée : avis conservés avec administrateur, date et empreinte de la proposition.' : 'Validation désactivée dans cet environnement.' }} Les classifications et associations nécessitent une autorisation distincte avant application.</div>
{% for category,label in {'classification':'Classifications des Practices','association':'Associations de pages'} %}<section><h2>{{ label }}</h2>{% for key,card in cards %}{% if key starts with category~':' %}<article class="cms-business-review" data-review-key="{{ key }}"><h3>{{ card.source.title }} → {{ card.target }}</h3><p>{{ card.role }} · {{ card.reason }}</p><span class="cms-business-badge">{{ card.state }}</span>{% if card.decision %}<p data-durable-opinion>{{ {'approved':'Avis favorable','rejected':'Avis défavorable','pending':'À revoir'}[card.decision.opinion] }} · {{ card.decision.actor }} · {{ card.decision.at }} · non appliqué</p>{% else %}<p>Aucun avis enregistré.</p>{% endif %}<details><summary>Détails de la proposition</summary><p>{{ key }} · {{ card.source.url }} · Empreinte <code>{{ card.hash }}</code></p></details>{% if not card.blocked and reviewEnabled %}<form method="post" action="{{ path('admin_catalogue_business_decision_save') }}"><input type="hidden" name="_token" value="{{ csrf_token('business-review') }}"><input type="hidden" name="key" value="{{ key }}"><input type="hidden" name="hash" value="{{ card.hash }}"><label for="opinion-{{ key|replace({':':'-'}) }}">Avis individuel</label><select id="opinion-{{ key|replace({':':'-'}) }}" name="opinion" class="form-select"><option value="pending">À revoir</option><option value="approved">Favorable</option><option value="rejected">Défavorable</option></select><button type="submit" class="btn btn-outline-primary btn-sm mt-2">Enregistrer l’avis privé</button></form>{% elseif card.blocked %}<p>Rapprochement rejeté par l’audit — application bloquée.</p>{% endif %}</article>{% endif %}{% endfor %}</section>{% endfor %}</main>{% endblock %}

<div class="oling-section-head"><span class="oling-kicker">Le portefeuille OLING</span><h2 id="catalogue-title">Toutes nos références</h2><p>Des missions ponctuelles aux programmes complexes : explorez les interventions par secteur et expertise.</p><p class="oling-catalogue-count" role="status"><strong>{{ catalogue.total }}</strong> référence{{ catalogue.total > 1 ? 's' : '' }}{{ catalogue.sector or catalogue.domain ? ' sur ' ~ catalogue.allTotal : '' }} · {{ catalogue.from }}–{{ catalogue.to }} affichées</p></div>
<form method="get" action="{{ path('projets') }}#catalogue" class="oling-catalogue-filters">
<label>Secteur<select name="secteur"><option value="">Tous les secteurs</option>{% for value,label in catalogue.sectors %}<option value="{{ value }}"{{ catalogue.sector == value ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Domaine d’expertise<select name="expertise"><option value="">Toutes les expertises</option>{% for value,label in catalogue.domains %}<option value="{{ value }}"{{ catalogue.domain == value ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Par page<select name="par_page">{% for n in [12,24] %}<option value="{{ n }}"{{ catalogue.perPage == n ? ' selected' : '' }}>{{ n }} références</option>{% endfor %}</select></label><button type="submit" class="btn btn-primary">Filtrer</button><a href="{{ path('projets') }}#catalogue">Réinitialiser</a></form>
{% include 'projets/_catalogue_cards.html.twig' %}
{% if catalogue.pages > 1 %}<nav class="oling-catalogue-pagination" aria-label="Pagination des références">{% for number in 1..catalogue.pages %}<a href="{{ path('projets', {secteur:catalogue.sector,expertise:catalogue.domain,par_page:catalogue.perPage,page:number}) }}#catalogue"{% if number == catalogue.page %} aria-current="page"{% endif %}>{{ number }}</a>{% endfor %}</nav>{% endif %}

{% extends 'base.html.twig' %}

{% block title %}Parametres Growth | Admin{% endblock %}
{% block meta_description %}Parametres avances Growth{% endblock %}

{% block body %}
<main id="content" role="main" class="admin">
  <div class="container content-space-2 content-space-lg-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
      <div>
        <h1 class="h3 mb-1">Parametres Growth</h1>
        <p class="text-muted mb-0">Fonctions avancees conservees dans Growth Factory.</p>
      </div>
      <a class="btn btn-outline-primary btn-sm" href="{{ path('admin_growth_index') }}">Retour au studio</a>
    </div>

    {% include 'admin/_nav.html.twig' %}

    {% if not available %}
      <div class="alert alert-warning">Growth indisponible : {{ message }}</div>
    {% endif %}

    <section class="card mb-4">
      <div class="card-body">
        <h2 class="h5">Canaux</h2>
        <div class="row g-3">
          {% for channel in channels %}
            <div class="col-lg-4">
              <div class="border rounded p-3 h-100">
                <div class="d-flex justify-content-between gap-2">
                  <strong>{{ channel.label|default(channel.key|default('Canal')) }}</strong>
                  <span class="badge {{ channel.enabled|default(false) and not channel.emergency_kill_switch|default(false) ? 'bg-success' : 'bg-secondary' }}">{{ channel.enabled|default(false) ? 'actif' : 'inactif' }}</span>
                </div>
                <div class="small text-muted mt-2">{{ channel.asset_types|default([])|join(', ') }}</div>
                <form method="post" action="{{ path('admin_growth_channel_health_check', {channel: channel.key}) }}" class="mt-3">
                  <input type="hidden" name="_token" value="{{ csrf_token('growth_channel_' ~ channel.key) }}">
                  <button class="btn btn-sm btn-outline-primary">Tester le canal</button>
                </form>
              </div>
            </div>
          {% else %}
            <div class="col-12 text-muted">Parametres des canaux indisponibles.</div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="card mb-4">
      <div class="card-body">
        <h2 class="h5">Fonctions avancees</h2>
        <div class="row g-3">
          <div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Campagnes</div><strong>{{ dashboard.campaigns_total|default(0) }}</strong></div></div>
          <div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Assets a valider</div><strong>{{ dashboard.assets_pending_validation|default(0) }}</strong></div></div>
          <div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Weekly Packs</div><strong>{{ weekly_packs|length }}</strong></div></div>
          <div class="col-md-3"><div class="border rounded p-3"><div class="small text-muted">Historique avance</div><strong>{{ advanced_campaigns|length }}</strong></div></div>
        </div>
      </div>
    </section>

    <section class="card mb-4">
      <div class="card-body">
        <h2 class="h5">Audit recent</h2>
        <div class="table-responsive">
          <table class="table table-sm">
            <thead><tr><th>Evenement</th><th>Acteur</th><th>Resultat</th><th>Date</th></tr></thead>
            <tbody>
              {% for event in audit_events %}
                <tr>
                  <td>{{ event.event_type|default('') }}</td>
                  <td>{{ event.actor_id|default('') }}</td>
                  <td>{{ event.result|default('') }}</td>
                  <td>{{ event.created_at|default('') }}</td>
                </tr>
              {% else %}
                <tr><td colspan="4" class="text-muted">Aucun evenement d'audit disponible.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-body">
        <h2 class="h5">Backlog de parite</h2>
        <div class="table-responsive">
          <table class="table table-sm">
            <thead><tr><th>Fonction</th><th>Etat</th><th>Phase</th></tr></thead>
            <tbody>
              {% for row in parity_matrix %}
                <tr><td>{{ row.feature }}</td><td>{{ row.status }}</td><td>{{ row.phase }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</main>
{% endblock %}

<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
{% set currentRoute = app.request.attributes.get('_route') %}
{% set currentSlug = app.request.attributes.get('slug') %}
{% set currentPracticeSlug = app.request.attributes.get('practice') %}
{% set currentLocale = app.request.locale|default('fr') %}
{% set navHomePath = currentLocale == 'en' ? '/en' : (currentLocale == 'es' ? '/es' : path('index')) %}
{% set navAboutPath = currentLocale == 'en' ? '/en/about' : (currentLocale == 'es' ? '/es/quienes-somos' : path('apropos')) %}
{% set navExpertisesPath = currentLocale == 'en' ? '/en/areas-of-expertise' : (currentLocale == 'es' ? '/es/areas-de-especializacion' : path('expertises_index')) %}
{% set navServicesPath = currentLocale == 'en' ? '/en/services' : (currentLocale == 'es' ? '/es/servicios-y-ofertas' : path('services_index')) %}
{% set navSectorsPath = currentLocale == 'en' ? '/en/industries' : (currentLocale == 'es' ? '/es/sectores' : path('sectors_index')) %}
{% set navProjectsPath = currentLocale == 'en' ? '/en/projects' : (currentLocale == 'es' ? '/es/proyectos' : path('projets')) %}
{% set navTeamPath = currentLocale == 'en' ? '/en/team' : (currentLocale == 'es' ? '/es/equipo' : path('team')) %}
{% set navContactPath = currentLocale == 'en' ? '/en/contact' : (currentLocale == 'es' ? '/es/contacto' : path('contact')) %}
{% set navResourcesPath = currentLocale == 'en' ? '/en/resources' : (currentLocale == 'es' ? '/es/recursos' : path('seo_resources_index')) %}
{% set languageAlternates = localizedAlternates|default({}) %}
{% set languageLocales = {'fr': 'FR', 'en': 'EN', 'es': 'ES'} %}
{% set languageNames = {'fr': 'Français', 'en': 'English', 'es': 'Español'} %}
{% set languageAriaLabel = currentLocale == 'en' ? 'Change language' : (currentLocale == 'es' ? 'Cambiar idioma' : 'Changer de langue') %}
{% set legalLanguageRoutes = {
    'discloser': {'fr': 'discloser', 'en': 'discloser_en', 'es': 'discloser_es'},
    'discloser_en': {'fr': 'discloser', 'en': 'discloser_en', 'es': 'discloser_es'},
    'discloser_es': {'fr': 'discloser', 'en': 'discloser_en', 'es': 'discloser_es'},
    'polrgpd': {'fr': 'polrgpd', 'en': 'polrgpd_en', 'es': 'polrgpd_es'},
    'polrgpd_en': {'fr': 'polrgpd', 'en': 'polrgpd_en', 'es': 'polrgpd_es'},
    'polrgpd_es': {'fr': 'polrgpd', 'en': 'polrgpd_en', 'es': 'polrgpd_es'},
    'polsecurite': {'fr': 'polsecurite', 'en': 'polsecurite_en', 'es': 'polsecurite_es'},
    'polsecurite_en': {'fr': 'polsecurite', 'en': 'polsecurite_en', 'es': 'polsecurite_es'},
    'polsecurite_es': {'fr': 'polsecurite', 'en': 'polsecurite_en', 'es': 'polsecurite_es'},
    'charte_ia': {'fr': 'charte_ia', 'en': 'charte_ia_en', 'es': 'charte_ia_es'},
    'charte_ia_en': {'fr': 'charte_ia', 'en': 'charte_ia_en', 'es': 'charte_ia_es'},
    'charte_ia_es': {'fr': 'charte_ia', 'en': 'charte_ia_en', 'es': 'charte_ia_es'}
} %}
{% set switcherAlternates = languageAlternates %}
{% if currentRoute in legalLanguageRoutes|keys %}
    {% set switcherAlternates = {
        'fr': path(legalLanguageRoutes[currentRoute].fr),
        'en': path(legalLanguageRoutes[currentRoute].en),
        'es': path(legalLanguageRoutes[currentRoute].es)
    } %}
{% endif %}
{% set isAdminPage = currentRoute starts with 'admin_' or currentRoute == 'login' or app.request.pathinfo starts with '/admin' or app.request.pathinfo starts with '/login' %}
{% set expertisesActive = currentRoute in ['expertises_index', 'expertises_show'] or (currentRoute == 'practice_home' and currentSlug in ['consulting', 'expertises-audit', 'business-apps']) or (currentRoute == 'service' and currentPracticeSlug in ['consulting', 'expertises-audit', 'business-apps']) or (currentRoute == 'practice' and currentSlug in ['consulting', 'expertises-audit', 'business-apps']) %}
{% set navigationUniverses = [
    {
        title: 'nav.universes.amoa.title',
        href: navServicesPath ~ '#amoa-applications-metiers',
        items: [
            {label: 'nav.universes.amoa.items.amoa_si', href: path('amoa_si')},
            {label: 'nav.universes.amoa.items.erp', href: '/business-apps/erp'},
            {label: 'nav.universes.amoa.items.crm', href: '/crm'},
            {label: 'nav.universes.amoa.items.gmao', href: '/gmao'},
            {label: 'nav.universes.amoa.items.finance', href: '/si-finance'},
            {label: 'nav.universes.amoa.items.e_invoice', href: '/facturation-electronique-amoa'},
            {label: 'nav.universes.amoa.items.data_bi', href: '/business-apps/bi-et-analytique'},
            {label: 'nav.universes.amoa.items.ai_automation', href: '/business-apps/transformation-digitale-automatisation-et-ia-utile'}
        ]
    },
    {
        title: 'nav.universes.governance.title',
        href: navServicesPath ~ '#gouvernance-performance-dsi',
        items: [
            {label: 'nav.universes.governance.items.strategy', href: '/consulting/plan-strategique'},
            {label: 'nav.universes.governance.items.pmo', href: '/consulting/pilotage-des-plans'},
            {label: 'nav.universes.governance.items.process', href: '/consulting/management-des-processus'},
            {label: 'nav.universes.governance.items.data_governance', href: '/consulting/gouvernance-des-donnees'},
            {label: 'nav.universes.governance.items.infrastructure', href: '/infrastructure-si-amoa'},
            {label: 'nav.universes.governance.items.dsi', href: '/dsi-externalisee'}
        ]
    },
    {
        title: 'nav.universes.risk.title',
        href: navServicesPath ~ '#conformite-risques-resilience',
        items: [
            {label: 'nav.universes.risk.items.rgpd', href: '/expertises-audit/rgpd'},
            {label: 'nav.universes.risk.items.cyber', href: '/cyber-securite'},
            {label: 'nav.universes.risk.items.pca', href: '/pca-pra-continuite-activite'},
            {label: 'nav.universes.risk.items.qse', href: '/expertises-audit/qse'},
            {label: 'nav.universes.risk.items.risk_control', href: '/gestion-risques-audit-controle-interne'},
            {label: 'nav.universes.risk.items.ai_act', href: '/expertises-audit/conformite-ia-gouvernance-et-ai-act'}
        ]
    }
] %}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="robots" content="{% if currentRoute starts with 'admin_' or currentRoute in ['login', 'logout', 'growth_preview_article'] or app.request.pathinfo starts with '/admin' or app.request.pathinfo starts with '/login' or app.request.pathinfo starts with '/logout' or app.request.pathinfo starts with '/preview/' %}noindex,nofollow{% else %}index,follow,max-image-preview:large{% endif %}" />
    <title>{% block title %}{% endblock %}</title>
    <link rel="shortcut icon" href="/favicon.ico">
    {% set meta_description %}{% block meta_description %}{% endblock %}{% endset %}
    <meta name="description" content="{{ meta_description|striptags|trim }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Teko:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="canonical" href="{% block canonical_url %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}" />
    {% set hreflangAlternates = localizedAlternates|default({'fr': app.request.pathInfo, 'x-default': app.request.pathInfo}) %}
    {% for hreflangLocale, hreflangPath in hreflangAlternates %}
      <link rel="alternate" hreflang="{{ hreflangLocale }}" href="{{ app.request.schemeAndHttpHost ~ hreflangPath }}" />
    {% endfor %}
    <meta property="og:title" content="{{ block('title')|striptags|trim }}">
    <meta property="og:description" content="{{ meta_description|striptags|trim }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
    {% set social_image_url %}{% block social_image_url %}{{ absolute_url(asset('images/social/oling-expertises-si-conformite-2026.png')) }}{% endblock %}{% endset %}
    {% set social_image_type %}{% block social_image_type %}image/png{% endblock %}{% endset %}
    {% set social_image_width %}{% block social_image_width %}1200{% endblock %}{% endset %}
    {% set social_image_height %}{% block social_image_height %}627{% endblock %}{% endset %}
    <meta property="og:image" content="{{ social_image_url|trim }}">
    <meta property="og:image:secure_url" content="{{ social_image_url|trim }}">
    <meta property="og:image:type" content="{{ social_image_type|trim }}">
    <meta property="og:image:width" content="{{ social_image_width|trim }}">
    <meta property="og:image:height" content="{{ social_image_height|trim }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title')|striptags|trim }}">
    <meta name="twitter:description" content="{{ meta_description|striptags|trim }}">
    <meta name="twitter:image" content="{{ social_image_url|trim }}">
    <meta name="theme-color" content="#2F5D62">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    <style>
      @media (min-width: 992px) {
        .oling-header .hs-has-mega-menu > .oling-mega-menu--needs {
          left: 0 !important;
          transform: none !important;
        }

        .oling-language-switcher {
          margin-left: 0.35rem;
        }
      }

      .oling-language-switcher__toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        min-height: 2.25rem;
        padding: 0.42rem 0.65rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: rgba(255, 255, 255, 0.86);
        background: rgba(255, 255, 255, 0.08);
        font-size: 0.78rem;
        font-weight: 700;
        text-decoration: none;
      }

      .oling-language-switcher__toggle:hover,
      .oling-language-switcher__toggle:focus,
      .oling-language-switcher__toggle.show {
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.36);
        background: rgba(255, 255, 255, 0.14);
      }

      .oling-language-switcher__toggle:focus-visible,
      .oling-language-switcher .dropdown-item:focus-visible {
        outline: 2px solid rgba(255, 255, 255, 0.92);
        outline-offset: 2px;
      }

      .oling-language-switcher__menu {
        min-width: 8.25rem;
        padding: 0.35rem;
        border: 1px solid rgba(15, 23, 42, 0.1);
        border-radius: 0.65rem;
      }

      .oling-language-switcher__menu .dropdown-item {
        border-radius: 0.45rem;
        font-size: 0.85rem;
        font-weight: 600;
      }

      .oling-language-switcher__menu .dropdown-item.active,
      .oling-language-switcher__menu .dropdown-item:active {
        color: #111827;
        background: rgba(47, 93, 98, 0.12);
      }

      .oling-language-switcher__menu .dropdown-item.disabled {
        color: rgba(17, 24, 39, 0.38);
      }

      body.oling-body.oling-home .oling-header .nav-link,
      body.oling-body.oling-home .oling-header .nav-link:visited,
      body.oling-body.oling-home .oling-header .mapsi-link,
      body.oling-body.oling-home .oling-header .oling-language-switcher__toggle,
      body.oling-body.oling-home .oling-header .oling-language-switcher__toggle:visited {
        color: #f5f8ff !important;
      }

      body.oling-body.oling-home .oling-header .nav-link.active,
      body.oling-body.oling-home .oling-header .nav-link:hover,
      body.oling-body.oling-home .oling-header .nav-link:focus,
      body.oling-body.oling-home .oling-header .oling-language-switcher__toggle:hover,
      body.oling-body.oling-home .oling-header .oling-language-switcher__toggle:focus,
      body.oling-body.oling-home .oling-header .oling-language-switcher__toggle.show {
        color: #ffffff !important;
        background: rgba(255, 255, 255, 0.08) !important;
      }

      @media (max-width: 991.98px) {
        .oling-header .oling-topbar {
          position: relative;
          width: 100%;
        }

        .oling-header .navbar-nav-wrap-col.collapse.show {
          position: absolute;
          top: calc(100% + 0.5rem);
          left: 0;
          right: 0;
          width: 100%;
          max-height: calc(100vh - 6.5rem);
          overflow-y: auto;
        }

        .oling-header .oling-mobile-mega__group,
        .oling-header .oling-mobile-mega__all {
          color: #ffffff !important;
          white-space: normal;
          overflow-wrap: anywhere;
        }

        .oling-header .oling-mobile-mega__link {
          color: rgba(255, 255, 255, 0.78) !important;
          white-space: normal;
          overflow-wrap: anywhere;
        }

        .oling-shell-hero h1 {
          max-width: 100%;
          font-size: clamp(2.15rem, 11vw, 3rem) !important;
          line-height: 1.08;
          letter-spacing: 0 !important;
          white-space: normal;
          overflow-wrap: anywhere;
          word-break: normal;
        }

        .oling-shell-hero__inner {
          width: min(100%, calc(100vw - 1.5rem));
          margin-inline: auto;
          overflow: hidden;
        }

        .oling-shell-hero__copy,
        .oling-shell-hero__intro {
          min-width: 0;
          max-width: 100%;
        }

        body.oling-body.oling-home .navbar-nav-wrap-col .nav-link,
        body.oling-body.oling-home .navbar-nav-wrap-col .nav-link:visited,
        body.oling-body.oling-home .navbar-nav-wrap-col .mymenulink,
        body.oling-body.oling-home .navbar-nav-wrap-col .mapsi-link,
        body.oling-body.oling-home .navbar-nav-wrap-col .oling-language-switcher__toggle,
        body.oling-body.oling-home .navbar-nav-wrap-col .oling-language-switcher__toggle:visited {
          color: #f5f8ff !important;
        }

        body.oling-body.oling-home .navbar-nav-wrap-col .nav-link:hover,
        body.oling-body.oling-home .navbar-nav-wrap-col .nav-link:focus,
        body.oling-body.oling-home .navbar-nav-wrap-col .mymenulink:hover,
        body.oling-body.oling-home .navbar-nav-wrap-col .mymenulink:focus,
        body.oling-body.oling-home .navbar-nav-wrap-col .oling-language-switcher__toggle:hover,
        body.oling-body.oling-home .navbar-nav-wrap-col .oling-language-switcher__toggle:focus,
        body.oling-body.oling-home .navbar-nav-wrap-col .oling-language-switcher__toggle.show {
          color: #ffffff !important;
          background: rgba(255, 255, 255, 0.08) !important;
        }
      }

      {% if app.request.pathinfo in ['/pca-pra-continuite-activite', '/expertises-audit/qse'] %}
        @media (min-width: 992px) and (max-width: 1199.98px) {
          .oling-header .oling-main-menu__cta {
            display: none !important;
          }
        }
      {% endif %}
    </style>
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": "https://oling.fr/#professional-service",
      "name": "OLING Management et Technologie",
      "url": "https://oling.fr",
      "mainEntityOfPage": "https://oling.fr/",
      "logo": "https://oling.fr/img/logo/logoling.png",
      "description": "{{ 'schema.organization.description'|trans|e('js') }}",
      "areaServed": ["France", "Guadeloupe", "Martinique", "Guyane", "Réunion", "Saint-Pierre-et-Miquelon"],
      "email": "contact@oling.fr",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "email": "contact@oling.fr",
        "url": "https://oling.fr/contact",
        "availableLanguage": ["{{ currentLocale == 'en' ? 'en-US' : (currentLocale == 'es' ? 'es-ES' : 'fr-FR') }}"]
      },
      "address": [
        {% for agency in agencies %}
        {
          "@type": "PostalAddress",
          "streetAddress": "{{ agency.streetAddress|e('js') }}",
          "postalCode": "{{ agency.postalCode|e('js') }}",
          "addressLocality": "{{ agency.city|e('js') }}",
          "addressCountry": "{{ (agency.countryCode ?: agency.country)|e('js') }}"
        }{{ not loop.last ? ',' }}
        {% endfor %}
      ],
      "sameAs": [
        {% for sameAsUrl in oling_schema_same_as %}
        "{{ sameAsUrl|e('js') }}"{{ not loop.last ? ',' }}
        {% endfor %}
      ]
    }
    </script>
</head>
<body class="oling-body{% if not isAdminPage %} oling-refresh{% endif %}{% if app.request.pathinfo == '/' or currentRoute == 'localized_homepage' %} oling-home{% endif %}{% if isAdminPage %} admin{% endif %}{% block body_class %}{% endblock %}" data-ga-id="G-1EN73LS1B3">
    {% if not isAdminPage %}
    <header id="header" class="oling-header navbar navbar-expand-lg navbar-show-hide"
            data-hs-header-options='{"fixMoment": 0, "fixEffect": "slide"}'>
        <div class="container">
            <nav class="js-mega-menu navbar-nav-wrap oling-topbar">
                <a class="navbar-brand oling-brand" href="{{ navHomePath }}" aria-label="OLING">
                    <img src="{{ asset('/img/logo/logoling.png') }}" alt="Logo OLING">
                </a>

                <button type="button" class="navbar-toggler ms-auto d-print-none" data-bs-toggle="collapse" data-bs-target="#navbarNavMenuLeftAligned" aria-label="{{ 'nav.open_menu'|trans }}" aria-expanded="false" aria-controls="navbarNavMenuLeftAligned">
                    <span class="navbar-toggler-default d-print-none"><i class="bi-list"></i></span>
                    <span class="navbar-toggler-toggled d-print-none"><i class="bi-x"></i></span>
                </button>

                <div class="navbar-nav-wrap-col collapse navbar-collapse d-print-none" id="navbarNavMenuLeftAligned">
                    <ul class="navbar-nav oling-main-menu align-items-lg-center">
                        <li class="hs-has-mega-menu nav-item"
                            data-hs-mega-menu-item-options='{"desktop":{"position":"left"}}'>
                            <a id="expertisesMegaMenu"
                               class="hs-mega-menu-invoker hs-mega-menu__invoker nav-link {% if expertisesActive %}active{% endif %}"
                               href="{{ navExpertisesPath }}"
                               aria-expanded="false">{{ 'nav.expertises'|trans }}</a>
                            <div class="oling-mobile-mega d-lg-none">
                                {% for universe in navigationUniverses %}
                                    <a class="oling-mobile-mega__group" href="{{ universe.href }}">{{ universe.title|trans }}</a>
                                    <div class="oling-mobile-mega__links">
                                        {% for item in universe.items %}
                                            <a class="oling-mobile-mega__link" href="{{ item.href }}">{{ item.label|trans }}</a>
                                        {% endfor %}
                                    </div>
                                {% endfor %}
                                <a class="oling-mobile-mega__all" href="{{ navExpertisesPath }}">{{ 'nav.all_expertises'|trans }}</a>
                            </div>
                            {% if practices is defined and services is defined %}
                                <div class="hs-mega-menu oling-mega-menu oling-mega-menu--needs" aria-labelledby="expertisesMegaMenu">
                                    {% include 'public/_expertise_groups.html.twig' with {navigationUniverses: navigationUniverses} %}
                                </div>
                            {% endif %}
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute in ['sectors_index', 'sectors_show', 'metiers', 'localized_site_page'] and currentSlug starts with 'secteur' %}active{% endif %}" href="{{ navSectorsPath }}">{{ 'nav.sectors'|trans }}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute in ['projets', 'projets_more'] or (currentRoute == 'localized_site_page' and currentSlug == 'projets') %}active{% endif %}" href="{{ navProjectsPath }}">{{ 'nav.projects'|trans }}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute in ['apropos', 'localized_apropos'] %}active{% endif %}" href="{{ navAboutPath }}">{{ 'nav.about'|trans }}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute in ['seo_resources_index', 'localized_resources_index', 'seo_resource', 'localized_resource'] %}active{% endif %}" href="{{ navResourcesPath }}">{{ 'nav.resources'|trans }}</a>
                        </li>
                        <li class="nav-item oling-main-menu__mapsi">
                            <a class="nav-link mapsi-link" href="{{ path('practice_home', {'slug': 'mapsi'}) }}" aria-label="{{ 'nav.mapsi_access'|trans }}">
                                <img src="{{ asset('/img/logo/mapsi.png') }}" class="logo-light-mode" alt="Logo MAPSI">
                                <img src="{{ asset('/img/logo/mapsi_blanc.png') }}" class="logo-dark-mode" alt="Logo MAPSI">
                            </a>
                        </li>
                        <li class="nav-item oling-main-menu__cta">
                            <a class="btn btn-primary" href="{{ navContactPath }}">{{ 'nav.consultant_cta'|trans }}</a>
                        </li>
                        <li class="nav-item dropdown oling-language-switcher" aria-label="{{ languageAriaLabel }}">
                            <button
                                type="button"
                                class="oling-language-switcher__toggle dropdown-toggle"
                                id="languageSwitcher"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                aria-expanded="false"
                                aria-label="{{ languageAriaLabel }}"
                            >
                                <i class="bi-globe2" aria-hidden="true"></i>
                                <span>{{ languageLocales[currentLocale]|default(currentLocale|upper) }}</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end oling-language-switcher__menu" aria-labelledby="languageSwitcher">
                                {% for languageCode, languageLabel in languageLocales %}
                                    {% set languagePath = switcherAlternates[languageCode]|default(null) %}
                                    {% if languageCode == currentLocale %}
                                        <li><span class="dropdown-item active" aria-current="true" lang="{{ languageCode }}">{{ languageNames[languageCode] }}</span></li>
                                    {% elseif languagePath %}
                                        <li><a class="dropdown-item" href="{{ languagePath }}" hreflang="{{ languageCode }}" lang="{{ languageCode }}">{{ languageNames[languageCode] }}</a></li>
                                    {% else %}
                                        <li><span class="dropdown-item disabled" aria-disabled="true" lang="{{ languageCode }}">{{ languageNames[languageCode] }}</span></li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
    </header>
    {% endif %}

    {% block body %}{% endblock %}

    {% if not isAdminPage %}
    {% include 'includes/_chat_widget_v2.html.twig' %}

    <div id="cookie-banner" class="oling-cookie-banner" role="dialog" aria-live="polite" aria-label="{{ 'cookies.aria_label'|trans }}">
        <div class="oling-cookie-banner__content">
            <div class="oling-cookie-banner__text">
                <strong>{{ 'cookies.title'|trans }}</strong>
                <p>{{ 'cookies.intro'|trans }}</p>
            </div>
            <div class="oling-cookie-banner__actions">
                <button type="button" class="btn btn-outline-light js-cookie-details">{{ 'cookies.details'|trans }}</button>
                <button type="button" class="btn btn-primary js-cookie-accept">{{ 'cookies.accept_all'|trans }}</button>
                <button type="button" class="btn btn-outline-light js-cookie-refuse">{{ 'cookies.refuse_all'|trans }}</button>
            </div>
        </div>
        <div class="oling-cookie-banner__details">
            <div class="oling-cookie-details">
                <div class="oling-cookie-details__block">
                    <h4>{{ 'cookies.essential_title'|trans }}</h4>
                    <div class="oling-cookie-choice">
                        <label class="oling-cookie-choice__label">
                            <input type="checkbox" checked disabled>
                            {{ 'cookies.essential_choice'|trans }}
                        </label>
                    </div>
                    <ul>
                        <li><strong>oling_cookie_consent</strong> : {{ 'cookies.consent_cookie'|trans }}</li>
                        <li><strong>PHPSESSID</strong> : {{ 'cookies.session_cookie'|trans }}</li>
                    </ul>
                </div>
                <div class="oling-cookie-details__block">
                    <h4>{{ 'cookies.analytics_title'|trans }}</h4>
                    <div class="oling-cookie-choice">
                        <label class="oling-cookie-choice__label">
                            <input type="checkbox" class="js-cookie-analytics">
                            {{ 'cookies.analytics_choice'|trans }}
                        </label>
                    </div>
                    <ul>
                        <li><strong>_ga</strong> : {{ 'cookies.ga_cookie'|trans }}</li>
                        <li><strong>_ga_*</strong> : {{ 'cookies.ga4_cookie'|trans }}</li>
                        <li><strong>_gid</strong> : {{ 'cookies.gid_cookie'|trans }}</li>
                    </ul>
                </div>
                <div class="oling-cookie-details__actions">
                    <button type="button" class="btn btn-primary js-cookie-save">{{ 'cookies.save'|trans }}</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="oling-footer d-print-none">
        <div class="container">
            <div class="oling-footer__top">
                <div>
                    <span class="oling-kicker">OLING</span>
                    <h2>{{ 'footer.baseline'|trans }}</h2>
                </div>
                <div class="oling-footer__cta">
                    <a class="btn btn-primary" href="{{ navContactPath }}">{{ 'footer.exchange_cta'|trans }}</a>
                </div>
            </div>

            <div class="oling-footer__grid">
                <div>
                    <span class="oling-footer__title">{{ 'footer.universes'|trans }}</span>
                    <ul>
                        {% for universe in navigationUniverses %}
                            <li><a href="{{ universe.href }}">{{ universe.title|trans }}</a></li>
                        {% endfor %}
                        <li><a href="{{ navExpertisesPath }}">{{ 'footer.all_expertises'|trans }}</a></li>
                        <li><a href="{{ navServicesPath }}">{{ 'footer.all_services'|trans }}</a></li>
                    </ul>
                </div>
                <div>
                    <span class="oling-footer__title">{{ 'footer.sectors'|trans }}</span>
                    <ul>
                        {% for sector in public_site_page_resolver.getSectorCatalogEntries()|slice(0, 8) %}
                            <li><a href="{{ sector.detailUrl ?: path('sectors_index') }}">{{ sector.designation }}</a></li>
                        {% endfor %}
                        <li><a href="{{ navSectorsPath }}">{{ 'footer.all_sectors'|trans }}</a></li>
                        <li><a href="{{ navProjectsPath }}">{{ 'nav.projects'|trans }}</a></li>
                        <li><a href="{{ navResourcesPath }}">{{ 'nav.resources'|trans }}</a></li>
                    </ul>
                </div>
                <div>
                    <span class="oling-footer__title">{{ 'footer.company'|trans }}</span>
                    <ul>
                        <li><a href="{{ navAboutPath }}">{{ 'nav.about'|trans }}</a></li>
                        <li><a href="{{ navTeamPath }}">{{ 'footer.team'|trans }}</a></li>
                        <li><a href="{{ path('metiers') }}">{{ 'footer.jobs'|trans }}</a></li>
                        <li><a href="{{ path('rse') }}">{{ 'footer.rse'|trans }}</a></li>
                        <li><a href="https://mapsi.fr/" target="_blank" rel="noopener">MAPSI</a></li>
                        <li><a href="{{ path('seo_mapsi_progiciel') }}">MAPSI progiciel</a></li>
                        <li><a href="https://www.linkedin.com/company/oling-management-&-technologie/" target="_blank" rel="noopener">LinkedIn</a></li>
                    </ul>
                </div>
                <div>
                    <span class="oling-footer__title">{{ 'footer.contact_details'|trans }}</span>
                    <ul>
                        <li><a href="{{ navContactPath }}">{{ 'footer.contact_form'|trans }}</a></li>
                        {% if agencies is empty %}
                            <li>{{ 'footer.presence'|trans }}</li>
                        {% else %}
                            {% for agency in agencies|slice(0, 3) %}
                                <li>
                                    {% if agency.streetAddress %}{{ agency.streetAddress }}, {% endif %}{{ agency.city }}{% if agency.postalCode %}, {{ agency.postalCode }}{% endif %}
                                </li>
                            {% endfor %}
                        {% endif %}
                        {% set legalRoutes = {
                            fr: {privacy: 'polrgpd', security: 'polsecurite', notice: 'discloser', ai: 'charte_ia'},
                            en: {privacy: 'polrgpd_en', security: 'polsecurite_en', notice: 'discloser_en', ai: 'charte_ia_en'},
                            es: {privacy: 'polrgpd_es', security: 'polsecurite_es', notice: 'discloser_es', ai: 'charte_ia_es'}
                        } %}
                        {% set legalRouteSet = legalRoutes[currentLocale]|default(legalRoutes.fr) %}
                        <li><a href="{{ path(legalRouteSet.privacy) }}">{{ 'footer.rgpd_policy'|trans }}</a></li>
                        <li><a href="{{ path(legalRouteSet.security) }}">{{ 'footer.security_policy'|trans }}</a></li>
                        <li><a href="{{ path(legalRouteSet.notice) }}">{{ 'footer.legal_notice'|trans }}</a></li>
                        <li><a href="{{ path(legalRouteSet.ai) }}">{{ 'footer.ai_charter'|trans }}</a></li>
                        <li><a href="javascript:;" class="js-cookie-manage">{{ 'footer.manage_cookies'|trans }}</a></li>
                    </ul>
                </div>
            </div>

            <div class="oling-footer__bottom">
                <p>© OLING Management et Technologie - 2026</p>
            </div>
        </div>
    </footer>
    {% endif %}
</body>
</html>

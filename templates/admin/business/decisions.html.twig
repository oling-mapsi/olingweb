{% extends 'base.html.twig' %}
{% block title %}Décisions métier | Admin{% endblock %}
{% block body %}{% include 'admin/business/_style.html.twig' %}<main class="admin"><a class="cms-back" href="{{ path('admin_catalogue_index',{type:'service'}) }}">← Prestations & expertises</a><h1>Objets nécessitant une décision métier</h1><p class="cms-intro">Un motif précis par objet : le statut public et la présence au menu restent visibles.</p><div class="cms-business-note">Une Page sans Service associé peut constituer une <strong>offre autonome</strong>. Ici, elle apparaît uniquement si sa famille administrative reste à confirmer. Les neuf Services sans Practice n’ont aucune route inventée.</div>
<div class="cms-tabs"><a href="#decision-route">9 Services sans route</a><a href="#decision-identity">1 identité à clarifier</a><a href="#decision-classification">25 familles de Page à confirmer</a></div>
{% for scope,title in {'route':'9 Services sans famille ni route propre','identity':'Identité commerciale à clarifier','classification':'Familles de Page à confirmer'} %}{% set sectionRows=rows|filter(row=>scope=='route' ? row.kind=='service' and not row.url : (scope=='identity' ? row.identityIssue : row.kind!='service')) %}<section class="cms-business-section" id="decision-{{ scope }}"><h2>{{ title }}</h2><p class="cms-business-caption">{{ sectionRows|length }} objets · {{ scope=='classification' ? 'Il ne s’agit pas d’un défaut de publication ni d’un rattachement à un Service obligatoire.' : 'Aucune correction de donnée appliquée.' }}</p><div class="cms-table-wrap"><table class="cms-table"><thead><tr><th>Image</th><th>Objet / URL</th><th>Décision attendue</th><th>État public</th><th></th></tr></thead><tbody>{% for row in sectionRows %}<tr data-decision-key="{{ row.key }}"><td>{% include 'admin/catalogue/_thumbnail.html.twig' %}</td><td><strong>{{ row.technical=='service' ? 'Service' : 'Page' }} #{{ row.id }} · {{ row.title }}</strong><span class="cms-subtitle">{{ row.url ?: 'Sans route publique propre' }}</span></td><td><ul class="cms-business-decision-list">{% for reason in row.decisionReasons %}<li>{{ reason }}</li>{% endfor %}</ul>{% if row.familyProposed %}<small class="cms-subtitle">Proposition : {{ row.familyLabel }}</small>{% endif %}</td><td>{{ row.statusLabel }}<small class="cms-subtitle">{{ row.http ? 'HTTP '~row.http : 'Sans URL' }} · Menu : {{ row.navigationLabel }}</small></td><td><a class="btn btn-outline-primary btn-sm" href="{{ path('admin_catalogue_offer',{technical:row.technical,id:row.id}) }}">Gérer</a></td></tr>{% endfor %}</tbody></table></div></section>{% endfor %}
<a href="{{ path('admin_catalogue_business_review') }}">Revoir les 27 correspondances →</a></main>{% endblock %}

{% extends 'ai_control/base.html.twig' %}{% block shell %}<main class="login"><div class="brand">OLING <span>AI</span></div><section class="panel"><div class="eyebrow">Votre espace de travail</div><h1>Tour de contrôle IA</h1><p class="muted">Connectez-vous avec votre identifiant OLING habituel.</p>{% if error %}<p class="error" role="alert">Connexion impossible. Vérifiez vos identifiants.</p>{% endif %}<form method="post" class="stack" action="{{ path('admin_ai_login') }}"><div><label for="username">Identifiant</label><input id="username" name="_username" autocomplete="username" value="{{ last_username }}" required></div><div><label for="password">Mot de passe</label><input id="password" name="_password" type="password" autocomplete="current-password" required></div><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button>Se connecter</button></form></section></main>{% endblock %}

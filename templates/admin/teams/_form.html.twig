{{ form_start(form) }}
{% if form.publicDisplayName is defined %}<p class="cms-site-source">Les champs de nom et de photo ci-dessous modifient les valeurs réellement utilisées par le profil public. Les identifiants, ancres, expertises et affiliations existants sont conservés.</p><div class="row g-3 mb-3"><div class="col-md-6">{{ form_row(form.publicDisplayName, {'attr': {'class': 'form-control'}}) }}</div><div class="col-md-6">{{ form_row(form.publicPhoto, {'attr': {'class': 'form-control'}}) }}</div></div>{% endif %}
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="mb-3">
                {{ form_label(form.noncomplet) }}
                {{ form_widget(form.noncomplet, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.noncomplet) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.titre) }}
                {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.titre) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.shortcv) }}
                {{ form_widget(form.shortcv, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.shortcv) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.linkedin) }}
                {{ form_widget(form.linkedin, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.linkedin) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.services) }}
                {{ form_widget(form.services, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.services) }}
            </div>
        </div>

        <div class="col-lg-4">
            <div class="mb-3">
                {{ form_label(form.photo) }}
                {{ form_widget(form.photo, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.photo) }}
                <div class="mt-2">
                    {{ form_label(form.photoFile) }}
                    {{ form_widget(form.photoFile, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.photoFile) }}
                </div>
                {% if team.photo %}
                    <div class="mt-2">
                        <div class="small text-muted mb-1">Photo actuelle</div>
                        <img src="{{ asset(team.photo) }}" alt="Photo actuelle" style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%;">
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <section class="cms-card mt-3"><h2>Affichage sur la page Équipe</h2>{{ form_row(form.isPublic) }}{{ form_row(form.displayOrder) }}<p class="small">Le profil public et la traduction française publiée sont également nécessaires. Une fiche enregistrée n’est pas automatiquement affichée sur le site.</p></section>
    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
        <a class="btn btn-outline-secondary" href="{{ path('admin_teams_index') }}">Retour</a>
    </div>
{{ form_end(form) }}

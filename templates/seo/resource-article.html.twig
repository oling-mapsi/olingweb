{% extends 'base.html.twig' %}

{% block title %}{{ page and page.title ? page.title : 'Ressource | OLING' }}{% endblock %}
{% block meta_description %}{{ page and page.metaDescription ? page.metaDescription : 'Ressource OLING.' }}{% endblock %}
{% block canonical_url %}{{ page and page.canonicalUrl ? page.canonicalUrl : app.request.schemeAndHttpHost ~ canonicalPath|default(path('seo_resource', {slug: publicSlug})) }}{% endblock %}

{% block body %}
{% set faqItems = pageFaqItems is defined and pageFaqItems is not empty ? pageFaqItems : [] %}
<main id="content" role="main" class="oling-seo-cabinet">
  <section class="oling-shell-hero">
    <div class="container">
      <div class="oling-shell-hero__inner">
        <div class="oling-shell-hero__copy">
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-4">
              <li class="breadcrumb-item"><a href="{{ locale|default('fr') == 'fr' ? path('index') : '/' ~ locale }}">{{ 'common.home'|trans }}</a></li>
              <li class="breadcrumb-item"><a href="{{ resourcesPath|default(path('seo_resources_index')) }}">{{ 'nav.resources'|trans }}</a></li>
              <li class="breadcrumb-item active" aria-current="page">{{ page and page.heroTitle ? page.heroTitle|striptags : 'Article' }}</li>
            </ol>
          </nav>
          {% if page and page.heroBadge %}
            <span class="oling-shell-hero__eyebrow">{{ page.heroBadge }}</span>
          {% endif %}
          <h1>{{ page and page.heroTitle ? page.heroTitle : (page and page.title ? page.title : 'Ressource OLING') }}</h1>
          {% if page and page.heroIntro %}
            <p class="oling-shell-hero__intro">{{ page.heroIntro|striptags }}</p>
          {% endif %}
          {% if page and (page.publicationDate or page.authorDisplayName) %}
            <p class="oling-resource-meta">
              {% if page.publicationDate %}{{ page.publicationDate|date('d/m/Y') }}{% endif %}
              {% if page.publicationDate and page.authorDisplayName %} · {% endif %}
              {% if page.authorDisplayName %}{{ page.authorDisplayName }}{% endif %}
            </p>
          {% endif %}
          {% if page and page.categories is not empty %}
            <div class="oling-resource-tags">
              {% for category in page.categories %}
                <span>{{ category }}</span>
              {% endfor %}
            </div>
          {% endif %}
          {% if isPreview is defined and isPreview %}
            <p class="alert alert-warning mt-3 mb-0">Preview protegee Growth. Cette URL n’est pas publique.</p>
          {% endif %}
        </div>
        <div class="oling-shell-hero__highlights">
          {% if page and page.tags is not empty %}
            {% for tag in page.tags|slice(0, 3) %}
              <span>{{ tag }}</span>
            {% endfor %}
          {% else %}
            <span>Conseil</span>
            <span>Transformation</span>
            <span>Exécution</span>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {% if page and page.heroImage %}
    {% set imageSrc = page.heroImage starts with 'http' ? page.heroImage : asset(page.heroImage|trim('/', 'left')) %}
    <section class="oling-shell-section pt-0">
      <div class="container">
        <img class="img-fluid rounded-5 w-100 oling-resource-hero-image" src="{{ imageSrc }}" alt="{{ page.heroTitle ?: page.title }}">
      </div>
    </section>
  {% endif %}

  {% if page and page.heroSideHtml %}
    <section class="oling-shell-section">
      <div class="container">
        <article class="oling-surface oling-surface--light oling-markdown-content oling-resource-content">
          {{ page.heroSideHtml|raw }}
        </article>
      </div>
    </section>
  {% endif %}

  {% if page and page.tags is not empty %}
    <section class="oling-shell-section pt-0">
      <div class="container">
        <div class="oling-surface oling-surface--light">
          <span class="oling-kicker">Tags</span>
          <h2>{{ 'resources.related_axes'|trans }}</h2>
          <div class="oling-resource-tags">
            {% for tag in page.tags %}
              <span>{{ tag }}</span>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {% if related is not empty %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'resources.next_kicker'|trans }}</span>
          <h2>{{ 'resources.related_articles'|trans }}</h2>
        </div>
        <div class="oling-editorial-grid">
          {% for item in related %}
            <a class="oling-editorial-card" href="{{ item.href }}">
              <span class="oling-kicker">{{ 'resources.resource_kicker'|trans }}</span>
              <h3>{{ item.h1 }}</h3>
              {% if item.intro %}
                <p>{{ item.intro }}</p>
              {% endif %}
              <span class="oling-editorial-card__more">{{ 'resources.read_article'|trans }}</span>
            </a>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if faqItems is not empty %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-surface oling-surface--light">
          <span class="oling-kicker">FAQ</span>
          <h2>{{ 'resources.faq_title'|trans }}</h2>
          <ul class="oling-check-list mb-0">
            {% for item in faqItems %}
              <li><strong>{{ item.question }}</strong> {{ item.answer }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>
  {% endif %}
</main>

{% if not isPreview|default(false) %}
  {% set resourceUrl = page and page.canonicalUrl ? page.canonicalUrl : app.request.schemeAndHttpHost ~ canonicalPath|default(path('seo_resource', {slug: publicSlug})) %}
  {% set resourceHeadline = page and page.heroTitle ? page.heroTitle|striptags|trim : (page and page.title ? page.title|striptags|trim : '') %}
  {% set resourceDescription = page and page.heroIntro ? page.heroIntro|striptags|trim : (page and page.metaDescription ? page.metaDescription|striptags|trim : '') %}
  {% set resourceBreadcrumbName = page and page.heroTitle ? page.heroTitle|striptags : 'Article' %}
  {% set structuredDataGraph = [{
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {'@type': 'ListItem', 'position': 1, 'name': 'common.home'|trans, 'item': site_base_url ~ (locale|default('fr') == 'fr' ? path('index') : '/' ~ locale)},
      {'@type': 'ListItem', 'position': 2, 'name': 'nav.resources'|trans, 'item': site_base_url ~ resourcesPath|default(path('seo_resources_index'))},
      {'@type': 'ListItem', 'position': 3, 'name': resourceBreadcrumbName, 'item': resourceUrl}
    ]
  }] %}

  {% if page and page.publicationDate and page.authorDisplayName and resourceHeadline and resourceDescription %}
    {% set articleSchema = {
      '@type': 'Article',
      'headline': resourceHeadline,
      'description': resourceDescription,
      'datePublished': page.publicationDate|date('c'),
      'dateModified': (page.publishedAt ?: page.publicationDate)|date('c'),
      'author': {
        '@type': 'Organization',
        'name': page.authorDisplayName|striptags|trim
      },
      'publisher': {'@id': site_base_url ~ '/#professional-service'},
      'mainEntityOfPage': {'@type': 'WebPage', '@id': resourceUrl}
    } %}
    {% if page.heroImage %}
      {% set articleImage = page.heroImage starts with 'http' ? page.heroImage : absolute_url(asset(page.heroImage|trim('/', 'left'))) %}
      {% set articleSchema = articleSchema|merge({'image': articleImage}) %}
    {% endif %}
    {% set structuredDataGraph = structuredDataGraph|merge([articleSchema]) %}
  {% endif %}

  <script type="application/ld+json">
  {{ {'@context': 'https://schema.org', '@graph': structuredDataGraph}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}
  </script>
{% endif %}
{% endblock %}

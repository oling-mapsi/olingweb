{% extends 'admin/crm/layout.html.twig' %}
{% block crm %}
<div class="crm-card"><b>{{ connections.environment=='prod' ? 'Production' : 'Développement · données fictives uniquement' }}</b><br>
Microsoft 365 : {{ connections.email ? 'Connecté' : 'Non connecté' }} · Veille : {{ connections.watch ? 'Import activé' : 'Non connectée' }} · Automatisation : {{ connections.scheduler ? 'Activée' : 'Désactivée' }}<br>
<small>Dernière synchronisation emails : {{ sync.last_success|default('Jamais') }} · Dernier import veille : {{ watch.last_success|default('Jamais') }}</small>
{% if sync.next|default(null) %}<p>Reprise de l’historique en cours : {{ sync.processed|default(0) }} messages examinés.</p>{% endif %}
{% if sync.error|default(null) %}<p class="text-danger">{{ sync.error }}</p>{% endif %}
<form method="post" action="{{ path('admin_crm_sync') }}"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><button class="btn btn-sm btn-outline-primary" {% if not connections.email or not connections.scheduler %}disabled{% endif %}>Relancer la synchronisation</button></form></div>
<form class="crm-grid crm-card" method="get"><input type="hidden" name="view" value="{{ view }}"><label>Rechercher<input name="q" value="{{ q }}" placeholder="Organisation, affaire, contact…"></label><div class="crm-grid"><label>Type<select name="kind"><option value="">Tous</option><option value="public" {{ kind=='public'?'selected':'' }}>Marché public</option><option value="private" {{ kind=='private'?'selected':'' }}>Commercial privé</option></select></label><label>Statut<select name="status"><option value="">Tous</option>{% for value,label in statuses %}<option value="{{ value }}" {{ value==status?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label></div><button class="btn btn-primary">Filtrer</button></form>
<p>{{ total }} affaire(s) · Les réponses déposées restent visibles après leur échéance.</p>
<div class="crm-card crm-table"><table><thead><tr><th>Organisation / affaire</th><th>Type</th><th>Statut</th><th>Contact</th><th>Montant connu</th><th>Échéance</th><th>Prochaine action</th></tr></thead><tbody>
{% for d in deals %}<tr><td>{{ d.organization ?: 'Organisation à préciser' }}<br><a href="{{ path('admin_crm_show',{id:d.id}) }}"><strong>{{ d.title }}</strong></a></td><td>{{ d.kind=='public'?'Marché public':'Privé' }}</td><td><span class="crm-badge">{{ statuses[d.status] }}</span></td><td>{{ d.contact ?: d.email ?: '—' }}</td><td>{{ d.amount ? d.amount~' €' : '—' }}<br><small>{{ d.amount_kind=='estimated'?'Estimé':(d.amount_kind=='proposed'?'Proposé':'') }}</small></td><td>{{ d.deadline ? d.deadline|date('d/m/Y H:i','Europe/Paris') : '—' }}</td><td>{{ d.next_action ?: '—' }}<br><small>{{ d.reminder ? d.reminder|date('d/m/Y H:i','Europe/Paris') : '' }}</small></td></tr>
{% else %}<tr><td colspan="7">Aucune affaire dans cette vue.</td></tr>{% endfor %}</tbody></table></div>
<div class="crm-actions">{% if page>1 %}<a href="{{ path('admin_crm',app.request.query.all|merge({page:page-1})) }}">← Précédent</a>{% endif %}{% if page*50<total %}<a href="{{ path('admin_crm',app.request.query.all|merge({page:page+1})) }}">Suivant →</a>{% endif %}</div>
{% endblock %}

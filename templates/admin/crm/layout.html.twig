<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{% block title %}CRM | OLING{% endblock %}</title><link rel="stylesheet" href="/crm/workspace.css?v=4"><script src="/crm/workspace.js?v=4" defer></script></head><body>
<header class="topbar"><a class="brand" href="{{ path('admin_crm') }}">OLING<span>CRM COMMERCIAL</span></a><nav aria-label="Navigation principale">{% for key,label in {portfolio:'Portefeuille',markets:'Marchés publics',clients:'Demandes clients',todo:'Actions et relances'} %}<a class="{{ view|default('')==key?'active':'' }}" href="{{ path('admin_crm',{view:key}) }}">{{ label }}</a>{% endfor %}</nav><a class="admin-link" href="/admin">Back-office ↗</a></header>
<main class="crm">{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}<div id="save-status" class="save-status" role="status" aria-live="polite" hidden></div><div id="save-error" class="alert alert-danger" role="alert" hidden></div>{% block crm %}{% endblock %}</main><footer class="footer">OLING Management & Technologie · Espace privé</footer></body></html>

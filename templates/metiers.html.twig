{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}

{% block body %}
<main id="content" role="main" class="oling-public-editorial oling-public-editorial--sectors-hub">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.intro,
    primaryCta: page.primaryCta,
    secondaryCta: page.secondaryCta,
    highlights: page.highlights
  } %}

  <section class="oling-shell-section">
    <div class="container">
      <div class="oling-section-head">
        <span class="oling-kicker">Vue d’ensemble</span>
        <h2>Des compétences adaptées à votre activité</h2>
        <p>Les contraintes de production, de service public, de gestion ou de conformité varient selon votre activité. OLING accompagne les directions et leurs équipes dans le choix des solutions et la conduite de leurs projets SI.</p>
      </div>
      <div class="oling-editorial-grid">
        {% for sector in sectorCatalog %}
          {% set tag = sector.detailUrl ? 'a' : 'article' %}
          <{{ tag }} class="oling-editorial-card"{% if sector.detailUrl %} href="{{ sector.detailUrl }}"{% endif %}>
            <span class="oling-kicker">Secteur d’activité</span>
            <h2>{{ sector.designation }}</h2>
            <p>{{ sector.intro }}</p>
            {% if sector.specifics is not empty %}
              <p><strong>Enjeux métier :</strong> {{ sector.specifics|join(' · ') }}</p>
            {% endif %}
            {% if sector.detailUrl %}
              <span class="oling-editorial-card__more">Découvrir notre accompagnement</span>
            {% endif %}
          </{{ tag }}>
        {% else %}
          <div class="oling-surface oling-surface--light">
            <p class="mb-0">Aucun secteur n’est disponible pour le moment.</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {% if sectorPages is not empty %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">Nos accompagnements</span>
          <h2>Transformation SI, organisation et conformité</h2>
          <p>Découvrez nos interventions auprès des industriels, des entreprises de services et des organisations soumises à des exigences réglementaires fortes.</p>
        </div>
        <div class="oling-editorial-grid">
          {% for slug, sectorPage in sectorPages %}
            <a class="oling-editorial-card" href="{{ path('sectors_show', {slug: slug}) }}">
              <span class="oling-kicker">{{ sectorPage.eyebrow }}</span>
              <h2>{{ sectorPage.title }}</h2>
              <p>{{ sectorPage.intro }}</p>
              {% if sectorPage.issues is not empty %}
                <p><strong>Enjeux métier :</strong> {{ sectorPage.issues|slice(0, 2)|join(' · ') }}</p>
              {% endif %}
              <span class="oling-editorial-card__more">Voir la page</span>
            </a>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}
</main>
{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}Tableau de bord | Admin{% endblock %}
{% block body %}{% include 'admin/business/_style.html.twig' %}<main class="admin cms-home"><h1>Tableau de bord</h1><p class="cms-intro">Retrouvez les rubriques et les pages d’OLING.fr.</p>
<section aria-labelledby="cms-domains"><h2 id="cms-domains">Nos domaines d’intervention</h2><div class="cms-domains">
{% for family in families %}<a class="cms-domain" data-practice-id="{{ family.id }}" href="{{ path('admin_catalogue_index',{type:'service',practice:family.id}) }}">
{% if family.thumbnail %}<img src="{{ family.thumbnail }}" alt="" class="cms-domain-image">{% else %}<span class="cms-domain-image cms-no-image" aria-hidden="true">◇</span>{% endif %}
<div class="cms-domain-content"><h3>{{ family.title }}</h3><p class="cms-family-counts"><span><b>{{ family.serviceCount }}</b> prestations historiques</span><span><b>{{ family.pageCount }}</b> {{ family.pageCount==1 ? 'page commerciale' : 'pages commerciales' }} · <b>{{ family.expertiseCount }}</b> expertises</span></p><span class="cms-domain-action">Voir les contenus métier →</span></div></a>{% endfor %}
</div></section>
<section class="cms-quick-section"><h2>Les rubriques du site</h2><div class="cms-site-shortcuts"><a class="cms-card" href="{{ path('admin_home_index') }}">Accueil · sections, médias et traductions</a>{% for key,label in siteSections %}<a class="cms-card" href="{{ path('admin_site_section',{section:key}) }}">{{ label }}</a>{% endfor %}</div></section><style>.cms-site-shortcuts{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.cms-site-shortcuts .cms-card{margin:0;padding:15px;font-weight:600;color:#145b8c}@media(max-width:700px){.cms-site-shortcuts{grid-template-columns:repeat(2,1fr)}}</style></main>{% endblock %}

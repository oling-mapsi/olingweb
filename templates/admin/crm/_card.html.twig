<article class="deal-card compact-card" data-id="{{ d.id }}" data-version="{{ d.version }}" data-url="{{ path('admin_crm_move',{id:d.id}) }}" draggable="true" data-selected-watch="{{ d.origin=='watch' and d.decision=='follow'?'1':'0' }}">
  <div class="card-meta"><span class="drag-grip" aria-hidden="true" title="Glisser pour déplacer">⠿</span><span>{{ d.kind=='public' or d.origin=='watch'?'Marché public':'Client' }} {{ d.site }}</span></div>
  <h3><a draggable="false" href="{{ path('admin_crm_show',{id:d.id}) }}">{{ d.title }}</a></h3>
  <p class="company">{{ d.organization ?: d.buyer ?: 'Société à préciser' }}</p>
  <p class="compact-action">{{ d.next_action ?: 'Action à définir' }}</p>
  <div class="card-dates">
    {% if d.reminder %}{% include 'admin/crm/_date.html.twig' with {value:d.reminder,label:'Relance',empty:'',actionable:d.status not in ['won','lost','no_go','archived']} only %}
    {% elseif d.next_action %}<small class="crm-muted">Sans relance planifiée</small>{% endif %}
    {% if d.deadline %}{% include 'admin/crm/_date.html.twig' with {value:d.deadline,label:d.kind=='public' or d.origin=='watch'?'Dépôt':'Remise',empty:'',actionable:d.status not in ['sent','discussion','won','lost','no_go','archived']} only %}{% endif %}
    {% if not d.reminder and not d.deadline and not d.next_action %}<small class="crm-muted">Aucune date renseignée</small>{% endif %}
  </div>
  <div class="compact-footer">
    {% if d.kind=='public' or d.origin=='watch' %}
      <button type="button" class="dce-toggle" data-url="{{ path('admin_crm_dce',{id:d.id}) }}" aria-pressed="{{ d.dce_received ? 'true':'false' }}" aria-label="DCE obtenu — {{ d.title }}" title="{{ d.dce_received ? 'DCE obtenu':'DCE à obtenir' }} — Dossier de consultation des entreprises : cliquez pour {{ d.dce_received ? 'annuler la confirmation':'confirmer sa réception' }}">
        <span class="dce-dot" aria-hidden="true">{{ d.dce_received ? '✓':'' }}</span><span class="dce-label">DCE</span>
      </button>
    {% endif %}
    <button type="button" class="card-details-toggle" aria-expanded="false" aria-controls="details-{{ d.id }}" aria-label="Détails de {{ d.title }}">Détails ↗</button>
  </div>
  <section id="details-{{ d.id }}" class="card-details" aria-labelledby="details-title-{{ d.id }}" hidden>
    <button type="button" class="card-details-close" aria-label="Fermer les détails">×</button>
    <h4 id="details-title-{{ d.id }}">{{ d.title }}</h4>
    <p class="company">{{ d.organization ?: d.buyer ?: 'Société à préciser' }}</p>
    <p class="contact">{{ d.contact ?: 'Contact à préciser' }}{% if d.email %}<br>{{ d.email }}{% endif %}{% if d.phone %}<br>{{ d.phone }}{% endif %}</p>
    {% if d.summary %}<p class="preview-need">{{ d.summary|slice(0,600) }}{{ d.summary|length>600?'…':'' }}</p>{% endif %}
    <div class="next-action"><small>PROCHAINE ACTION</small><p>{{ d.next_action ?: 'À définir' }}</p>{% if d.reminder %}<time>Relance · {{ d.reminder|date('d/m/Y H:i','Europe/Paris') }}</time>{% endif %}</div>
    {% if d.deadline %}<p class="deadline">{{ d.kind=='public' or d.origin=='watch'?'Dépôt':'Remise' }} · {{ d.deadline|date('d/m/Y H:i','Europe/Paris') }}</p>{% endif %}
    {% if d.amount %}<p>{{ d.amount }} €</p>{% endif %}
    <label class="status-label">Changer le statut<select class="card-status" aria-label="Statut de {{ d.title }}">{% for value,label in statuses %}<option value="{{ value }}" {{ value==d.status?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label>
    <a draggable="false" class="card-link" href="{{ path('admin_crm_show',{id:d.id}) }}">Ouvrir la fiche complète →</a>
  </section>
</article>

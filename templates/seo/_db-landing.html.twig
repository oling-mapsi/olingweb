{% extends 'base.html.twig' %}

{% block title %}{{ landingNarrative.metaTitle ?? (page and page.title ? page.title : 'OLING') }}{% endblock %}
{% block meta_description %}{{ landingNarrative.metaDescription ?? (page and page.metaDescription ? page.metaDescription : 'seo.landing.default_meta_description'|trans) }}{% endblock %}

{% block body %}
{% set pageSlug = page and page.slug ? page.slug : landingPageSlug|default('') %}
{% set compactLanding = landingNarrative.compactLanding is defined ? landingNarrative.compactLanding : false %}
{% set showFaq = landingNarrative.showFaq is defined ? landingNarrative.showFaq : true %}
{% set showHeroSideHtml = landingNarrative.showHeroSideHtml is defined ? landingNarrative.showHeroSideHtml : true %}
{% set showHeroImage = landingNarrative.showHeroImage is defined ? landingNarrative.showHeroImage : true %}
{% set showReadingPath = landingNarrative.showReadingPath is defined ? landingNarrative.showReadingPath : true %}
{% set showAutomaticZones = landingNarrative.showAutomaticZones is defined ? landingNarrative.showAutomaticZones : true %}
{% set faqItems = showFaq and pageFaqItems is defined and pageFaqItems is not empty ? pageFaqItems : [] %}
{% set conversionCtas = {
  'erp-progiciel': 'seo.landing.cta.erp',
  'crm': 'seo.landing.cta.crm',
  'gmao': 'seo.landing.cta.gmao',
  'si-finance': 'seo.landing.cta.finance',
  'facturation-electronique-amoa': 'seo.landing.cta.e_invoice',
  'rgpd': 'seo.landing.cta.rgpd',
  'cyber-securite': 'seo.landing.cta.cyber',
  'conseil-qualite': 'seo.landing.cta.qse'
} %}
{% set conversionCtaKey = conversionCtas[pageSlug]|default(null) %}
{% set conversionCtaLabel = landingNarrative.finalCtaLabel|default(conversionCtaKey ? conversionCtaKey|trans : null) %}
{% set conversionCtaText = landingNarrative.finalCtaText is defined ? landingNarrative.finalCtaText : 'seo.landing.default_final_cta_text'|trans %}
{% set hasHeroImage = showHeroImage and page and page.heroImage %}
{% if hasHeroImage %}
  {% set heroImageRaw = page.heroImage|trim %}
  {% set heroImageSrc = heroImageRaw starts with 'http://' or heroImageRaw starts with 'https://' ? heroImageRaw : asset(heroImageRaw starts with '/' ? heroImageRaw|slice(1) : heroImageRaw) %}
{% endif %}
<main id="content" role="main" class="oling-seo-cabinet">
  <section class="oling-section oling-section--tight oling-seo-cabinet__hero">
    <div class="container">
      <div class="oling-seo-cabinet__hero-shell{% if hasHeroImage %} is-with-media{% endif %}">
        <div class="oling-seo-cabinet__hero-copy">
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-4">
              <li class="breadcrumb-item"><a href="{{ path('index') }}">{{ 'common.home'|trans }}</a></li>
              <li class="breadcrumb-item active" aria-current="page">{{ landingNarrative.heroTitle is defined ? landingNarrative.heroTitle|striptags : (page and page.heroTitle ? page.heroTitle|striptags : (page and page.title ? page.title|striptags : 'common.page'|trans)) }}</li>
            </ol>
          </nav>
          {% if landingNarrative.heroBadge is defined or (page and page.heroBadge) %}
            <span class="oling-kicker">{{ landingNarrative.heroBadge ?? page.heroBadge }}</span>
          {% endif %}
          {% if landingNarrative.heroTitle is defined or (page and page.heroTitle) %}
            <h1>{{ landingNarrative.heroTitle ?? page.heroTitle }}</h1>
          {% elseif page and page.title %}
            <h1>{{ page.title }}</h1>
          {% endif %}
          {% if landingNarrative.heroIntro is defined or (page and page.heroIntro) %}
            <p class="oling-lede">{{ (landingNarrative.heroIntro ?? page.heroIntro)|raw }}</p>
          {% endif %}
        </div>
        {% if hasHeroImage %}
          <aside class="oling-seo-cabinet__hero-media" aria-hidden="true">
            <img src="{{ heroImageSrc }}" alt="">
          </aside>
        {% endif %}
      </div>
    </div>
  </section>

  {% if showHeroSideHtml and page and page.heroSideHtml %}
    <div class="oling-seo-cabinet__content">
      {{ page.heroSideHtml|raw }}
    </div>
  {% endif %}

  {% if landingNarrative.promise is defined or landingNarrative.focus is defined %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="row g-4">
          {% if landingNarrative.promise is defined %}
            <div class="col-lg-6">
              <div class="oling-surface p-4 h-100">
                <span class="oling-kicker">Positionnement</span>
                <h2>{{ landingNarrative.positioningTitle ?? 'seo.landing.default_positioning_title'|trans }}</h2>
                <p class="mb-0">{{ landingNarrative.promise }}</p>
              </div>
            </div>
          {% endif %}
          {% if landingNarrative.focus is defined %}
            <div class="col-lg-6">
              <div class="oling-surface p-4 h-100">
                <span class="oling-kicker">{{ compactLanding ? 'Périmètre' : 'Perimetre' }}</span>
                <h2>{{ landingNarrative.scopeTitle ?? 'seo.landing.default_scope_title'|trans }}</h2>
                <ul class="mb-0">
                  {% for item in landingNarrative.focus %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if landingNarrative.missionPhases is defined or landingNarrative.deliverables is defined %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="row g-4">
          {% if landingNarrative.missionPhases is defined %}
            <div class="col-lg-6">
              <div class="oling-surface p-4 h-100">
                <span class="oling-kicker">{{ 'seo.landing.project_phases'|trans }}</span>
                <h2>{{ landingNarrative.missionPhasesTitle ?? landingNarrative.triggerTitle ?? 'seo.landing.default_mission_phases_title'|trans }}</h2>
                <ul class="mb-0">
                  {% for item in landingNarrative.missionPhases %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endif %}
          {% if landingNarrative.deliverables is defined %}
            <div class="col-lg-6">
              <div class="oling-surface p-4 h-100">
                <span class="oling-kicker">{{ 'seo.landing.deliverables'|trans }}</span>
                <h2>{{ landingNarrative.deliverablesTitle|default('seo.landing.default_deliverables_title'|trans) }}</h2>
                <ul class="mb-0">
                  {% for item in landingNarrative.deliverables %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if landingNarrative.projectContexts is defined or landingNarrative.clientTypes is defined %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="row g-4">
          {% if landingNarrative.projectContexts is defined %}
            <div class="col-lg-6">
              <div class="oling-surface p-4 h-100">
                <span class="oling-kicker">{{ 'service.project_contexts.kicker'|trans }}</span>
                <h2>{{ landingNarrative.projectContextsTitle|default('service.project_contexts.default_title'|trans) }}</h2>
                <ul class="mb-0">
                  {% for item in landingNarrative.projectContexts %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endif %}
          {% if landingNarrative.clientTypes is defined %}
            <div class="col-lg-6">
              <div class="oling-surface p-4 h-100">
                <span class="oling-kicker">{{ 'service.client_types.kicker'|trans }}</span>
                <h2>{{ landingNarrative.clientTypesTitle|default('service.client_types.default_title'|trans) }}</h2>
                <ul class="mb-0">
                  {% for item in landingNarrative.clientTypes %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if landingNarrative.citablePassages is defined %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'service.citable.kicker'|trans }}</span>
          <h2>{{ landingNarrative.citablePassagesTitle }}</h2>
        </div>
        <div class="row g-4">
          {% for passage in landingNarrative.citablePassages %}
            <article class="col-lg-6">
              <h3 class="h5">{{ passage.title }}</h3>
              <p class="mb-0">{{ passage.text }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if landingNarrative.supportLinks is defined %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="oling-surface p-4">
          <span class="oling-kicker">{{ 'seo.landing.complementary_expertise'|trans }}</span>
          <h2>{{ landingNarrative.linksTitle ?? 'seo.landing.default_links_title'|trans }}</h2>
          {% if not compactLanding %}
            <p>{{ landingNarrative.linksIntro ?? 'seo.landing.default_links_intro'|trans }}</p>
          {% endif %}
          {% if compactLanding %}
            <ul class="mb-0">
              {% for link in landingNarrative.supportLinks %}
                <li><a class="link" href="{{ link.href }}">{{ link.label }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <div class="row g-4 mt-1">
              {% for link in landingNarrative.supportLinks %}
                <div class="col-lg-6">
                  <div class="oling-surface p-4 h-100">
                    <h3 class="h6 mb-2"><a class="link" href="{{ link.href }}">{{ link.label }}</a></h3>
                    <p class="mb-0">{{ link.description }}</p>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if landingNarrative.anonymousProofs is defined and landingNarrative.anonymousProofs|length > 0 %}
    {% include 'public/_anonymous_proof_cards.html.twig' with {
      proofs: landingNarrative.anonymousProofs,
      sectionClass: 'oling-section oling-section--tight',
      title: landingNarrative.anonymousProofsTitle|default('service.proofs.default_title'|trans),
      intro: landingNarrative.anonymousProofsIntro|default('service.proofs.default_intro'|trans)
    } %}
  {% endif %}

  {% if pageSlug == 'cyber-securite' %}
    {% include 'public/_iso27001_certification_proof.html.twig' with {
      headingId: 'iso27001-certification-cyber'
    } %}
  {% endif %}

  {% if showReadingPath %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="oling-surface p-4">
          <span class="oling-kicker">{{ 'seo.landing.reading_path'|trans }}</span>
          <h2 class="h4">{{ 'seo.landing.reading_path_title'|trans }}</h2>
          <p class="mb-0">{{ 'seo.landing.reading_path_text'|trans }}</p>
        </div>
      </div>
    </section>
  {% endif %}

  {% if conversionCtaLabel %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="oling-surface p-4 d-flex flex-column flex-lg-row gap-3 align-items-lg-center justify-content-between">
          <div>
            <span class="oling-kicker">{{ 'seo.landing.framing_exchange'|trans }}</span>
            <h2 class="h4 mb-2">{{ landingNarrative.finalCtaTitle|default('seo.landing.default_final_cta_title'|trans) }}</h2>
            {% if conversionCtaText %}
              <p class="mb-0">{{ conversionCtaText }}</p>
            {% endif %}
          </div>
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="{{ path('contact') }}">{{ conversionCtaLabel }}</a>
            {% if landingNarrative.phoneCta|default(false) or pageSlug in ['crm', 'gmao', 'si-finance', 'cyber-securite'] %}
              <a class="btn btn-outline-dark" href="tel:+33189701560" data-demand-phone="owner" data-demand-location="final">Ou appelez-nous au 01 89 70 15 60</a>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {% if pageSlug == 'erp-progiciel' %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="oling-surface p-4">
          <div class="row g-4 align-items-center">
            <div class="col-lg-7">
              <span class="oling-kicker">Questionnaire IA OLING</span>
              <h2 class="h4 mb-2">Qualifier un besoin ERP ou progiciel</h2>
              <p class="mb-0">Le consultant IA reprend le cadre AMOA OLING pour structurer le besoin, la maturité projet, les modules, le périmètre, les risques, les données, les interfaces, les livrables, le macro-planning et les prochaines étapes.</p>
            </div>
            <div class="col-lg-5 d-flex flex-column flex-sm-row flex-lg-column gap-2 justify-content-lg-end">
              <a class="btn btn-primary" href="{{ path('erp_questionnaire') }}">Ouvrir le questionnaire structuré</a>
              <button type="button" class="btn btn-primary" data-chat-prefill="Je souhaite lancer le questionnaire OLING pour qualifier un besoin ERP ou progiciel. Aidez-moi à structurer le contexte, les modules, le périmètre, les risques, les données, les interfaces, les livrables AMOA, le macro-planning, la charge, le budget indicatif et les prochaines étapes.">Lancer le questionnaire ERP</button>
              <button type="button" class="btn btn-outline-primary" data-chat-prefill="J’ai un projet ERP ou progiciel à cadrer. Pouvez-vous m’aider à identifier les questions clés avant un échange OLING ?">Préparer mon cadrage AMOA</button>
            </div>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {% if showAutomaticZones and zoneMaillage is defined and (zoneMaillage.hexagone is not empty or zoneMaillage.outreMer is not empty) %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="oling-surface p-4">
          <h2 class="h4">Nos zones d'intervention pour cette expertise</h2>
          <div class="row g-4 mt-1">
            {% if zoneMaillage.hexagone is not empty %}
              <div class="col-lg-6">
                <h3 class="h6 text-uppercase mb-3">Hexagone</h3>
                <ul class="mb-0">
                  {% for link in zoneMaillage.hexagone %}
                    <li><a class="link" href="{{ link.url }}">{{ link.label }}</a></li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
            {% if zoneMaillage.outreMer is not empty %}
              <div class="col-lg-6">
                <h3 class="h6 text-uppercase mb-3">Outre-mer</h3>
                <ul class="mb-0">
                  {% for link in zoneMaillage.outreMer %}
                    <li><a class="link" href="{{ link.url }}">{{ link.label }}</a></li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
          {% if zoneMaillage.hubs is defined and zoneMaillage.hubs is not empty %}
            <div class="d-flex flex-wrap gap-2 mt-4">
              {% for link in zoneMaillage.hubs %}
                <a class="btn btn-outline-primary btn-sm" href="{{ link.url }}">{{ link.label }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if faqItems is not empty %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="oling-surface p-4">
          <h2 class="h4">{{ 'common.faq'|trans }}</h2>
          <ul class="mb-0">
            {% for item in faqItems %}
              <li><strong>{{ item.question }}</strong> {{ item.answer }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>
  {% endif %}
</main>

{% set currentUrl = site_base_url ~ app.request.pathInfo %}
{% set contactUrl = site_base_url ~ path('contact') %}
{% set globalProfessionalServiceId = 'https://oling.fr/#professional-service' %}
{% set isZonePage = pageSlug starts with 'cabinet-conseil-' %}
{% set zoneName = page and page.heroBadge ? page.heroBadge|striptags|trim : '' %}
{% set schemaSameAs = oling_schema_same_as is defined ? oling_schema_same_as : [] %}
{% set schemaAddresses = [] %}
{% for agency in agencies %}
  {% set schemaAddresses = schemaAddresses|merge([{
    '@type': 'PostalAddress',
    'streetAddress': agency.streetAddress,
    'postalCode': agency.postalCode,
    'addressLocality': agency.city,
    'addressCountry': agency.countryCode ?: agency.country
  }]) %}
{% endfor %}
{% set schemaAreaServedNames = [] %}
{% if isZonePage and zoneName is not empty %}
  {% if zoneName not in schemaAreaServedNames %}
    {% set schemaAreaServedNames = schemaAreaServedNames|merge([zoneName]) %}
  {% endif %}
  {% if 'France' not in schemaAreaServedNames %}
    {% set schemaAreaServedNames = schemaAreaServedNames|merge(['France']) %}
  {% endif %}
{% elseif zoneMaillage is defined %}
  {% if zoneMaillage.hexagone is defined %}
    {% for link in zoneMaillage.hexagone %}
      {% if link.label is defined and link.label and link.label not in schemaAreaServedNames %}
        {% set schemaAreaServedNames = schemaAreaServedNames|merge([link.label]) %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if zoneMaillage.outreMer is defined %}
    {% for link in zoneMaillage.outreMer %}
      {% if link.label is defined and link.label and link.label not in schemaAreaServedNames %}
        {% set schemaAreaServedNames = schemaAreaServedNames|merge([link.label]) %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}
{% if schemaAreaServedNames is empty %}
  {% set schemaAreaServedNames = ['France'] %}
{% endif %}
{% set schemaAreaServedObjects = [] %}
{% for areaName in schemaAreaServedNames %}
  {% set schemaAreaServedObjects = schemaAreaServedObjects|merge([{
    '@type': 'AdministrativeArea',
    'name': areaName
  }]) %}
{% endfor %}
{% set schemaContactPoint = {
  '@type': 'ContactPoint',
  'contactType': 'customer support',
  'email': 'contact@oling.fr',
  'url': contactUrl,
  'availableLanguage': ['fr-FR']
} %}
{% set schemaOfferItems = [] %}
{% if zoneExpertises is defined and zoneExpertises is not empty %}
  {% for link in zoneExpertises %}
    {% if link.label is defined and link.label and link.url is defined and link.url %}
      {% set schemaOfferItems = schemaOfferItems|merge([{
        '@type': 'Offer',
        'itemOffered': {
          '@type': 'Service',
          'name': link.label,
          'url': site_base_url ~ link.url
        }
      }]) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set schemaOfferCatalog = null %}
{% if schemaOfferItems is not empty %}
  {% set schemaOfferCatalog = {
    '@type': 'OfferCatalog',
    'name': 'Expertises OLING',
    'itemListElement': schemaOfferItems
  } %}
{% endif %}
{% set serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': landingNarrative.heroTitle is defined ? landingNarrative.heroTitle|striptags : (page and page.heroTitle ? page.heroTitle|striptags : (page and page.title ? page.title|striptags : 'OLING')),
  'serviceType': landingNarrative.schemaServiceType ?? (page and page.heroBadge ? page.heroBadge|striptags : 'seo.landing.default_service_type'|trans),
  'provider': {'@id': globalProfessionalServiceId},
  'url': currentUrl,
  'mainEntityOfPage': currentUrl,
  'description': landingNarrative.metaDescription ?? (page and page.metaDescription ? page.metaDescription : 'seo.landing.default_schema_description'|trans),
  'areaServed': schemaAreaServedNames,
  'serviceArea': schemaAreaServedObjects,
  'contactPoint': schemaContactPoint,
  'potentialAction': {
    '@type': 'ContactAction',
    'target': {
      '@type': 'EntryPoint',
      'urlTemplate': contactUrl
    }
  },
  'sameAs': schemaSameAs
} %}
{% if schemaOfferCatalog %}
  {% set serviceSchema = serviceSchema|merge({'offers': schemaOfferCatalog}) %}
{% endif %}
<script type="application/ld+json">
{{ serviceSchema|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}
</script>
{% if isZonePage and zoneName is not empty %}
  {% set zoneArea = [{ '@type': 'AdministrativeArea', 'name': zoneName }] %}
  {% set localBusinessSchema = {
    '@type': 'LocalBusiness',
    '@id': currentUrl ~ '#localbusiness',
    'name': 'OLING Management et Technologie',
    'url': currentUrl,
    'mainEntityOfPage': currentUrl,
    'branchOf': {'@id': globalProfessionalServiceId},
    'description': page and page.metaDescription ? page.metaDescription : '',
    'serviceArea': zoneArea,
    'areaServed': zoneArea,
    'contactPoint': schemaContactPoint,
    'sameAs': schemaSameAs,
    'address': schemaAddresses
  } %}
  {% if schemaOfferCatalog %}
    {% set localBusinessSchema = localBusinessSchema|merge({'hasOfferCatalog': schemaOfferCatalog}) %}
  {% endif %}
  {% set professionalServiceSchema = {
    '@type': 'ProfessionalService',
    '@id': currentUrl ~ '#professionalservice',
    'name': 'OLING Management et Technologie',
    'url': currentUrl,
    'mainEntityOfPage': currentUrl,
    'description': page and page.metaDescription ? page.metaDescription : '',
    'serviceType': page and page.heroBadge ? page.heroBadge|striptags : 'Conseil',
    'serviceArea': zoneArea,
    'areaServed': zoneArea,
    'provider': {'@id': currentUrl ~ '#localbusiness'},
    'contactPoint': schemaContactPoint,
    'sameAs': schemaSameAs
  } %}
  {% if schemaOfferCatalog %}
    {% set professionalServiceSchema = professionalServiceSchema|merge({'hasOfferCatalog': schemaOfferCatalog}) %}
  {% endif %}
  {% set localSeoGraph = {
    '@context': 'https://schema.org',
    '@graph': [localBusinessSchema, professionalServiceSchema]
  } %}
  <script type="application/ld+json">
  {{ localSeoGraph|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}
  </script>
{% endif %}
{% if faqItems is not empty %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faqItems %}
    {
      "@type": "Question",
      "name": "{{ item.question|e('js') }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ item.answer|e('js') }}"
      }
    }{{ not loop.last ? ',' }}
    {% endfor %}
  ]
}
</script>
{% endif %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  var root = document.querySelector('.oling-seo-cabinet');
  if (!root) {
    return;
  }

  var blocks = root.querySelectorAll('.oling-section, .oling-surface, .oling-method');
  blocks.forEach(function (block) {
    var ctas = Array.prototype.slice.call(block.querySelectorAll('a.btn'));
    if (ctas.length <= 1) {
      return;
    }

    for (var i = 1; i < ctas.length; i++) {
      ctas[i].classList.add('oling-cta-secondary');
    }
  });
});
</script>
{% endblock %}

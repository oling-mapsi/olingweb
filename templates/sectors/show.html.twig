{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}

{% block body %}
{% set locale = app.request.locale|default('fr') %}
{% set ui = {
  fr: {primary: 'Parler de votre contexte', all: 'Voir tous les secteurs', issues: 'Vos enjeux', issues_title: 'Les priorités de votre secteur', recommended: 'Expertises recommandées', recommended_title: 'Nos expertises pour vous accompagner', more: "Voir l'expertise", cta_title: 'Parlons de vos priorités', cta_text: 'Du diagnostic au pilotage de projet, nos consultants vous aident à définir les actions à engager et à coordonner leur mise en œuvre.', cta_label: 'Demander un échange'},
  en: {primary: 'Discuss your context', all: 'View all sectors', issues: 'Typical issues', issues_title: 'Priorities for your industry', recommended: 'Recommended expertise', recommended_title: 'Expertise for your project', more: 'View expertise', cta_title: 'Build a roadmap suited to your environment', cta_text: 'Our consultants support diagnostics, project scoping and coordination with your business and IT teams.', cta_label: 'Request a discussion'},
  es: {primary: 'Hablar de su contexto', all: 'Ver todos los sectores', issues: 'Retos típicos', issues_title: 'Las prioridades de su sector', recommended: 'Especializaciones recomendadas', recommended_title: 'Especialidades para su proyecto', more: 'Ver especialización', cta_title: 'Construir una trayectoria adaptada a su entorno', cta_text: 'Nuestros consultores acompañan el diagnóstico, la definición y la coordinación del proyecto con los equipos de negocio y SI.', cta_label: 'Solicitar una conversación'}
}[locale]|default({}) %}
<main id="content" role="main" class="oling-public-editorial oling-public-editorial--detail oling-public-editorial--sector-detail">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.intro,
    primaryCta: {route: 'contact', label: ui.primary},
    secondaryCta: {route: 'sectors_index', label: ui.all},
    highlights: page.issues|slice(0, 3),
    image: page.heroImage|default(null),
    imageAlt: page.heroImageAlt|default(page.title),
    imageCaption: page.heroImageCaption|default(null),
    imageFocalPoint: page.heroImageFocalPoint|default(null)
  } %}

  <section class="oling-shell-section">
    <div class="container">
      <div class="oling-surface oling-surface--light">
        <span class="oling-kicker">{{ ui.issues }}</span>
        <h2>{{ ui.issues_title }}</h2>
        <ul class="oling-check-list">
          {% for issue in page.issues %}
            <li>{{ issue }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>

  <section class="oling-shell-section oling-shell-section--tint">
    <div class="container">
      <div class="oling-section-head">
        <span class="oling-kicker">{{ ui.recommended }}</span>
        <h2>{{ ui.recommended_title }}</h2>
      </div>
      <div class="oling-editorial-grid">
        {% for slug in page.linkedExpertises %}
          {% set linkedPage = expertisePages[slug] ?? null %}
          {% if linkedPage %}
            <a class="oling-editorial-card" href="{{ linkedPage.href|default(path('expertises_show', {slug: slug})) }}">
              <span class="oling-kicker">{{ linkedPage.eyebrow }}</span>
              <h3>{{ linkedPage.title }}</h3>
              <p>{{ linkedPage.intro }}</p>
              <span class="oling-editorial-card__more">{{ ui.more }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {% include 'public/_cta_band.html.twig' with {
    title: ui.cta_title,
    text: ui.cta_text,
    primaryCta: {route: 'contact', label: ui.cta_label}
  } %}
</main>
{% endblock %}

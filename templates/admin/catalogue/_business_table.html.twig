<div class="cms-table-wrap"><table class="cms-table"><thead><tr><th>Image</th><th>{{ mode|default('')=='service' ? 'Prestation' : 'Nom' }}</th><th class="cms-family">{{ mode|default('')=='site' ? 'Catégorie' : 'Famille métier' }}</th>{% if mode|default('')=='service' and not organize|default(false) %}<th class="cms-pages-count">Pages</th>{% endif %}<th>Statut</th><th></th></tr></thead><tbody>
{% for row in rows %}<tr data-cms-key="{{ row.key }}"><td>{% include 'admin/catalogue/_thumbnail.html.twig' %}</td><td><strong>{{ mode|default('')=='site' ? row.pageLabel : row.title }}</strong>{% if row.technical=='service' and row.associated|length %}<span class="cms-associated">{% for associated in row.associated %}<a href="{{ associated.edit }}">{{ associated.type=='expertise' ? 'Expertise' : 'Page SEO' }} · {{ associated.title }}</a>{% endfor %}</span>{% endif %}<span class="cms-subtitle cms-description">{{ row.description }}</span>{% if row.technical=='page' and row.type in ['service','expertise'] %}<small class="cms-subtitle">{{ row.type=='expertise' ? 'Expertise' : 'Page SEO' }}{% if organize|default(false) %} · à organiser{% endif %}</small>{% endif %}</td><td class="cms-family">{% if mode|default('')=='site' %}{{ {'home':'Accueil','company':'À propos / entreprise','contact':'Contact','local':'Page locale','sector':'Secteur','legal':'Légal','other':'Autre page'}[row.category] }}{% else %}{{ row.practice ? row.practice.designation : 'À organiser' }}{% endif %}</td>{% if mode|default('')=='service' and not organize|default(false) %}<td class="cms-pages-count">{% if row.technical=='service' %}{{ 1+row.associated|length }}{% else %}1{% endif %}</td>{% endif %}<td><span class="cms-status cms-status-{{ row.status }}">{{ row.statusLabel }}</span></td><td><a class="btn btn-outline-primary btn-sm" href="{{ row.technical=='service' ? path('admin_catalogue_service',{id:row.id}) : (mode|default('')=='site' and row.category=='home' ? path('admin_home_content') : row.edit) }}">{{ row.technical=='page' and row.type in ['service','expertise'] ? 'Modifier cette page' : 'Gérer' }}</a></td></tr>
{% else %}<tr><td colspan="6">Aucun résultat. Essayez un autre terme ou retirez un filtre.</td></tr>{% endfor %}</tbody></table></div>

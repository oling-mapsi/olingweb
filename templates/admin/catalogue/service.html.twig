{% extends 'base.html.twig' %}
{% block title %}{{ service.designation }} | Admin{% endblock %}
{% block body %}<main class="admin">
<a class="small" href="{{ path('admin_catalogue_index',{type:'service'}) }}">← Prestations & expertises</a>
<div class="cms-editor-head mt-3"><div><h1>{{ service.designation }}</h1><p>{{ service.catalogPractice ? service.catalogPractice.designation : 'Famille à organiser' }}</p><p class="mt-2">{{ presentation.description }}</p></div>{% if presentation.thumbnail %}<img class="cms-editor-image" src="{{ presentation.thumbnail }}" alt="{{ service.designation }}">{% endif %}</div>
<section class="cms-card"><h2>Page de la prestation</h2><p class="small text-muted">Service historique #{{ service.id }} · {{ serviceUrl ?: 'URL non renseignée' }}</p><p>Présentation commerciale, méthode, livrables, références et illustrations conservés dans cet éditeur.</p><a class="btn btn-primary btn-sm" href="{{ path('admin_services_edit',{id:service.id}) }}">Modifier cette page</a> <a class="btn btn-outline-primary btn-sm" href="{{ path('admin_services_edit',{id:service.id,section:'images'}) }}#illustrations">Modifier ses images</a>{% if serviceUrl %} <a class="btn btn-outline-secondary btn-sm" href="{{ serviceUrl }}" target="_blank" rel="noopener">Voir la page</a>{% endif %}</section>
<section class="cms-card"><h2>Pages associées</h2><p class="small text-muted">Chaque page conserve son contenu, ses images et ses traductions.</p>
{% for row in presentation.associated %}<div class="d-flex align-items-center gap-3 border-top py-3">{% include 'admin/catalogue/_thumbnail.html.twig' %}<div class="flex-grow-1"><strong>{{ row.title }}</strong><small class="d-block text-muted">{{ row.type=='expertise' ? 'Expertise' : 'SitePage SEO' }} #{{ row.id }} · {{ row.url ?: row.slug }}</small></div><a class="btn btn-outline-primary btn-sm" href="{{ row.edit }}">Modifier cette page</a></div>{% else %}<p>Aucune page n’est encore rattachée à cette prestation.</p><a href="{{ path('admin_catalogue_index',{type:'service',view:'pages',q:service.slug}) }}">Retrouver les pages à organiser</a>{% endfor %}
<details class="cms-secondary"><summary>Associations</summary><a href="{{ path('admin_catalogue_relations',{technical:'service',id:service.id}) }}">Choisir les pages associées et la famille métier</a><p class="small mt-2 mb-0">Aucun contenu n’est fusionné ou synchronisé.</p></details></section>
</main>{% endblock %}

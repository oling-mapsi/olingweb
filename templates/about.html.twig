{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}

{% block body %}
<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.intro,
    primaryCta: page.primaryCta,
    secondaryCta: page.secondaryCta,
    highlights: page.highlights
  } %}

  {% for block in page.sections %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-two-col">
          {% for item in block.items %}
            <article class="oling-surface oling-surface--light">
              {% if item.kicker is defined %}<span class="oling-kicker">{{ item.kicker }}</span>{% endif %}
              {% if item.title is defined %}<h2>{{ item.title }}</h2>{% endif %}
              {% if item.html is defined and item.html %}
                <div class="oling-richtext">{{ item.html|raw }}</div>
              {% elseif item.list is defined and item.list %}
                <ul class="oling-check-list">
                  {% for entry in item.list %}
                    <li>{{ entry }}</li>
                  {% endfor %}
                </ul>
              {% elseif loop.last and page.legacySideHtml is defined and page.legacySideHtml %}
                <div class="oling-richtext">{{ page.legacySideHtml|raw }}</div>
              {% elseif item.text is defined %}
                <p>{{ item.text }}</p>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endfor %}

  {% if teamPreview is defined and teamPreview|length > 0 %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head oling-about-team-head">
          <span class="oling-kicker">{{ page.teamSection.kicker }}</span>
          <h2>{{ page.teamSection.title }}</h2>
          <p>{{ page.teamSection.intro }}</p>
        </div>
        <div class="oling-about-team-grid">
          {% for member in teamPreview %}
            <article class="oling-about-team-card">
              <div class="oling-about-team-card__top">
                <img class="oling-about-team-card__avatar" src="{{ member.photo ?: asset('img/160x160/img1.jpg') }}" alt="Photo de {{ member.noncomplet }}">
                {% if member.titre %}
                  <p class="oling-about-team-card__title">{{ member.titre }}</p>
                {% endif %}
              </div>
              <div class="oling-about-team-card__body">
                <h3 class="oling-about-team-card__name">{{ member.noncomplet }}</h3>
                {% if member.shortcv %}
                  <p class="oling-about-team-card__text">{{ member.shortcv|striptags|slice(0, 170) ~ '…' }}</p>
                {% endif %}
                {% if member.linkedin %}
                  <a class="oling-about-team-card__link" href="{{ member.linkedin }}" target="_blank" rel="noopener">Voir sur LinkedIn</a>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
        <div class="oling-section-actions oling-about-team__actions mt-4">
          <a class="btn btn-primary" href="{{ path(page.teamSection.primaryCta.route, page.teamSection.primaryCta.routeParams|default({})) }}">{{ page.teamSection.primaryCta.label }}</a>
          <a class="btn btn-outline-dark" href="{{ path(page.teamSection.secondaryCta.route, page.teamSection.secondaryCta.routeParams|default({})) }}">{{ page.teamSection.secondaryCta.label }}</a>
        </div>
      </div>
    </section>
  {% endif %}

  {% if page.legacyBodyHtml is defined and page.legacyBodyHtml %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ page.bodySection.kicker }}</span>
          <h2>{{ page.bodySection.title }}</h2>
        </div>
        <div class="oling-surface oling-surface--light">
          <div class="oling-richtext">{{ page.legacyBodyHtml|raw }}</div>
        </div>
      </div>
    </section>
  {% endif %}

  <section class="oling-shell-section">
    <div class="container">
      <div class="oling-section-head">
        <span class="oling-kicker">{{ page.linksSection.kicker }}</span>
        <h2>{{ page.linksSection.title }}</h2>
      </div>
      <div class="oling-service-link-grid">
        {% for link in page.linksSection.links %}
          <a class="oling-service-link-card" href="{{ link.route is defined ? path(link.route, link.routeParams|default({})) : link.url }}" {% if link.url is defined %}target="_blank" rel="noopener"{% endif %}>
            <span class="oling-kicker">{{ link.kicker }}</span>
            <h3>{{ link.title }}</h3>
            <p>{{ link.text }}</p>
            <span class="oling-service-link-card__more">{{ link.moreLabel }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  {% include 'public/_cta_band.html.twig' with {
    title: page.cta.title,
    text: page.cta.text,
    primaryCta: page.cta.primaryCta
  } %}
</main>
{% endblock %}

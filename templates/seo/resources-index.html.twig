{% extends 'base.html.twig' %}

{% block title %}{{ page and page.title ? page.title : 'Ressources | OLING' }}{% endblock %}
{% block meta_description %}{{ page and page.metaDescription ? page.metaDescription : 'Ressources OLING.' }}{% endblock %}

{% block body %}
{% set faqItems = pageFaqItems is defined and pageFaqItems is not empty ? pageFaqItems : [] %}
<main id="content" role="main" class="oling-seo-cabinet">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page and page.heroBadge ? page.heroBadge : 'Ressources OLING',
    title: page and page.heroTitle ? page.heroTitle : 'Des ressources pour cadrer plus vite, arbitrer plus proprement et sécuriser les transformations',
    intro: page and page.heroIntro ? page.heroIntro|striptags : "Cette bibliothèque rassemble des contenus de cadrage, des retours terrain et des points de vigilance sur les sujets ERP, SI, conformité, RGPD, cyber et IA.",
    primaryCta: {route: 'contact', label: 'Parler de votre sujet'},
    secondaryCta: {route: 'expertises_index', label: 'Voir les expertises'},
    highlights: ['AMO ERP et SI', 'Conformité, RGPD, cyber', 'IA utile et gouvernée']
  } %}

  {% if articles is not empty %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">Bibliothèque</span>
          <h2>Contenus de cadrage, retours terrain et points de vigilance</h2>
          <p>Les ressources complètent les expertises et les services avec un format plus pédagogique : méthode, vigilance, arbitrages et retours d’expérience.</p>
        </div>
        <div class="oling-editorial-grid">
          {% for article in articles %}
            <article class="oling-editorial-card">
              <span class="oling-kicker">Ressource</span>
              <h2><a class="link" href="{{ path('seo_resource', {slug: article.slug}) }}">{{ article.h1 }}</a></h2>
              {% if article.intro is not empty %}
                <p>{{ article.intro }}</p>
              {% endif %}
              <a class="oling-editorial-card__more" href="{{ path('seo_resource', {slug: article.slug}) }}">Lire l'article</a>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if page and page.heroSideHtml %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-surface oling-surface--light">
          <div class="oling-richtext oling-resource-content">{{ page.heroSideHtml|raw }}</div>
        </div>
      </div>
    </section>
  {% endif %}

  {% if faqItems is not empty %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-surface oling-surface--light">
          <span class="oling-kicker">FAQ</span>
          <h2>Questions fréquentes</h2>
          <ul class="oling-check-list mb-0">
            {% for item in faqItems %}
              <li><strong>{{ item.question }}</strong> {{ item.answer }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>
  {% endif %}
</main>
{% endblock %}

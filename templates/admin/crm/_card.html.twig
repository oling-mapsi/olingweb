<article class="deal-card compact-card" data-id="{{ d.id }}" data-version="{{ d.version }}" data-url="{{ path('admin_crm_move',{id:d.id}) }}" draggable="true">
  <div class="card-meta"><span class="drag-grip" aria-hidden="true" title="Glisser pour déplacer">⠿</span><span>{{ d.kind=='public' or d.origin=='watch'?'Marché public':'Client' }} {{ d.site }}</span>{% if d.origin=='watch' %}<span class="crm-badge decision-badge">{{ decisions[d.decision] }}</span>{% endif %}</div>
  <h3><a draggable="false" href="{{ path('admin_crm_show',{id:d.id}) }}">{{ d.title }}</a></h3>
  <p class="company">{{ d.organization ?: d.buyer ?: 'Société à préciser' }}</p>
  {% if d.next_action %}<p class="compact-action">→ {{ d.next_action }}</p>{% endif %}
  <div class="compact-footer"><span>{% if d.reminder %}Relance · {{ d.reminder|date('d/m','Europe/Paris') }}{% elseif d.deadline %}Échéance · {{ d.deadline|date('d/m','Europe/Paris') }}{% elseif d.amount %}{{ d.amount }} €{% endif %}</span><button type="button" class="card-details-toggle" aria-expanded="false" aria-controls="details-{{ d.id }}" aria-label="Détails de {{ d.title }}">Détails ↗</button></div>
  <section id="details-{{ d.id }}" class="card-details" aria-labelledby="details-title-{{ d.id }}" hidden>
    <button type="button" class="card-details-close" aria-label="Fermer les détails">×</button>
    <h4 id="details-title-{{ d.id }}">{{ d.title }}</h4>
    <p class="company">{{ d.organization ?: d.buyer ?: 'Société à préciser' }}</p>
    <p class="contact">{{ d.contact ?: 'Contact à préciser' }}{% if d.email %}<br>{{ d.email }}{% endif %}{% if d.phone %}<br>{{ d.phone }}{% endif %}</p>
    {% if d.summary %}<p class="preview-need">{{ d.summary|slice(0,600) }}{{ d.summary|length>600?'…':'' }}</p>{% endif %}
    <div class="next-action"><small>PROCHAINE ACTION</small><p>{{ d.next_action ?: 'À définir' }}</p>{% if d.reminder %}<time>Relance · {{ d.reminder|date('d/m/Y H:i','Europe/Paris') }}</time>{% endif %}</div>
    {% if d.deadline %}<p class="deadline">Échéance · {{ d.deadline|date('d/m/Y H:i','Europe/Paris') }}</p>{% endif %}
    {% if d.amount %}<p>{{ d.amount }} €</p>{% endif %}
    {% if view!='markets' %}<label class="status-label">Changer le statut<select class="card-status" aria-label="Statut de {{ d.title }}">{% for value,label in statuses %}<option value="{{ value }}" {{ value==d.status?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label>{% else %}<label class="status-label">Décision<select class="card-status" aria-label="Décision de {{ d.title }}">{% for value,label in decisions %}<option value="{{ value }}" {{ value==d.decision?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label>{% endif %}
    <a draggable="false" class="card-link" href="{{ path('admin_crm_show',{id:d.id}) }}">Ouvrir la fiche complète →</a>
  </section>
</article>

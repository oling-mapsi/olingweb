{% extends 'admin/crm/layout.html.twig' %}
{% block crm %}
<header class="page-head"><div><div class="eyebrow">RELATIONS & DÉVELOPPEMENT</div><h1>{{ {portfolio:'Votre portefeuille',markets:'Marchés publics',clients:'Demandes clients',todo:'Actions et relances',review:'Imports à réviser',qualify:'À qualifier',all:'Toutes les affaires',active:'Affaires en cours'}[view]|default('Votre portefeuille') }}</h1><p>{{ view=='markets'?'Examinez les avis, choisissez les marchés à suivre.':(view=='clients'?'Les demandes reçues et les échanges à qualifier.':'Les opportunités suivies, du premier échange à la décision.') }}</p></div><a class="btn primary" href="{{ path('admin_crm_new') }}">＋ Nouvelle affaire</a></header>
<div class="overview"><div><strong>{{ total }}</strong><span>fiches dans cette vue</span></div><div><strong>{{ view=='markets'?'Avis & lots':'Suivi commercial' }}</strong><span>{{ view=='markets'?'Une décision par marché':'Les prochaines actions restent visibles' }}</span></div><div><strong>{{ connections.environment=='prod'?'Production':'Développement' }}</strong><span>{{ connections.environment=='prod'?'Espace de travail OLING':'Données fictives · connecteurs désactivés' }}</span></div></div>
<form class="filters" method="get"><input type="hidden" name="view" value="{{ view }}"><input type="hidden" name="mode" value="{{ mode }}"><label class="search">Recherche<input name="q" value="{{ q }}" placeholder="Société, contact, référence, affaire…"></label><label>Origine<select name="origin"><option value="">Toutes</option>{% for key,label in {form:'Formulaire',email:'Email',watch:'Veille',manual:'Manuelle'} %}<option value="{{ key }}" {{ origin==key?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label><label>Statut<select name="status"><option value="">Tous</option>{% for key,label in statuses %}<option value="{{ key }}" {{ status==key?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label>{% if view=='markets' %}<label>Décision<select name="decision"><option value="">Toutes</option>{% for key,label in decisions %}<option value="{{ key }}" {{ decision==key?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label>{% endif %}<label>Échéance<select name="due"><option value="">Toutes</option><option value="overdue" {{ due=='overdue'?'selected':'' }}>En retard</option><option value="week" {{ due=='week'?'selected':'' }}>Sous 7 jours</option></select></label><button>Appliquer</button></form>
<div class="view-toolbar"><div class="segmented"><a class="{{ mode=='board'?'selected':'' }}" href="{{ path('admin_crm',app.request.query.all|merge({mode:'board',page:1})) }}">▥ Kanban</a><a class="{{ mode=='list'?'selected':'' }}" href="{{ path('admin_crm',app.request.query.all|merge({mode:'list',page:1})) }}">☰ Liste</a></div><div class="crm-actions"><a href="{{ path('admin_crm',{view:'review',mode:'list'}) }}">Imports à réviser</a><a href="{{ path('admin_crm_export') }}">Exporter CSV</a></div></div>
{% if mode=='board' %}<div class="board" data-token="{{ csrf_token('crm') }}">
{% set columns=view=='markets'?decisions:statuses %}{% for key,label in columns %}<section class="lane" {% if view!='markets' %}data-status="{{ key }}"{% endif %}><header><span class="dot dot-{{ key }}"></span><h2>{{ label }}</h2><span>{{ deals|filter(d => (view=='markets'?d.decision:d.status)==key)|length }}</span></header><div class="lane-cards">{% for d in deals %}{% if (view=='markets'?d.decision:d.status)==key %}{% include 'admin/crm/_card.html.twig' %}{% endif %}{% endfor %}</div></section>{% endfor %}</div>{% else %}
<div class="crm-card crm-table"><table><thead><tr><th>Affaire / société</th><th>Contact</th><th>{{ view=='markets'?'Décision':'Statut' }}</th><th>Prochaine action</th><th>Échéance</th><th>Origine</th></tr></thead><tbody>{% for d in deals %}<tr><td><a href="{{ path('admin_crm_show',{id:d.id}) }}"><strong>{{ d.title }}</strong></a><small>{{ d.organization ?: d.buyer ?: 'Société à préciser' }}</small></td><td>{{ d.contact ?: 'À préciser' }}<small>{{ d.email }}</small></td><td><span class="crm-badge">{{ view=='markets'?decisions[d.decision]:statuses[d.status] }}</span></td><td>{{ d.next_action ?: 'À définir' }}<small>{{ d.reminder?d.reminder|date('d/m/Y H:i','Europe/Paris'):'' }}</small></td><td>{{ d.deadline?d.deadline|date('d/m/Y H:i','Europe/Paris'):'—' }}</td><td>{{ {form:'Formulaire',email:'Email',watch:'Veille',manual:'Manuelle'}[d.origin] }} {{ d.site }}</td></tr>{% else %}<tr><td colspan="6">Aucune fiche. Modifiez les filtres ou ajoutez une affaire.</td></tr>{% endfor %}</tbody></table></div>{% endif %}
<div class="pagination">{% if page>1 %}<a href="{{ path('admin_crm',app.request.query.all|merge({page:page-1})) }}">← Précédent</a>{% endif %}<span>Page {{ page }} · {{ total }} résultat(s)</span>{% if page*50<total %}<a href="{{ path('admin_crm',app.request.query.all|merge({page:page+1})) }}">Suivant →</a>{% endif %}</div>
<details class="connections"><summary>Connexions et alimentation</summary><p>Outlook : {{ connections.email?'Connecté en lecture seule':'Désactivé' }} · Veille : {{ connections.watch?'Import activé':'Désactivée' }} · Tâches : {{ connections.scheduler?'Activées':'Désactivées' }}</p><p>Dernier passage Outlook : {{ sync.last_success|default('En attente') }} · Import veille : {{ watch.last_success|default('En attente') }}</p>{% if sync.next|default(null) %}<p>Lecture de l’historique en cours.</p>{% endif %}{% if sync.error|default(null) %}<p class="alert alert-danger">{{ sync.error }}</p>{% endif %}<p>Formulaires : {{ forms.pending|default(0) }} en attente de reprise · {{ forms.mapsi_notification_pending|default(0) }} notification(s) MAPSI à vérifier · Dernier traitement : {{ forms.last_success|default('En attente') }}</p><form method="post" action="{{ path('admin_crm_sync') }}"><input type="hidden" name="_token" value="{{ csrf_token('crm') }}"><button {% if not connections.email or not connections.scheduler %}disabled{% endif %}>Relancer l’alimentation</button></form></details>
{% endblock %}

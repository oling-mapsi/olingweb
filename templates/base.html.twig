<!DOCTYPE html>
<html lang="fr">
{% set currentRoute = app.request.attributes.get('_route') %}
{% set currentSlug = app.request.attributes.get('slug') %}
{% set currentPracticeSlug = app.request.attributes.get('practice') %}
{% set isAdminPage = currentRoute starts with 'admin_' or app.request.pathinfo starts with '/admin' %}
{% set expertisesActive = currentRoute in ['expertises_index', 'expertises_show'] or (currentRoute == 'practice_home' and currentSlug in ['consulting', 'expertises-audit', 'business-apps']) or (currentRoute == 'service' and currentPracticeSlug in ['consulting', 'expertises-audit', 'business-apps']) or (currentRoute == 'practice' and currentSlug in ['consulting', 'expertises-audit', 'business-apps']) %}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="robots" content="{% if currentRoute starts with 'admin_' or currentRoute in ['login', 'logout', 'growth_preview_article'] or app.request.pathinfo starts with '/admin' or app.request.pathinfo starts with '/login' or app.request.pathinfo starts with '/logout' or app.request.pathinfo starts with '/preview/' %}noindex,nofollow{% else %}index,follow,max-image-preview:large{% endif %}" />
    <title>{% block title %}{% endblock %}</title>
    <link rel="shortcut icon" href="/favicon.ico">
    {% set meta_description %}{% block meta_description %}{% endblock %}{% endset %}
    <meta name="description" content="{{ meta_description|striptags|trim }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Teko:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="canonical" href="{% block canonical_url %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}" />
    <link rel="alternate" hreflang="fr-FR" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}" />
    <link rel="alternate" hreflang="x-default" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}" />
    <meta property="og:title" content="{{ block('title')|striptags|trim }}">
    <meta property="og:description" content="{{ meta_description|striptags|trim }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
    <meta property="og:image" content="https://oling.fr/img/1920x1080/security.jpg">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title')|striptags|trim }}">
    <meta name="twitter:description" content="{{ meta_description|striptags|trim }}">
    <meta name="theme-color" content="#2F5D62">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": "https://oling.fr/#professional-service",
      "name": "OLING Management et Technologie",
      "url": "https://oling.fr",
      "mainEntityOfPage": "https://oling.fr/",
      "logo": "https://oling.fr/img/logo/logoling.png",
      "description": "Cabinet de conseil pour PME, PMI et ETI : transformation SI, ERP, organisation, conformité, cybersécurité et intelligence artificielle.",
      "areaServed": ["France", "Guadeloupe", "Martinique", "Guyane", "Réunion", "Saint-Pierre-et-Miquelon"],
      "email": "contact@oling.fr",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "email": "contact@oling.fr",
        "url": "https://oling.fr/contact",
        "availableLanguage": ["fr-FR"]
      },
      "address": [
        {% for agency in agencies %}
        {
          "@type": "PostalAddress",
          "streetAddress": "{{ agency.streetAddress|e('js') }}",
          "postalCode": "{{ agency.postalCode|e('js') }}",
          "addressLocality": "{{ agency.city|e('js') }}",
          "addressCountry": "{{ (agency.countryCode ?: agency.country)|e('js') }}"
        }{{ not loop.last ? ',' }}
        {% endfor %}
      ],
      "sameAs": [
        {% for sameAsUrl in oling_schema_same_as %}
        "{{ sameAsUrl|e('js') }}"{{ not loop.last ? ',' }}
        {% endfor %}
      ]
    }
    </script>
</head>
<body class="oling-body oling-refresh{% if app.request.pathinfo == '/' %} oling-home{% endif %}{% if isAdminPage %} admin{% endif %}{% block body_class %}{% endblock %}" data-ga-id="G-1EN73LS1B3">
    {% if not isAdminPage %}
    <header id="header" class="oling-header navbar navbar-expand-lg navbar-show-hide"
            data-hs-header-options='{"fixMoment": 0, "fixEffect": "slide"}'>
        <div class="container">
            <nav class="js-mega-menu navbar-nav-wrap oling-topbar">
                <a class="navbar-brand oling-brand" href="{{ path('index') }}" aria-label="OLING">
                    <img src="{{ asset('/img/logo/logoling.png') }}" alt="Logo OLING">
                </a>

                <button type="button" class="navbar-toggler ms-auto d-print-none" data-bs-toggle="collapse" data-bs-target="#navbarNavMenuLeftAligned" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="navbarNavMenuLeftAligned">
                    <span class="navbar-toggler-default d-print-none"><i class="bi-list"></i></span>
                    <span class="navbar-toggler-toggled d-print-none"><i class="bi-x"></i></span>
                </button>

                <div class="navbar-nav-wrap-col collapse navbar-collapse d-print-none" id="navbarNavMenuLeftAligned">
                    <ul class="navbar-nav ms-lg-auto align-items-lg-center">
                        <li class="hs-has-mega-menu nav-item"
                            data-hs-mega-menu-item-options='{"desktop":{"position":"left"}}'>
                            <a id="expertisesMegaMenu"
                               class="hs-mega-menu-invoker hs-mega-menu__invoker nav-link {% if expertisesActive %}active{% endif %}"
                               href="{{ path('expertises_index') }}"
                               aria-expanded="false">Expertises</a>
                            <div class="oling-mobile-mega d-lg-none">
                                {% for practice in practices|default([]) %}
                                    {% if practice.slug in ['consulting', 'expertises-audit', 'business-apps'] %}
                                        <a class="oling-mobile-mega__group" href="{{ path('practice_home', {slug: practice.slug}) }}">{{ practice.designation }}</a>
                                        <div class="oling-mobile-mega__links">
                                            {% for service in services|default([]) %}
                                                {% if service.practice and service.practice.slug == practice.slug %}
                                                    <a class="oling-mobile-mega__link" href="{{ path('service', {practice: service.practice.slug, slug: service.slug}) }}">{{ service.designation }}</a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                {% endfor %}
                                <a class="oling-mobile-mega__all" href="{{ path('expertises_index') }}">Voir toutes les expertises</a>
                            </div>
                            {% if practices is defined and services is defined %}
                                <div class="hs-mega-menu oling-mega-menu oling-mega-menu--needs" aria-labelledby="expertisesMegaMenu">
                                    {% include 'public/_expertise_groups.html.twig' with {variant: 'menu', practices: practices, services: services} %}
                                </div>
                            {% endif %}
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute in ['sectors_index', 'sectors_show', 'metiers'] %}active{% endif %}" href="{{ path('sectors_index') }}">Secteurs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute in ['projets', 'projets_more'] %}active{% endif %}" href="{{ path('projets') }}">Cas clients</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute == 'apropos' %}active{% endif %}" href="{{ path('apropos') }}">Cabinet</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute == 'seo_resources_index' %}active{% endif %}" href="{{ path('seo_resources_index') }}">Ressources</a>
                        </li>
                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-primary" href="{{ path('contact') }}">Parler à un consultant</a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="nav-link mapsi-link" href="{{ path('practice_home', {'slug': 'mapsi'}) }}" aria-label="Accéder à MAPSI">
                                <img src="{{ asset('/img/logo/mapsi.png') }}" class="logo-light-mode" alt="Logo MAPSI">
                                <img src="{{ asset('/img/logo/mapsi_blanc.png') }}" class="logo-dark-mode" alt="Logo MAPSI">
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
    </header>
    {% endif %}

    {% block body %}{% endblock %}

    {% if not isAdminPage %}
    {% include 'includes/_chat_widget.html.twig' %}

    <div id="cookie-banner" class="oling-cookie-banner" role="dialog" aria-live="polite" aria-label="Gestion des cookies">
        <div class="oling-cookie-banner__content">
            <div class="oling-cookie-banner__text">
                <strong>Gestion des cookies</strong>
                <p>Nous utilisons des cookies essentiels au fonctionnement du site. Vous pouvez accepter la mesure d’audience ou refuser tout sauf le minimum nécessaire.</p>
            </div>
            <div class="oling-cookie-banner__actions">
                <button type="button" class="btn btn-outline-light js-cookie-details">Voir les cookies</button>
                <button type="button" class="btn btn-primary js-cookie-accept">Accepter tout</button>
                <button type="button" class="btn btn-outline-light js-cookie-refuse">Refuser tout (minimum)</button>
            </div>
        </div>
        <div class="oling-cookie-banner__details">
            <div class="oling-cookie-details">
                <div class="oling-cookie-details__block">
                    <h4>Cookies essentiels (obligatoires)</h4>
                    <div class="oling-cookie-choice">
                        <label class="oling-cookie-choice__label">
                            <input type="checkbox" checked disabled>
                            Essentiels (toujours actifs)
                        </label>
                    </div>
                    <ul>
                        <li><strong>oling_cookie_consent</strong> : mémorise votre choix.</li>
                        <li><strong>PHPSESSID</strong> : cookie de session.</li>
                    </ul>
                </div>
                <div class="oling-cookie-details__block">
                    <h4>Cookies de mesure d’audience</h4>
                    <div class="oling-cookie-choice">
                        <label class="oling-cookie-choice__label">
                            <input type="checkbox" class="js-cookie-analytics">
                            Mesure d’audience (Google Analytics)
                        </label>
                    </div>
                    <ul>
                        <li><strong>_ga</strong> : identifiant Google Analytics.</li>
                        <li><strong>_ga_*</strong> : cookie GA4 lié à la propriété.</li>
                        <li><strong>_gid</strong> : mesure d’audience.</li>
                    </ul>
                </div>
                <div class="oling-cookie-details__actions">
                    <button type="button" class="btn btn-primary js-cookie-save">Enregistrer mes choix</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="oling-footer d-print-none">
        <div class="container">
            <div class="oling-footer__top">
                <div>
                    <span class="oling-kicker">OLING</span>
                    <h2>Cabinet de conseil pour transformations métier, SI, conformité et résilience.</h2>
                    <p>OLING accompagne les PME, PMI et ETI sur les projets structurants qui exigent de la clarté, de la gouvernance et une exécution solide.</p>
                </div>
                <div class="oling-footer__cta">
                    <a class="btn btn-primary" href="{{ path('contact') }}">Demander un échange</a>
                </div>
            </div>

            <div class="oling-footer__grid">
                <div>
                    <span class="oling-footer__title">Expertises</span>
                    <ul>
                        <li><a href="{{ path('practice_home', {slug: 'consulting'}) }}">Stratégie et conseil</a></li>
                        <li><a href="{{ path('practice_home', {slug: 'expertises-audit'}) }}">Conformité & Risques</a></li>
                        <li><a href="{{ path('practice_home', {slug: 'business-apps'}) }}">Opérations et technologie</a></li>
                        <li><a href="{{ path('expertises_index') }}">Toutes les expertises</a></li>
                        <li><a href="{{ path('services_index') }}">Tous les services</a></li>
                    </ul>
                </div>
                <div>
                    <span class="oling-footer__title">Secteurs</span>
                    <ul>
                        <li><a href="{{ path('sectors_show', {slug: 'industrie'}) }}">Industrie et PMI</a></li>
                        <li><a href="{{ path('sectors_show', {slug: 'services'}) }}">Services B2B</a></li>
                        <li><a href="{{ path('sectors_show', {slug: 'secteur-public'}) }}">Organisations régulées</a></li>
                        <li><a href="{{ path('projets') }}">Cas clients</a></li>
                        <li><a href="{{ path('seo_resources_index') }}">Ressources</a></li>
                    </ul>
                </div>
                <div>
                    <span class="oling-footer__title">Cabinet</span>
                    <ul>
                        <li><a href="{{ path('apropos') }}">À propos</a></li>
                        <li><a href="{{ path('team') }}">Équipe</a></li>
                        <li><a href="{{ path('metiers') }}">Nos métiers</a></li>
                        <li><a href="{{ path('rse') }}">Démarche RSE</a></li>
                        <li><a href="https://mapsi.fr/" target="_blank" rel="noopener">MAPSI</a></li>
                        <li><a href="{{ path('seo_mapsi_progiciel') }}">MAPSI progiciel</a></li>
                        <li><a href="https://www.linkedin.com/company/oling-management-&-technologie/" target="_blank" rel="noopener">LinkedIn</a></li>
                    </ul>
                </div>
                <div>
                    <span class="oling-footer__title">Coordonnées</span>
                    <ul>
                        <li><a href="{{ path('contact') }}">Formulaire de contact</a></li>
                        {% if agencies is empty %}
                            <li>Présence Hexagone et DROM.</li>
                        {% else %}
                            {% for agency in agencies|slice(0, 3) %}
                                <li>
                                    {% if agency.streetAddress %}{{ agency.streetAddress }}, {% endif %}{{ agency.city }}{% if agency.postalCode %}, {{ agency.postalCode }}{% endif %}
                                </li>
                            {% endfor %}
                        {% endif %}
                        <li><a href="{{ path('polrgpd') }}">Politique RGPD</a></li>
                        <li><a href="{{ path('polsecurite') }}">Politique de sécurité</a></li>
                        <li><a href="{{ path('discloser') }}">Mentions légales</a></li>
                        <li><a href="javascript:;" class="js-cookie-manage">Gérer mes cookies</a></li>
                    </ul>
                </div>
            </div>

            <div class="oling-footer__bottom">
                <p>© OLING Management et Technologie - 2026</p>
            </div>
        </div>
    </footer>
    {% endif %}
</body>
</html>

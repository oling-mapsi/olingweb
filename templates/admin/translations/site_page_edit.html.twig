{% extends 'base.html.twig' %}

{% block title %}Traduction {{ target.locale|upper }}{% endblock %}

{% block body %}
{% include 'admin/_nav.html.twig' %}

<div class="container py-4">
  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert alert-{{ label }}">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  <a class="btn btn-sm btn-link px-0 mb-3" href="{{ path('admin_translations_index') }}">← Retour aux traductions</a>

  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="h3 mb-1">{{ target.locale|upper }} — {{ source.title }}</h1>
      <p class="text-muted mb-0">
        Statut : <strong>{{ target.translationStatus }}</strong>
        {% if outdated %}<span class="badge bg-warning text-dark ms-2">Source FR modifiée</span>{% endif %}
      </p>
    </div>
    <div class="d-flex gap-2">
      <form method="post" action="{{ path('admin_translations_site_page_generate', {id: target.sitePage.id, locale: target.locale}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('translation_generate_' ~ target.sitePage.id ~ '_' ~ target.locale) }}">
        <input type="hidden" name="confirm_overwrite" value="1">
        <button class="btn btn-outline-secondary" type="submit">Régénérer IA</button>
      </form>
      <a class="btn btn-outline-secondary" href="{{ path('admin_translations_site_page_preview', {id: target.id, locale: target.locale}) }}" target="_blank" rel="noopener">Prévisualiser</a>
      {% if target.translationStatus == 'ai_translated' %}
        <form method="post">
          <input type="hidden" name="_token" value="{{ csrf_token('translation_edit_' ~ target.id) }}">
          <input type="hidden" name="action" value="to_review">
          <button class="btn btn-outline-primary" type="submit">Passer à relire</button>
        </form>
      {% endif %}
      <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('translation_edit_' ~ target.id) }}">
        <input type="hidden" name="action" value="review">
        <button class="btn btn-outline-success" type="submit">Marquer relue</button>
      </form>
      {% if target.translationStatus != 'published' %}
        <form method="post">
          <input type="hidden" name="_token" value="{{ csrf_token('translation_edit_' ~ target.id) }}">
          <input type="hidden" name="action" value="publish">
          <button class="btn btn-success" type="submit">Publier</button>
        </form>
      {% else %}
        <form method="post">
          <input type="hidden" name="_token" value="{{ csrf_token('translation_edit_' ~ target.id) }}">
          <input type="hidden" name="action" value="unpublish">
          <button class="btn btn-outline-danger" type="submit">Dépublier</button>
        </form>
      {% endif %}
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-6">
      <h2 class="h5">Source FR</h2>
      <div class="card card-body">
        <p><strong>Statut FR</strong><br><span class="badge bg-success">{{ source.translationStatus }}</span></p>
        <p><strong>Title</strong><br>{{ source.title }}</p>
        <p><strong>Slug</strong><br><code>{{ source.slug }}</code></p>
        <p><strong>Hero</strong><br>{{ source.heroTitle }}</p>
        <p><strong>Intro</strong><br>{{ source.heroIntro|striptags }}</p>
        <p><strong>SEO</strong><br>{{ source.seoTitle }}<br>{{ source.seoDescription }}</p>
        <p><strong>Dernière source hash</strong><br><code>{{ target.sourceContentHash ?: '—' }}</code></p>
      </div>
    </div>

    <div class="col-lg-6">
      <h2 class="h5">Cible {{ target.locale|upper }}</h2>
      <form method="post" class="card card-body">
        <input type="hidden" name="_token" value="{{ csrf_token('translation_edit_' ~ target.id) }}">
        <input type="hidden" name="action" value="save">
        <label class="form-label">Title</label>
        <input class="form-control mb-3" name="title" value="{{ target.title }}">
        <label class="form-label">Slug</label>
        <input class="form-control mb-3" name="slug" value="{{ target.slug }}">
        <label class="form-label">Hero badge</label>
        <input class="form-control mb-3" name="heroBadge" value="{{ target.heroBadge }}">
        <label class="form-label">Hero title</label>
        <input class="form-control mb-3" name="heroTitle" value="{{ target.heroTitle }}">
        <label class="form-label">Hero intro</label>
        <textarea class="form-control mb-3" name="heroIntro" rows="4">{{ target.heroIntro }}</textarea>
        <label class="form-label">SEO title</label>
        <input class="form-control mb-3" name="seoTitle" value="{{ target.seoTitle }}">
        <label class="form-label">SEO description</label>
        <textarea class="form-control mb-3" name="seoDescription" rows="3">{{ target.seoDescription }}</textarea>
        <label class="form-label">Texte alternatif image</label>
        <input class="form-control mb-3" name="imageAlt" value="{{ target.imageAlt }}">
        <label class="form-label">Body HTML / JSON structuré</label>
        <textarea class="form-control font-monospace mb-3" name="bodyHtml" rows="12">{{ target.bodyHtml }}</textarea>
        <button class="btn btn-primary" type="submit">Enregistrer</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}

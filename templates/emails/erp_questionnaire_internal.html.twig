{% set c = erpContent %}
<h2>{{ c.internal_email.title }}</h2>

<h3>{{ c.internal_email.contact }}</h3>
<ul>
  <li><strong>{{ c.fields.fullName }} :</strong> {{ submission.fullName }}</li>
  <li><strong>{{ c.fields.email }} :</strong> {{ submission.email }}</li>
  <li><strong>{{ c.fields.phone }} :</strong> {{ submission.phone }}</li>
  <li><strong>{{ c.fields.company }} :</strong> {{ submission.company }}</li>
  <li><strong>{{ c.fields.jobTitle }} :</strong> {{ submission.jobTitle ?: c.summary.clarify }}</li>
  <li><strong>{{ c.fields.sector }} :</strong> {{ submission.sector ?: c.summary.clarify }}</li>
  <li><strong>{{ c.fields.organizationSize }} :</strong> {{ submission.organizationSize ?: c.summary.clarify }}</li>
  <li><strong>{{ c.fields.userCount }} :</strong> {{ submission.userCount ?: c.summary.clarify }}</li>
  <li><strong>{{ c.fields.solutionType }} :</strong> {{ submission.solutionType ?: c.summary.clarify }}</li>
  <li><strong>{{ c.internal_email.urgency }} :</strong> {{ submission.urgency ?: c.summary.clarify }}</li>
  <li><strong>{{ c.internal_email.budget }} :</strong> {{ submission.budgetRange ?: c.summary.confirm }}</li>
</ul>

<h3>{{ c.internal_email.scoring }}</h3>
<ul>
  <li><strong>{{ c.summary_titles.maturity }} :</strong> {{ scoring.maturity|default(c.summary.clarify) }}</li>
  <li><strong>{{ c.summary_titles.complexity }} :</strong> {{ scoring.complexity|default(c.summary.clarify) }}</li>
  <li><strong>{{ c.internal_email.urgency }} :</strong> {{ scoring.urgency|default(c.summary.clarify) }}</li>
  <li><strong>{{ c.internal_email.potential }} :</strong> {{ scoring.oling_potential|default(c.summary.clarify) }}</li>
  <li><strong>{{ c.internal_email.justification }} :</strong> {{ scoring.justification|default(c.summary.clarify) }}</li>
  <li><strong>{{ c.internal_email.next_action }} :</strong> {{ scoring.next_action|default(c.summary.clarify) }}</li>
  <li><strong>{{ c.internal_email.delay }} :</strong> {{ scoring.recommended_contact_delay|default(c.summary.clarify) }}</li>
</ul>

<h3>{{ c.internal_email.full_summary }}</h3>
<p><strong>{{ c.internal_email.executive }} :</strong> {{ summary.executive_summary }}</p>
<p><strong>{{ c.summary_titles.context }} :</strong> {{ summary.context }}</p>
<p><strong>{{ c.summary_titles.expressed_need }} :</strong> {{ summary.expressed_need }}</p>
<p><strong>{{ c.summary_titles.maturity }} :</strong> {{ summary.maturity }}</p>
<p><strong>{{ c.summary_titles.complexity }} :</strong> {{ summary.complexity }}</p>
<p><strong>{{ c.summary_titles.amoa_charge_estimate }} :</strong> {{ summary.amoa_charge_estimate }}</p>
<p><strong>{{ c.summary_titles.amoa_budget_estimate }} :</strong> {{ summary.amoa_budget_estimate }}</p>

{% for key in ['current_situation','functional_scope','irritants','risks','constraints','data_interfaces','security_rgpd','project_organization','recommended_deliverables','macro_approach','estimation_assumptions','priority_meeting_questions'] %}
  {% set title = c.summary_titles[key] %}
  <h3>{{ title }}</h3>
  <ul>{% for item in summary[key] %}<li>{{ item }}</li>{% endfor %}</ul>
{% endfor %}

<h3>{{ c.internal_email.raw_answers }}</h3>
<pre>{{ answers|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>

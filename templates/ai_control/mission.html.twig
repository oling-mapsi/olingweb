{% extends 'ai_control/base.html.twig' %}{% block body %}
<a href="{{ path('admin_ai',{view:'missions'}) }}">← Missions</a><div class="intro"><div><h1>{{ mission.title }}</h1><p class="muted">{{ mission.project }} · {{ mission.executor == 'unassigned' ? 'Prise en charge attendue' : mission.executor }} · {{ mission.corrections }}/2 corrections</p></div><span class="badge">{{ states[mission.status]|default(mission.status) }}</span></div>
<p class="notice">Le site conserve la demande et son suivi. Votre interlocuteur pilote la tâche Codex native ; aucune exécution ne démarre depuis cette page. Le suivi peut être transmis ponctuellement par une tâche native autorisée ; aucun connecteur permanent n’est activé.</p>
<div class="grid"><div><section class="panel"><h2>Cadrage & prompt</h2>{% if mission.status in ['draft','requested'] %}<form method="post" class="stack">{% include 'ai_control/_fields.html.twig' %}<input type="hidden" name="action" value="prompt"><textarea name="content" rows="10" maxlength="30000" aria-label="Prompt versionné" required>{{ prompt.content }}</textarea><button class="secondary">Conserver une nouvelle version</button></form>{% if mission.status == 'draft' %}<form method="post" style="margin-top:18px">{% include 'ai_control/_fields.html.twig' %}<input type="hidden" name="action" value="request"><button>Enregistrer la demande</button></form>{% endif %}{% else %}<pre>{{ prompt.content }}</pre>{% endif %}</section>
<section class="panel"><h2>Tâche native & résultats</h2>{% if binding %}<p><a href="{{ binding.task_url }}" rel="noopener noreferrer">Ouvrir la tâche native</a></p><p class="small muted">{{ binding.task_id }} · prise en charge par {{ binding.executor }}</p>{% else %}<p class="muted">Aucune tâche native associée. La demande attend une prise en charge par votre interlocuteur.</p>{% endif %}<p class="small muted">Les tests et résultats rapportés par l’exécutant restent non vérifiés ici. La clôture humaine consigne une vérification déclarée ; le site n’exécute pas lui-même les tests.</p>
{% for r in runs %}<details {{ loop.last ? 'open':'' }}><summary>{{ r.role == 'correct' ? 'Correction' : 'Réalisation' }} · {{ r.status }}</summary><p class="small muted">Modèle rapporté : {{ r.model == 'unknown' ? 'non renseigné' : r.model }} · effort {{ r.effort == 'unknown' ? 'non renseigné' : r.effort }}{% if r.model == 'unknown' or r.effort == 'unknown' %}<br>Métadonnées effectives non renseignées ; aucune valeur déduite.{% endif %}<br>Informations déclarées, non vérifiées ici ; aucun paramètre d’exécution modifié.<br>Exécution {{ r.id }}</p>{% if r.report %}<p>{{ r.report.summary }}</p><h3>Preuves liées</h3><ul>{% for p in r.report.proofs %}<li><a href="{{ p.url }}" rel="noopener noreferrer">{{ p.label }}</a></li>{% endfor %}</ul><h3>Contrôles déclarés par l’exécutant</h3><ul>{% for c in r.report.checks %}<li>{{ c.label }} : {{ {passed:'réussi selon l’exécutant',failed:'échec signalé',not_run:'non exécuté'}[c.outcome] }}</li>{% else %}<li>Aucun contrôle déclaré.</li>{% endfor %}</ul><p class="small muted">Ces déclarations ne constituent pas une vérification indépendante.</p>{% elseif r.output %}<pre>{{ r.output }}</pre>{% endif %}{% if r.failure %}<p>{{ r.failure }}</p>{% endif %}</details>{% endfor %}
{% for a in assets %}<p><a href="{{ path('admin_ai_asset',{id:a.id}) }}">{{ a.title }} · rapport privé</a></p>{% endfor %}</section>
{% if reviews|length %}<section class="panel"><h2>Revues & corrections</h2>{% for review in reviews %}<p><strong>{{ review.reviewer_id ? 'Décision dans l’interface' : 'Revue externe déclarée' }} · {{ {approve:'favorable',correct:'correction demandée',blocked:'arbitrage'}[review.verdict]|default(review.verdict) }}</strong></p><pre>{{ review.feedback }}</pre>{% endfor %}</section>{% endif %}
{% if mission.status == 'result_received' %}<form method="post" class="panel">{% include 'ai_control/_fields.html.twig' %}<input type="hidden" name="action" value="review_begin"><button>Commencer la revue</button></form>{% endif %}
{% if mission.status in ['result_received','under_review','ready_for_validation','blocked'] and runs|length %}<section class="panel"><h2>Décision humaine</h2><form method="post" class="stack">{% include 'ai_control/_fields.html.twig' %}<input type="hidden" name="action" value="review"><label for="feedback">Constat, preuves examinées et corrections attendues</label><textarea id="feedback" name="feedback" required maxlength="10000"></textarea>{% if mission.status == 'ready_for_validation' %}<label><input type="checkbox" name="verified" value="1" style="width:auto"> J’ai examiné les preuves et vérifié les critères de réussite.</label>{% endif %}<div class="actions">{% if mission.status == 'ready_for_validation' %}<button name="decision" value="approve">Valider et clôturer</button>{% endif %}{% if mission.corrections < 2 %}<button class="secondary" name="decision" value="correct">Demander une correction</button>{% endif %}<button class="secondary" name="decision" value="blocked">Demander un arbitrage</button></div></form></section>{% endif %}
{% if mission.closure %}<section class="panel"><h2>Clôture humaine</h2><pre>{{ mission.closure }}</pre><p class="small muted">Vérification déclarée par le propriétaire ; distincte des résultats rapportés par l’exécutant.</p></section>{% endif %}</div>
<aside><section class="panel"><h2>Suivi</h2><span class="badge">Pilotage natif</span><p>Une seule prise en charge par mission. Deux corrections maximum, puis arbitrage.</p>{% if mission.status == 'cancel_requested' %}<p class="notice">Arrêt demandé. Votre interlocuteur doit arrêter la tâche native et en confirmer l’état ; le site ne peut pas l’interrompre.</p>{% elseif mission.status not in ['closed','cancelled'] %}<form method="post">{% include 'ai_control/_fields.html.twig' %}<input type="hidden" name="action" value="cancel"><button class="danger">{{ mission.status in ['associated','external_running'] ? 'Demander l’arrêt externe' : 'Annuler la demande' }}</button></form>{% endif %}</section><section class="panel"><h2>Journal</h2><ul class="timeline">{% for e in events %}<li><strong class="small">{{ e.kind }}</strong><br><small>{{ e.created_at|date('d/m H:i:s','Europe/Paris') }}</small><details><summary>Détail</summary><pre>{{ e.data }}</pre></details></li>{% endfor %}</ul></section></aside></div>
{% endblock %}

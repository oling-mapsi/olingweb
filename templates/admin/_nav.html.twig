{% if not adminNavigationRendered|default(false) %}
{% set route = app.request.attributes.get('_route') %}
<style>
body.admin{background:#f5f7fa;color:#1e293b}body.admin #cms-navigation{display:flex;align-items:center;gap:4px;flex-wrap:wrap;padding:12px 24px;background:#fff;border-bottom:1px solid #dce3ec;margin:0;position:relative;z-index:20}#cms-navigation a,#cms-navigation summary{padding:8px 8px;border-radius:7px;font-size:13px;color:#475569;text-decoration:none;white-space:nowrap;display:block;font-weight:600}#cms-navigation a:hover,#cms-navigation a[aria-current=page]{background:#edf4fb;color:#145b8c}#cms-navigation details{margin-left:auto;position:relative}#cms-navigation details>div{position:absolute;right:0;min-width:240px;background:white;box-shadow:0 10px 30px #162c4620;border:1px solid #dce3ec;border-radius:8px;padding:8px}body.admin main.admin{padding:24px!important;max-width:1500px;margin:auto}body.admin main.admin>.container{padding:0!important;max-width:none}body.admin .content-space-2,body.admin .content-space-lg-3{padding-top:24px!important;padding-bottom:24px!important}body.admin main input[type=file]{width:100%;max-width:100%;min-width:0}body.admin h1{font-size:28px;margin-bottom:8px}body.admin h2{font-size:20px}body.admin .cms-intro{color:#64748b;margin-bottom:16px}.cms-toolbar{display:flex;gap:12px;align-items:end;flex-wrap:wrap;margin:16px 0}.cms-toolbar>div{min-width:145px}.cms-toolbar .cms-search{flex:1;min-width:220px}.cms-toolbar label{display:block;font-size:13px;font-weight:600;margin-bottom:5px}.cms-table-wrap{overflow:auto;background:#fff;border:1px solid #e2e8f0;border-radius:10px}.cms-table{width:100%;margin:0;font-size:14px}.cms-table th{font-size:12px;color:#64748b;background:#f8fafc;padding:11px 14px;white-space:nowrap}.cms-table td{padding:12px 14px;border-top:1px solid #eef2f6;vertical-align:middle}.cms-thumb{width:68px;height:52px;object-fit:contain;border-radius:6px;background:#f1f5f9;display:block}.cms-no-image{display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:24px}.cms-subtitle{display:block;color:#64748b;font-size:13px;max-width:450px;margin-top:3px}.cms-status{font-size:12px;display:inline-block;padding:4px 8px;border-radius:5px;background:#eef2f6;color:#475569}.cms-status-published{background:#dcfce7;color:#166534}.cms-status-draft{background:#fff3cc;color:#854d0e}.cms-tabs{display:flex;flex-wrap:wrap;gap:7px;margin:14px 0}.cms-tabs a{padding:7px 12px;background:#fff;border:1px solid #dce3ec;border-radius:6px;color:#475569;font-size:14px;text-decoration:none}.cms-tabs a[aria-current=page]{color:#145b8c;border-color:#145b8c;background:#eff6ff}.cms-pagination{display:flex;gap:16px;align-items:center;margin:18px 0;font-size:14px}.cms-card{background:#fff;border:1px solid #e2e8f0;padding:20px;border-radius:10px;margin-bottom:16px}.cms-editor-head{display:flex;justify-content:space-between;gap:16px;align-items:start;margin-bottom:18px}.cms-editor-head p{margin:0;color:#64748b;font-size:14px}.cms-editor-image{width:180px;height:120px;object-fit:contain;border-radius:8px;background:#f1f5f9}.cms-secondary{border:1px solid #e2e8f0;background:#fff;border-radius:8px;padding:14px 18px;margin:14px 0}.cms-secondary>summary{font-weight:600;cursor:pointer}.cms-secondary[open]>summary{margin-bottom:16px}.cms-media-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}.cms-media-grid img{height:140px;max-width:100%;object-fit:contain}.cms-editor-actions{display:flex;gap:10px;align-items:center;position:sticky;bottom:0;padding:12px;background:#ffffffed;border-top:1px solid #e2e8f0;z-index:10}.cms-dashboard{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.cms-dashboard a{display:block;color:inherit;text-decoration:none}.cms-dashboard h2{color:#145b8c}.cms-dashboard p{color:#64748b;margin:0;font-size:14px}
.cms-domains{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-top:18px}.cms-domain{display:flex;flex-direction:column;overflow:hidden;background:#fff;border:1px solid #dce3ec;border-radius:12px;color:#1e293b;text-decoration:none;transition:box-shadow .15s}.cms-domain:hover{box-shadow:0 6px 20px #163c5b18;color:#145b8c}.cms-domain:focus-visible{outline:3px solid #145b8c;outline-offset:3px}.cms-domain-image{width:100%;height:145px;object-fit:contain;background:#edf3f8;padding:12px}.cms-domain-content{padding:18px;display:flex;flex-direction:column;flex:1}.cms-domain h3{font-size:19px;line-height:1.4;margin:0 0 12px;color:#145b8c}.cms-domain p{font-size:14px;color:#64748b;margin:auto 0 12px}.cms-domain-action{font-size:14px;font-weight:600;color:#145b8c}.cms-organize{display:inline-block;margin-top:16px;font-size:14px}.cms-quick-section{margin-top:30px}.cms-quick{grid-template-columns:repeat(4,minmax(0,1fr));margin-top:16px}.cms-quick h3{font-size:17px;color:#145b8c}.cms-quick .cms-card{padding:18px;margin:0}.cms-back{display:inline-block;margin-bottom:14px;font-size:14px}.cms-associated{display:flex;flex-direction:column;font-size:13px;margin-top:6px}@media(min-width:701px) and (max-width:1050px){.cms-domains,.cms-quick{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){body.admin #cms-navigation{padding:8px;gap:2px}#cms-navigation a,#cms-navigation summary{font-size:12px;padding:7px 8px}#cms-navigation details{margin-left:0}#cms-navigation details>div{left:0;right:auto}body.admin main.admin{padding:16px!important}body.admin main input[type=file]{width:100%;max-width:100%;min-width:0}body.admin h1{font-size:24px}.cms-dashboard,.cms-domains{grid-template-columns:1fr}.cms-domain-image{height:120px}.cms-toolbar{gap:8px}.cms-toolbar>div{min-width:0;flex:1 1 130px}.cms-table .cms-description,.cms-table .cms-family{display:none}.cms-table td,.cms-table th{padding:10px 8px}.cms-table .cms-thumb{width:48px;height:40px}.cms-editor-head{flex-direction:column}.cms-editor-image{width:130px;height:90px}.cms-table{min-width:0;font-size:13px}.cms-subtitle{max-width:160px}.cms-table .cms-pages-count{display:none}}
</style>
<nav id="cms-navigation" aria-label="Administration principale">
{% set items = [
 {label:'⌂',url:path('admin_index'),active:route=='admin_index'},
 {label:'Accueil',url:path('admin_home_index'),active:route starts with 'admin_home_'},
 {label:'Nos expertises',url:path('admin_site_section',{section:'expertises'}),active:app.request.get('section')=='expertises' or route=='admin_catalogue_business_expertise' or route=='admin_catalogue_index' and app.request.get('practice') or route starts with 'admin_services' or route=='admin_catalogue_offer'},
 {label:'Nos secteurs',url:path('admin_site_section',{section:'secteurs'}),active:app.request.get('section')=='secteurs' or route starts with 'admin_metiers'},
 {label:'Projets et références',url:path('admin_site_section',{section:'projets'}),active:app.request.get('section')=='projets' or route starts with 'admin_projets'},
 {label:'Articles et ressources',url:path('admin_site_section',{section:'ressources'}),active:app.request.get('section')=='ressources' or route starts with 'admin_growth'},
 {label:'Notre société',url:path('admin_site_section',{section:'societe'}),active:app.request.get('section')=='societe' or route starts with 'admin_teams'},
 {label:'Médiathèque',url:path('admin_site_section',{section:'medias'}),active:route=='admin_catalogue_media' or route=='admin_catalogue_visibility' and app.request.get('section')=='media'},
 {label:'Pages légales',url:path('admin_site_section',{section:'legal'}),active:app.request.get('section')=='legal' or route starts with 'admin_legal'}] %}
{% for item in items %}<a href="{{ item.url }}"{% if item.label=='⌂' %} aria-label="Tableau de bord"{% endif %}{% if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
<a href="{{ path('admin_site_search') }}" aria-label="Retrouver une page">⌕</a><details><summary>Paramètres avancés</summary><div><a href="{{ path('admin_catalogue_business_review') }}">Classifications et journal de validation</a><a href="{{ path('admin_catalogue_business_decisions') }}">Diagnostics internes</a><a href="{{ path('admin_site_diagnostic') }}">URL historiques et visibilité HTTP</a><a href="{{ path('admin_catalogue_settings') }}">Tous les paramètres</a><a href="{{ path('admin_catalogue_all_content') }}">Tous les contenus</a><a href="{{ path('admin_catalogue_quality') }}">Qualité & rattachements</a><a href="{{ path('admin_catalogue_visibility',{section:'seo'}) }}">Contrôles SEO/GEO</a><a href="{{ path('admin_translations_index') }}">Traductions</a><a href="{{ path('admin_users_index') }}">Utilisateurs</a></div></details>
</nav>

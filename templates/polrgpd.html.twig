{% extends 'base.html.twig' %}

{% block title %}Politique RGPD | OLING{% endblock %}
{% block meta_description %}Politique générale de protection des données personnelles et conformité RGPD d’OLING Management & Technologie.{% endblock %}

{% block body %}
  
<!-- ========== MAIN CONTENT ========== -->
<main id="content" role="main">
  <!-- Content -->
  <div class="container content-space-2 content-space-lg-3">
    <div class="w-lg-75 mx-lg-auto">
      <!-- Card -->
      <div class="card card-lg card-shadow oling-legal-card">
        <!-- Header -->
        <div class="card-header bg-dark">
          <h1 class="card-title h2 text-white" style="color: #fff !important;">{{ legalPage.title }}</h1>
        </div>
        <!-- End Header -->

        <!-- Card Body -->
        <div class="card-body">
          {{ legalPage.body|raw }}
        </div>
        <!-- End Card Body -->
      </div>
      <!-- End Card -->
    </div>
  </div>
  <!-- End Content -->
</main>
<!-- ========== END MAIN CONTENT ========== -->

  <!-- ========== SECONDARY CONTENTS ========== -->
  <!-- Go To -->
  <a class="js-go-to go-to go-to--hidden-init position-fixed" href="javascript:;"
     data-hs-go-to-options='{
       "offsetTop": 700,
       "position": {
         "init": {
           "right": "2rem"
         },
         "show": {
           "bottom": "2rem"
         },
         "hide": {
           "bottom": "-2rem"
         }
       }
     }'>
    <i class="bi-chevron-up"></i>
  </a>

  <!-- JS Plugins Init. -->
  <script>
    
  </script>
{% endblock %}

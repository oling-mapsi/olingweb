{% extends 'base.html.twig' %}

{% block title %}{{ page and page.title ? page.title : 'Ressources | OLING' }}{% endblock %}
{% block meta_description %}{{ page and page.metaDescription ? page.metaDescription : 'Ressources OLING.' }}{% endblock %}

{% block body %}
{% set faqItems = pageFaqItems is defined and pageFaqItems is not empty ? pageFaqItems : [] %}
<main id="content" role="main" class="oling-seo-cabinet">
  <section class="oling-section oling-section--tight">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-4">
          <li class="breadcrumb-item"><a href="{{ path('index') }}">Accueil</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{ page and page.heroTitle ? page.heroTitle|striptags : 'Ressources' }}</li>
        </ol>
      </nav>
      {% if page and page.heroBadge %}
        <span class="oling-kicker">{{ page.heroBadge }}</span>
      {% endif %}
      {% if page and page.heroTitle %}
        <h1>{{ page.heroTitle }}</h1>
      {% elseif page and page.title %}
        <h1>{{ page.title }}</h1>
      {% endif %}
      {% if page and page.heroIntro %}
        <p class="oling-lede">{{ page.heroIntro|raw }}</p>
      {% endif %}
    </div>
  </section>

  {% if articles is not empty %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="row g-4">
          {% for article in articles %}
            <div class="col-md-6 col-xl-4">
              <article class="oling-surface p-4 h-100">
                <h2 class="h4 mb-3"><a class="link" href="{{ path('seo_resource', {slug: article.slug}) }}">{{ article.h1 }}</a></h2>
                {% if article.intro is not empty %}
                  <p class="mb-3">{{ article.intro }}</p>
                {% endif %}
                <a class="btn btn-outline-primary btn-sm" href="{{ path('seo_resource', {slug: article.slug}) }}">Lire l'article</a>
              </article>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if page and page.heroSideHtml %}
    {{ page.heroSideHtml|raw }}
  {% endif %}

  {% if faqItems is not empty %}
    <section class="oling-section oling-section--tight">
      <div class="container">
        <div class="oling-surface p-4">
          <h2 class="h4">FAQ</h2>
          <ul class="mb-0">
            {% for item in faqItems %}
              <li><strong>{{ item.question }}</strong> {{ item.answer }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>
  {% endif %}
</main>
{% endblock %}

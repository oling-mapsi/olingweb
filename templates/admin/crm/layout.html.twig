{% extends 'base.html.twig' %}
{% block title %}CRM commercial | OLING{% endblock %}
{% block body %}
<main class="admin crm"><header class="crm-head"><div><a href="/admin">Administration OLING</a><h1>CRM commercial</h1><p>OLING Management & Technologie</p></div><a class="btn btn-outline-primary" href="{{ path('admin_crm_new') }}">Nouvelle affaire</a></header>
<nav class="crm-tabs" aria-label="CRM"><a href="{{ path('admin_crm',{view:'qualify'}) }}">À qualifier</a><a href="{{ path('admin_crm',{view:'active'}) }}">Affaires en cours</a><a href="{{ path('admin_crm',{view:'todo'}) }}">À faire</a><a href="{{ path('admin_crm',{view:'all'}) }}">Toutes les affaires</a><a href="{{ path('admin_crm_export') }}">Export CSV</a></nav>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}
{% block crm %}{% endblock %}</main>
<style>.crm{max-width:1400px;margin:0 auto;padding:28px;color:#18334a}.crm-head{display:flex;align-items:center;justify-content:space-between;gap:20px}.crm-head h1{margin-top:12px}.crm-head p,.crm small{color:#65798a}.crm-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:22px 0}.crm-tabs a{background:#edf3f8;padding:10px 14px;border-radius:6px}.crm-card{background:white;border:1px solid #dde5ed;border-radius:10px;padding:20px;margin:18px 0}.crm-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.crm label{display:block;font-weight:600}.crm input,.crm textarea,.crm select{display:block;width:100%;padding:9px;border:1px solid #b8c6d3;border-radius:5px;background:white;color:#18334a}.crm textarea{min-height:110px}.crm .wide{grid-column:1/-1}.crm-table{overflow:auto}.crm table{width:100%;font-size:14px}.crm th,.crm td{padding:12px;border-bottom:1px solid #e1e7ec;vertical-align:top}.crm th{background:#edf3f8;white-space:nowrap}.crm-actions{display:flex;gap:8px;flex-wrap:wrap}.crm-actions form{margin:0}.crm-actions button{padding:7px 10px;border:1px solid #adc0cf;background:#f5f9fc;border-radius:5px}.crm details summary{cursor:pointer;font-weight:600;margin:8px 0}.crm pre{white-space:pre-wrap;font-family:inherit;font-size:13px;max-height:240px;overflow:auto}.crm-badge{display:inline-block;padding:3px 7px;background:#e7f0f8;border-radius:5px}.crm-muted{color:#6b7b88;font-size:13px}.crm button{cursor:pointer}.crm a{overflow-wrap:anywhere}@media(max-width:700px){.crm{padding:14px}.crm-grid{grid-template-columns:1fr}.crm-head{align-items:start}.crm h1{font-size:25px}}
</style>
{% endblock %}

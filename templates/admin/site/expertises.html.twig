{% extends 'base.html.twig' %}{% block title %}Nos expertises | Admin{% endblock %}
{% block body %}{% include 'admin/business/_style.html.twig' %}{% include 'admin/site/_style.html.twig' %}
<main class="admin cms-expertises-home"><h1>Nos expertises</h1><p class="cms-intro">Ouvrez une Practice pour retrouver ses expertises, ses prestations et leurs pages complémentaires SEO/GEO.</p>
<div class="cms-domains">{% for family in families %}<a class="cms-domain" data-practice-id="{{ family.id }}" href="{{ path('admin_catalogue_index',{type:'service',practice:family.id}) }}">{% if family.thumbnail %}<img class="cms-domain-image" src="{{ family.thumbnail }}" alt="">{% endif %}<div class="cms-domain-content"><h2>{{ family.title }}</h2><p>{{ family.serviceCount }} prestations historiques · {{ family.expertiseCount }} expertises</p><span class="cms-domain-action">Ouvrir la Practice →</span></div></a>{% endfor %}</div>
<section class="cms-public-hubs" aria-label="Pages de présentation publiques"><h2>Les deux pages de présentation du site</h2><div class="cms-hub-shortcuts">{% for row in hubs %}{% set row=row|merge({editLabel:row.slug=='services' ? 'Modifier la page « Services et offres »' : 'Modifier la page « Nos expertises »'}) %}{% include 'admin/site/_hub.html.twig' %}{% endfor %}</div></section>
<form class="cms-site-search" method="get"><input class="form-control" name="q" value="{{ q }}" aria-label="Rechercher par nom, URL ou slug" placeholder="Retrouver une expertise, une prestation ou une URL…"><button class="btn btn-primary">Rechercher</button></form>
<h2>Expertises et prestations par Practice</h2>{% for family in families %}{% set familyRows=groups[family.id]|default([]) %}<details class="cms-secondary" data-practice-group="{{ family.id }}" {% if q and familyRows %}open{% endif %}><summary>{{ family.title }} · {{ familyRows|filter(r=>r.kind|default('')=='expertise')|length }} expertises · {{ familyRows|filter(r=>r.kind|default('')!='expertise')|length }} prestations</summary><p><a href="{{ path('admin_catalogue_index',{type:'service',practice:family.id}) }}">Ouvrir la Practice</a></p>{% for kind,label in {'expertise':'Expertises','prestation':'Prestations'} %}{% set content=familyRows|filter(r=>kind=='expertise' ? r.kind|default('')=='expertise' : r.kind|default('')!='expertise') %}{% if content %}<h3>{{ label }}</h3>{% include 'admin/site/_rows.html.twig' with {rows:content} %}{% endif %}{% endfor %}</details>{% endfor %}
{% if unorganized %}<details class="cms-secondary" {% if q %}open{% endif %}><summary>Autres contenus et contenus à organiser · {{ unorganized|length }}</summary><p class="small">Ces contenus restent accessibles sans créer de rattachement métier en base.</p>{% include 'admin/site/_rows.html.twig' with {rows:unorganized} %}</details>{% endif %}
</main><style>.cms-expertises-home .cms-domain-image{height:105px}.cms-expertises-home .cms-domain-content{padding:14px}.cms-expertises-home .cms-domain-content h2{font-size:18px;line-height:1.3;margin:0 0 10px}.cms-expertises-home .cms-domain-content p{font-size:12px;margin:0 0 8px}.cms-public-hubs{margin-top:20px}.cms-hub-shortcuts{display:grid;grid-template-columns:1fr 1fr;gap:14px}.cms-hub-shortcuts .cms-card{padding:14px;margin:0}.cms-hub-shortcuts .cms-site-hub img{display:none}.cms-hub-shortcuts .cms-site-hub h2{font-size:16px}.cms-hub-shortcuts .btn{font-size:12px;padding:8px}.cms-hub-shortcuts .cms-site-url{font-size:12px}@media(max-width:700px){.cms-hub-shortcuts{grid-template-columns:1fr}}</style>{% endblock %}

{% extends 'base.html.twig' %}{% block title %}{{ practice.designation }} — Catalogue{% endblock %}
{% block body %}<main class="admin container-fluid content-space-2">{% include 'admin/_nav.html.twig' %}<h1>{{ practice.designation }}</h1>
<div class="nav nav-tabs" role="tablist">{% for key,label in {'presentation':'Présentation','service':'Services','expertise':'Expertises','project':'Projets','resource':'Ressources','seo':'SEO/GEO','pages':'Pages connexes'} %}<button class="nav-link {{ loop.first ? 'active' : '' }}" id="tab-{{ key }}" data-bs-toggle="tab" data-bs-target="#pane-{{ key }}" type="button" role="tab" aria-controls="pane-{{ key }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ label }}</button>{% endfor %}</div>
<div class="tab-content pt-4">
<section class="tab-pane fade show active" id="pane-presentation" role="tabpanel" aria-labelledby="tab-presentation"><p>Practice #{{ practice.id }} · /practice/{{ practice.slug }}</p><a href="{{ path('admin_practices_edit',{id:practice.id}) }}">Modifier la présentation</a></section>
{% for key in ['service','expertise','project','resource'] %}<section class="tab-pane fade" id="pane-{{ key }}" role="tabpanel" aria-labelledby="tab-{{ key }}"><h2>{{ types[key] }}</h2>{% if key == 'service' %}<a class="btn btn-primary mb-3" href="{{ path('admin_services_new',{practice:practice.id}) }}">Créer un Service dans cette Practice</a>{% endif %}{% include 'admin/catalogue/_table.html.twig' with {rows:rows|filter(row => row.type == key),type:key} %}</section>{% endfor %}
<section class="tab-pane fade" id="pane-seo" role="tabpanel" aria-labelledby="tab-seo"><h2>Couverture SEO/GEO</h2><p>Chaque fiche conserve son éditeur SEO/GEO. La classification administrative ne change pas les URL. L’indexabilité effective est vérifiée par la capture HTTP.</p>{% include 'admin/catalogue/_table.html.twig' %}</section>
<section class="tab-pane fade" id="pane-pages" role="tabpanel" aria-labelledby="tab-pages"><h2>Pages connexes</h2>{% include 'admin/catalogue/_table.html.twig' with {rows:rows|filter(row => row.type not in ['service','expertise','project','resource'])} %}</section>
</div></main>{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ practiceNarrative.metaTitle|default(practice.designation ~ ' | OLING') }}{% endblock %}
{% block meta_description %}{{ practiceNarrative.metaDescription|default(practiceNarrative.intro|striptags) }}{% endblock %}

{% block body %}
<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: practiceNarrative.eyebrow,
    title: practiceNarrative.headline,
    intro: practiceNarrative.intro,
    primaryCta: {route: 'contact', label: 'service.hero.primary_cta'|trans},
    secondaryCta: {route: 'expertises_index', label: 'home.hero.default_secondary_cta'|trans},
    externalCta: practice.slug == 'mapsi' ? {href: 'https://mapsi.fr', label: 'nav.mapsi_access'|trans} : null,
    highlights: practiceNarrative.focus|slice(0, 3)
  } %}

  <section class="oling-shell-section">
    <div class="container">
      <div class="oling-two-col">
        <article class="oling-surface oling-surface--light">
          <span class="oling-kicker">{{ practice.designationShort ?: 'practice.default_domain'|trans }}</span>
          <h2>{% if practice.slug == 'consulting' %}{{ 'practice.amoa_role_title'|trans }}{% else %}{{ practice.designation }}{% endif %}</h2>
          <p>{{ practiceNarrative.promise }}</p>
          {% if practice.description %}
            <div class="oling-richtext">{{ practice.description|raw }}</div>
          {% endif %}
        </article>
        <article class="oling-surface oling-surface--light">
          <span class="oling-kicker">{{ 'practice.key_services'|trans }}</span>
          <h2>{% if practice.slug == 'consulting' %}{{ 'practice.amoa_expertise_title'|trans }}{% else %}{{ 'practice.available_interventions'|trans }}{% endif %}</h2>
          <ul class="oling-check-list">
            {% for item in practiceNarrative.focus %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </article>
      </div>
    </div>
  </section>

  {% if practiceNarrative.missionPhases is defined and practiceNarrative.missionPhases|length > 0 %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'practice.amoa_si'|trans }}</span>
          <h2>{{ 'practice.amoa_scope_title'|trans }}</h2>
          <p>{{ 'practice.amoa_scope_intro'|trans }}</p>
        </div>
        <div class="oling-service-link-grid">
          {% for item in practiceNarrative.missionPhases %}
            <article class="oling-surface oling-surface--light">
              <h3>{{ item }}</h3>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if practiceNarrative.projectContexts is defined and practiceNarrative.projectContexts|length > 0 %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-two-col">
          <article class="oling-surface oling-surface--light">
            <span class="oling-kicker">{{ 'common.project'|trans }}</span>
            <h2>{{ 'practice.project_contexts_title'|trans }}</h2>
            <ul class="oling-check-list">
              {% for item in practiceNarrative.projectContexts %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </article>
          <article class="oling-surface oling-surface--light">
            <span class="oling-kicker">{{ 'service.deliverables.kicker'|trans }}</span>
            <h2>{{ 'practice.deliverables_title'|trans }}</h2>
            <ul class="oling-check-list">
              {% for item in practiceNarrative.deliverables|default([]) %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </article>
        </div>
      </div>
    </section>
  {% endif %}

  {% if practiceNarrative.clientTypes is defined and practiceNarrative.clientTypes|length > 0 %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'service.project_contexts.kicker'|trans }}</span>
          <h2>{{ 'practice.client_types_title'|trans }}</h2>
        </div>
        <div class="oling-service-link-grid">
          {% for item in practiceNarrative.clientTypes %}
            <article class="oling-surface oling-surface--light">
              <p class="mb-0">{{ item }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <section class="oling-shell-section oling-shell-section--tint">
    <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'practice.offers'|trans }}</span>
          <h2>{{ practice.designationShort ?: 'practice.services.default_title'|trans }}</h2>
          <p>{{ practice.introductionShort ?: 'practice.services.default_intro'|trans }}</p>
      </div>
      <div class="oling-service-link-grid">
        {% for service in practice.services %}
          <a class="oling-service-link-card" href="{{ path('service', {practice: service.practice.slug, slug: service.slug}) }}">
            <span class="oling-kicker">{{ service.designationShort ?: 'service.card.default_kicker'|trans }}</span>
            <h3>{{ service.designation }}</h3>
            <p>{{ service.introductionShort ?: service.descriptionShort ?: 'service.card.default_intro'|trans }}</p>
            <span class="oling-service-link-card__more">{{ 'service.card.view_offer'|trans }}</span>
          </a>
        {% else %}
          <article class="oling-surface oling-surface--light">
            <p>{{ 'practice.services_pending'|trans }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  {% if app.request.pathInfo == '/amoa-si' and practiceNarrative.anonymousProofs is defined and practiceNarrative.anonymousProofs|length > 0 %}
    {% include 'public/_anonymous_proof_cards.html.twig' with {
      proofs: practiceNarrative.anonymousProofs,
      sectionClass: 'oling-shell-section',
      title: practiceNarrative.anonymousProofsTitle|default('service.proofs.default_title'|trans),
      intro: practiceNarrative.anonymousProofsIntro|default('service.proofs.default_intro'|trans)
    } %}
  {% elseif projects|length > 0 %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'practice.cases_contexts'|trans }}</span>
          <h2>{{ 'nav.achievements'|trans }}</h2>
        </div>
        <div class="oling-project-proof-grid">
          {% for project in projects|slice(0, 3) %}
            <article class="oling-proof-card">
              <span class="oling-kicker">{{ project.metier ? project.metier.designation : 'common.project'|trans }}</span>
              <h3>{{ project.designation }}</h3>
              <p>{{ project.description ? project.description|striptags|slice(0, 180) ~ '…' : 'practice.default_project_description'|trans }}</p>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if teams|length > 0 %}
    <section class="oling-shell-section oling-shell-section--tint">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'team.section_label'|trans }}</span>
          <h2>{{ 'practice.available_experts'|trans }}</h2>
        </div>
        <div class="oling-team-mini-list">
          {% for team in teams %}
            <div class="oling-team-mini">
              <img class="oling-team-mini__avatar" src="{{ team.photo ?: asset('img/160x160/img1.jpg') }}" alt="Photo de {{ team.noncomplet }}">
              <div class="oling-team-mini__meta">
                <div class="oling-team-mini__name">{{ team.noncomplet }}</div>
                {% if team.titre %}
                  <div class="oling-team-mini__title">{{ team.titre }}</div>
                {% endif %}
                {% if team.linkedin %}
                  <a class="oling-team-mini__link" href="{{ team.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if practiceNarrative.supportLinks is defined and practiceNarrative.supportLinks|length > 0 %}
    <section class="oling-shell-section">
      <div class="container">
        <div class="oling-section-head">
          <span class="oling-kicker">{{ 'service.support_links.kicker'|trans }}</span>
          <h2>{{ 'practice.support_links_title'|trans }}</h2>
          <p>{{ 'practice.support_links_intro'|trans }}</p>
        </div>
        <div class="oling-service-link-grid">
          {% for item in practiceNarrative.supportLinks %}
            <a class="oling-service-link-card" href="{{ item.href }}">
              <span class="oling-kicker">{{ 'service.support_links.card_kicker'|trans }}</span>
              <h3>{{ item.label }}</h3>
              <p>{{ item.description }}</p>
              <span class="oling-service-link-card__more">{{ 'practice.open_related_page'|trans }}</span>
            </a>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% include 'public/_cta_band.html.twig' with {
    title: 'practice.final_cta.title'|trans,
    text: 'practice.final_cta.text'|trans,
    primaryCta: {route: 'contact', label: 'footer.exchange_cta'|trans},
    phoneCta: app.request.pathInfo == '/amoa-si'
  } %}
</main>

{% if practice.slug == 'consulting' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "{{ 'practice.schema.name'|trans|e('js') }}",
    "serviceType": "{{ 'practice.schema.service_type'|trans|e('js') }}",
    "provider": {
      "@type": "ProfessionalService",
      "name": "OLING Management et Technologie",
      "url": "https://oling.fr"
    },
    "url": "https://oling.fr/amoa-si",
    "areaServed": ["France", "Guadeloupe", "Martinique", "Guyane", "Réunion", "Saint-Pierre-et-Miquelon"],
    "description": "{{ 'practice.schema.description'|trans|e('js') }}"
  }
  </script>
{% endif %}
{% endblock %}

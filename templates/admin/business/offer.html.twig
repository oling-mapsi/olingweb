{% extends 'base.html.twig' %}
{% block title %}{{ offer.displayTitle }} | Admin{% endblock %}
{% block body %}{% include 'admin/site/_style.html.twig' %}{% include 'admin/business/_style.html.twig' %}<main class="admin"><a class="cms-back" href="{{ path('admin_catalogue_index',{type:'service',practice:offer.family ? offer.family.id : ''}) }}">← Contenus de la famille</a>
<div class="cms-editor-head"><div><h1>{{ offer.displayTitle }}</h1>{% if offer.displayTitle!=offer.title %}<details class="small"><summary>Intitulé historique conservé</summary>{{ offer.title }}</details>{% endif %}<p>{{ offer.familyLabel }}</p><p>{{ offer.kind=='expertise' ? 'Expertise transverse : elle peut concerner plusieurs offres.' : 'Gérez chaque page et son contenu depuis son propre éditeur.' }}</p></div>{% if offer.thumbnail %}<img class="cms-editor-image" src="{{ offer.thumbnail }}" alt="{{ offer.title }}">{% endif %}</div>
<section class="cms-card"><h2>{{ offer.kind=='expertise' ? 'Page de cette expertise' : 'Prestation et pages complémentaires SEO/GEO' }}</h2>
{% for row in offer.pages %}<article class="cms-business-page" data-offer-page="{{ row.key }}">{% include 'admin/catalogue/_thumbnail.html.twig' %}<div><h3>{{ row.title }}</h3><small class="cms-subtitle">{{ offer.kind=='expertise' ? 'Page de cette expertise' : (row.key==offer.key ? 'Page de la prestation' : 'Page complémentaire SEO/GEO') }}</small><p>{% if row.publicUrl %}<a href="{{ row.publicUrl }}" target="_blank" rel="noopener">{{ row.publicUrl }}</a>{% else %}Pas de page publique{% endif %}</p><span class="cms-status">{{ row.visibility }}</span><details><summary>Informations de publication</summary><p class="small mt-2 mb-2">Statut éditorial enregistré : <strong>{{ row.editorialLabel }}</strong> · {{ row.http ? 'HTTP '~row.http : 'HTTP non applicable' }} · Menu public : {{ row.navigationLabel }} <span class="text-muted">(audit {{ auditDate }})</span></p></details><p class="small">{{ row.technical=='service' ? 'Méthodes, étapes, livrables, références, intervenants et images historiques conservés.' : 'Contenu SEO/GEO, traductions, images et métadonnées propres à cette page.' }}</p><a class="btn btn-primary btn-sm" href="{{ row.edit }}">Modifier cette page</a>{% if row.preview %} <a class="btn btn-outline-secondary btn-sm" href="{{ row.preview }}" target="_blank" rel="noopener">Aperçu administrateur</a>{% endif %}{% if row.url %} <a class="btn btn-outline-secondary btn-sm" href="{{ row.publicUrl }}" target="_blank" rel="noopener">Voir cette page</a>{% endif %}<small class="cms-subtitle">Cette action ouvre uniquement l’éditeur de {{ row.url ?: 'cette fiche sans page publique' }}.</small></div></article>{% endfor %}
</section>
{% if offer.localPages %}<section class="cms-card" id="local-seo"><h2>Pages complémentaires SEO/GEO</h2><p class="small text-muted">{{ offer.localPages|length }} pages de référencement AMOA SI. Accès principal proposé ; aucune association métier enregistrée. Elles couvrent aussi des sujets transverses, sans rattachement exclusif.</p>{% for row in offer.localPages %}<article class="cms-business-page" data-local-page="{{ row.key }}">{% include 'admin/catalogue/_thumbnail.html.twig' %}<div><strong>{{ row.title }}</strong><small class="cms-subtitle">{{ row.localRole }} · {{ row.url }}</small><a class="btn btn-outline-primary btn-sm" href="{{ row.edit }}">Gérer cette page</a></div></article>{% endfor %}</section>{% endif %}
{% if offer.kind=='expertise' %}{% include 'admin/business/_relations.html.twig' with {links:offer.concerned,targetExpertise:false} %}{% endif %}
{% if offer.related %}{% include 'admin/business/_relations.html.twig' with {links:offer.related,targetExpertise:true} %}{% endif %}

</main>{% endblock %}

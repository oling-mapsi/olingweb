{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('vendor/leaflet/leaflet.css') }}">
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('vendor/leaflet/leaflet.js') }}"></script>
{% endblock %}

{% block body %}
<main id="content" role="main" class="oling-case-studies-page">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.intro,
    primaryCta: page.primaryCta,
    secondaryCta: page.secondaryCta,
    highlights: page.highlights
  } %}

  <section class="oling-section oling-case-studies-section">
    <div class="container">

      {% set featuredProjects = featuredProjects is defined ? featuredProjects : projets|slice(0, 6) %}
      {% set miniProjects = miniProjects is defined ? miniProjects : projets|slice(6) %}

      <div class="oling-case-studies-head">
        <div>
          <span class="oling-kicker">{{ page.cards.kicker|default('Cas clients') }}</span>
          <h2>{{ page.cards.title|default('Des retours terrain plus incarnés, plus lisibles.') }}</h2>
        </div>
        <p>{{ page.cards.intro|default('Une sélection de références présentée avec plus de relief, de clarté et une lecture plus immédiate des contextes clients.') }}</p>
      </div>

      <div class="oling-case-grid">
        {% for projet in featuredProjects %}
          <a class="oling-case-card" href="{{ projet.href }}">
            <div class="oling-case-card__media">
              <img src="{{ projet.image }}" alt="{{ projet.title }}">
              <div class="oling-case-card__overlay">
                {% if projet.meta %}
                  <span class="oling-case-card__service">{{ projet.meta }}</span>
                {% endif %}
              </div>
            </div>
            <div class="oling-case-card__body">
              <span class="oling-case-card__index">{{ '%02d'|format(loop.index) }}</span>
              <h3>{{ projet.title }}</h3>
              {% if projet.period %}
                <div class="d-flex flex-wrap gap-2 mb-3">
                  <span class="badge text-bg-light">{{ projet.period }}</span>
                </div>
              {% endif %}
              <p>{{ projet.excerpt }}</p>
              <span class="oling-case-card__cta">Voir le cas</span>
            </div>
          </a>
        {% else %}
          <div>
            <div class="alert alert-info">{{ page.cards.emptyText }}</div>
          </div>
        {% endfor %}
      </div>

      {% if miniProjects is not empty %}
      <div class="oling-case-studies-subhead">
        <span class="oling-kicker">{{ page.cards.archiveKicker|default('Autres références') }}</span>
        <h3>{{ page.cards.archiveTitle|default('Plus de cas clients à parcourir') }}</h3>
      </div>
      <div class="oling-projects-mini-grid mt-5 js-projets-mini-grid"
           data-endpoint="{{ path('projets_more') }}"
           data-next-page="{{ miniNextPage ?? 2 }}"
           data-has-more="{{ miniHasMore is defined and miniHasMore ? '1' : '0' }}">
        {% include 'projets/_mini_cards.html.twig' with { miniProjects: miniProjects } %}
      </div>
      {% if miniHasMore is defined and miniHasMore %}
        <div class="oling-projects-mini-loader js-projets-loader" hidden>Chargement…</div>
        <div class="oling-projects-mini-sentinel js-projets-sentinel" aria-hidden="true"></div>
      {% endif %}
      {% endif %}

      {% if page.legacyBodyHtml is defined and page.legacyBodyHtml %}
        <div class="oling-surface oling-surface--light mt-5">
          <div class="oling-richtext">{{ page.legacyBodyHtml|raw }}</div>
        </div>
      {% endif %}

      <div class="oling-geo-map oling-geo-map--full" role="img" aria-label="Carte de la France métropolitaine et des territoires d'outre-mer">
        <div class="oling-geo-map__header">
          <span class="acc-eyebrow">{{ page.mapSection.kicker }}</span>
          <h2>{{ page.mapSection.title }}</h2>
          {% if page.legacySideHtml is defined and page.legacySideHtml %}
            <div class="oling-richtext">{{ page.legacySideHtml|raw }}</div>
          {% else %}
            <p>{{ page.mapSection.text }}</p>
          {% endif %}
        </div>
        <div
          id="oling-geo-map"
          class="oling-geo-map__canvas"
          data-world="{{ asset('geo/world.geojson') }}"
        ></div>
        <div class="oling-geo-map__label">{{ page.mapSection.label }}</div>
      </div>
      <script type="application/json" id="oling-geojson-data">
        {{ include('geo/france-overseas.json.twig')|raw }}
      </script>
    </div>
  </section>
</main>
{% endblock %}

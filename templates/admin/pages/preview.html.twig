{% extends 'base.html.twig' %}

{% block title %}Preview {{ locale|upper }} - {{ page.title }}{% endblock %}
{% block meta_robots %}noindex,nofollow{% endblock %}

{% block body %}
<main id="content" role="main" class="oling-seo-cabinet">
    <section class="oling-section oling-section--tight oling-seo-cabinet__hero">
        <div class="container">
            <div class="alert alert-warning mb-4">
                Preview interne {{ locale|upper }} · statut {{ translation.translationStatus }}
            </div>
        </div>
    </section>
    {% include 'public/_page_hero.html.twig' with {
        eyebrow: page.heroBadge,
        title: page.heroTitle ?: page.title,
        intro: page.heroIntro|striptags,
        image: heroMedia.image,
        imageAlt: heroMedia.alt,
        imageCaption: heroMedia.caption,
        imageFocalPoint: heroMedia.focalPoint
    } %}

    {% if page.heroSideHtml %}
        <div class="oling-seo-cabinet__content">
            {{ page.heroSideHtml|raw }}
        </div>
    {% endif %}

    {% if page.bodyHtml %}
        <section class="oling-section oling-section--tight">
            <div class="container">
                <div class="oling-surface p-4">
                    <pre class="mb-0 text-wrap">{{ page.bodyHtml }}</pre>
                </div>
            </div>
        </section>
    {% endif %}
</main>
{% endblock %}

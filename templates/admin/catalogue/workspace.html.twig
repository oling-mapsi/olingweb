{% extends 'base.html.twig' %}
{% block title %}{{ selectedFamily ? selectedFamily.title : title }} | Admin{% endblock %}
{% block body %}<main class="admin">{% include 'admin/business/_presentation_pages.html.twig' %}
{% if mode=='service' and selectedFamily %}<a class="cms-back" href="{{ path('admin_index') }}">← Nos domaines d’intervention</a>{% endif %}
<div class="cms-editor-head"><div><h1>{{ selectedFamily and mode=='service' ? selectedFamily.title : title }}</h1><p>{% if mode=='service' %}{{ selectedFamily ? selectedFamily.serviceCount : serviceCount }} prestations{{ selectedFamily ? ' dans ce domaine' : '' }}. Retrouvez leurs pages et leurs illustrations depuis leur fiche.{% elseif mode=='resource' %}Articles existants, images et publication. La génération et la validation restent dans Growth.{% else %}Retrouvez et gérez vos contenus, sans modifier les autres pages.{% endif %}</p></div>
{% if mode=='service' and not organize %}<a class="btn btn-primary btn-sm" href="{{ path('admin_services_new') }}">Ajouter une prestation</a>{% elseif mode=='project' %}<a class="btn btn-primary btn-sm" href="{{ path('admin_projets_new') }}">Ajouter une référence</a>{% endif %}
{% if mode=='resource' %}<a class="btn btn-primary btn-sm" href="{{ path('admin_growth_index') }}">Ouvrir Growth</a>{% endif %}</div>
{% if mode=='service' %}<div class="cms-tabs"><a href="{{ path('admin_catalogue_index',{type:'service'}) }}"{% if not organize %} aria-current="page"{% endif %}>Prestations · {{ serviceCount }}</a><a href="{{ path('admin_catalogue_index',{type:'service',view:'pages'}) }}"{% if organize %} aria-current="page"{% endif %}>À organiser · {{ unattachedCount }}</a></div>{% if organize %}<p class="cms-intro">Prestations sans famille enregistrée et pages sans association explicite. Leurs rattachements historiques et leurs URL sont conservés.</p>{% endif %}{% endif %}
{% if mode=='site' and filters.category=='local' %}<p class="cms-business-note">Accès secondaire : ces pages de référencement ont leur emplacement principal dans <a href="{{ path('admin_catalogue_offer',{technical:'service',id:1}) }}#local-seo">AMOA SI → Pages complémentaires SEO/GEO</a>. Classement administratif proposé, sans modification des pages publiques.</p>{% endif %}
{% if mode=='site' %}<div class="cms-tabs">{% for key,label in {'':'Toutes','home':'Accueil','company':'À propos / entreprise','contact':'Contact','local':'Pages locales','legal':'Pages légales','other':'Éditorial hors catalogue'} %}<a href="{{ path('admin_catalogue_site_pages',{category:key}) }}"{% if filters.category==key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</div>{% endif %}
<form method="get" class="cms-toolbar"><input type="hidden" name="view" value="{{ organize ? 'pages' : '' }}"><input type="hidden" name="category" value="{{ filters.category }}">
<div class="cms-search"><label for="cms-q">Rechercher</label><input class="form-control" type="search" id="cms-q" name="q" placeholder="Nom, sujet ou URL…" value="{{ filters.q }}"></div>
{% if mode in ['service','project','resource','expertise'] %}<div><label for="cms-family">Famille métier</label><select id="cms-family" class="form-select" name="practice"><option value="">Toutes les familles</option><option value="none" {{ filters.practice=='none' ? 'selected' : '' }}>À organiser</option>{% for family in practiceChoices %}<option value="{{ family.id }}" {{ filters.practice==family.id ? 'selected' : '' }}>{{ family.designation }}</option>{% endfor %}</select></div>{% endif %}
<div><label for="cms-status">Statut</label><select class="form-select" id="cms-status" name="status"><option value="">Tous les statuts</option>{% for key,label in {'published':'Publié','draft':'Brouillon','unpublished':'Non publié','legacy':'Non renseigné'} %}<option value="{{ key }}" {{ filters.status==key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div><button class="btn btn-primary">Rechercher</button></form>
<p class="small text-muted">{{ count }} {{ mode=='service' and not organize ? 'prestations' : 'résultats' }}{% if organize %} à organiser{% endif %}</p>
{% include 'admin/catalogue/_business_table.html.twig' %}
<nav class="cms-pagination" aria-label="Pagination">{% if page>1 %}<a href="{{ app.request.pathinfo }}?{{ app.request.query.all|merge({page:page-1})|url_encode }}">← Précédente</a>{% endif %}<span>Page {{ page }} / {{ pages }}</span>{% if page<pages %}<a href="{{ app.request.pathinfo }}?{{ app.request.query.all|merge({page:page+1})|url_encode }}">Suivante →</a>{% endif %}</nav>
</main>{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}

{% block body %}
<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.intro,
    primaryCta: page.primaryCta,
    secondaryCta: page.secondaryCta,
    highlights: page.highlights
  } %}

  <section class="oling-shell-section">
    <div class="container">
      {% if page.legacyBodyHtml is defined and page.legacyBodyHtml %}
        <div class="oling-surface oling-surface--light mb-4">
          <div class="oling-richtext">{{ page.legacyBodyHtml|raw }}</div>
        </div>
      {% endif %}

      <div class="oling-team-page-grid">
        {% for people in team %}
          <article class="oling-team-card">
            <div class="oling-team-media">
              <img src="{{ people.photo ?: asset('img/160x160/img1.jpg') }}" alt="Photo de {{ people.noncomplet }}">
            </div>
            <div class="oling-team-card__body">
              <div class="oling-team-card__head">
                <div>
                  <h2>{{ people.noncomplet }}</h2>
                  {% if people.titre %}
                    <p class="oling-team-card__title">{{ people.titre }}</p>
                  {% endif %}
                </div>
                {% if people.linkedin %}
                  <a class="oling-team-card__link" href="{{ people.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
                {% endif %}
              </div>
              {% if people.shortcv %}
                <div class="oling-richtext oling-team-card__content">{{ people.shortcv|raw }}</div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
</main>
{% endblock %}

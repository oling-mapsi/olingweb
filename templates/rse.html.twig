{% extends 'base.html.twig' %}

{% block title %}{{ page.seoTitle }}{% endblock %}
{% block meta_description %}{{ page.metaDescription }}{% endblock %}

{% block body %}
<main id="content" role="main">
  {% include 'public/_page_hero.html.twig' with {
    eyebrow: page.eyebrow,
    title: page.title,
    intro: page.intro,
    primaryCta: page.primaryCta,
    secondaryCta: page.secondaryCta,
    highlights: page.highlights
  } %}

  {% for block in page.sections %}
    <section class="oling-shell-section{% if loop.index is even %} oling-shell-section--tint{% endif %}">
      <div class="container">
        {% if block.items|length == 1 %}
          <div class="oling-surface oling-surface--light">
            {% set item = block.items|first %}
            {% if item.kicker is defined %}<span class="oling-kicker">{{ item.kicker }}</span>{% endif %}
            {% if item.title is defined %}<h2>{{ item.title }}</h2>{% endif %}
            {% if item.list is defined and item.list %}
              <ul class="oling-check-list">
                {% for entry in item.list %}
                  <li>{{ entry }}</li>
                {% endfor %}
              </ul>
            {% elseif item.text is defined %}
              <p>{{ item.text }}</p>
            {% endif %}
          </div>
        {% else %}
          <div class="oling-two-col">
            {% for item in block.items %}
              <article class="oling-surface oling-surface--light">
                {% if item.kicker is defined %}<span class="oling-kicker">{{ item.kicker }}</span>{% endif %}
                {% if item.title is defined %}<h2>{{ item.title }}</h2>{% endif %}
                {% if item.list is defined and item.list %}
                  <ul class="oling-check-list">
                    {% for entry in item.list %}
                      <li>{{ entry }}</li>
                    {% endfor %}
                  </ul>
                {% elseif item.text is defined %}
                  <p>{{ item.text }}</p>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
  {% endfor %}

  <section class="oling-shell-section">
    <div class="container">
      <div class="oling-section-head">
        <span class="oling-kicker">{{ page.linksSection.kicker }}</span>
        <h2>{{ page.linksSection.title }}</h2>
      </div>
      <div class="oling-service-link-grid">
        {% for link in page.linksSection.links %}
          <a class="oling-service-link-card" href="{{ link.route is defined ? path(link.route, link.routeParams|default({})) : link.url }}" {% if link.url is defined %}target="_blank" rel="noopener"{% endif %}>
            <span class="oling-kicker">{{ link.kicker }}</span>
            <h3>{{ link.title }}</h3>
            <p>{{ link.text }}</p>
            <span class="oling-service-link-card__more">{{ link.moreLabel }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  {% include 'public/_cta_band.html.twig' with {
    eyebrow: page.cta.eyebrow,
    title: page.cta.title,
    text: page.cta.text,
    primaryCta: page.cta.primaryCta
  } %}
</main>
{% endblock %}
